---
import RefonteGalerie from '../refonte/galerie.astro';
import { translatedLangs } from '../../i18n/refonte';

export function getStaticPaths() {
  return translatedLangs.map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props;
---

<RefonteGalerie lang={lang} />
