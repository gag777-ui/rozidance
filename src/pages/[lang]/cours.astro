---
import Layout from '../../layouts/Layout.astro';
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
import CtaFloat from '../../components/ui/CtaFloat.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'nl' } },
    { params: { lang: 'ru' } },
  ];
}

const lang = (Astro.currentLocale ?? Astro.params.lang ?? 'fr') as Lang;
const t = getTranslations(lang);
const faq = t.cours.faqItems;
// Reels are language-agnostic — always read from fr.json
const fr = (await import('../../i18n/fr.json')).default;
const reels = (fr.cours as any).reels as (string | null)[] ?? [];
---

<Layout title={t.cours.pageTitle} description={t.cours.pageDescription}>
  <!-- Hero -->
  <section class="cours-hero" aria-labelledby="cours-title">
    <div class="section-container cours-hero-inner">
      <div class="cours-hero-text">
        <a href={`/${lang}#prestations`} class="back-link">
          <svg width="16" height="16" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M12 7H2M6 3l-4 4 4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {t.nav.prestations}
        </a>
        <span class="eyebrow">{t.cours.heroEyebrow}</span>
        <h1 id="cours-title">{t.cours.heroTitle}</h1>
        <p class="cours-hero-subtitle">{t.cours.heroSubtitle}</p>
      </div>
      <div class="cours-hero-img" aria-hidden="true">
        <img
          src="/images/cours-hero.webp"
          alt=""
          width="1536"
          height="1024"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- Reels grid -->
  {reels.length > 0 && (
    <section class="reels-section">
      <div class="section-container">
        <div class="reels-grid">
          {reels.map((href, i) => (
            <a
              href={href ?? '#'}
              class="reel-card reveal"
              style={`transition-delay: ${i * 50}ms`}
              aria-label={`Cours — voir le reel Instagram ${i + 1}`}
              target={href ? '_blank' : undefined}
              rel={href ? 'noopener noreferrer' : undefined}
            >
              <div class="reel-thumb">
                <img src="/images/reel-mariages.webp" alt={`Cours ${i + 1}`} loading="lazy" width="1013" height="1372" />
                <div class="reel-overlay">
                  <svg class="reel-ig-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="2" y="2" width="20" height="20" rx="5" stroke="white" stroke-width="1.4"/>
                    <circle cx="12" cy="12" r="3.5" stroke="white" stroke-width="1.4"/>
                    <circle cx="17" cy="7" r="1.2" fill="white"/>
                  </svg>
                </div>
              </div>
              <p class="reel-label">{t.nav.reelLabel}
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M7 17L17 7M17 7H7M17 7v10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Section chant -->
  <section class="cours-section" aria-labelledby="chant-title">
    <div class="section-container cours-section-inner">
      <div class="cours-text reveal">
        <h2 id="chant-title">{t.cours.chantTitle}</h2>
        <p>{t.cours.chantDescription}</p>
        <ul class="cours-list">
          {t.cours.chantList.map(item => <li>{item}</li>)}
        </ul>
      </div>
      <div class="cours-deco reveal" aria-hidden="true">
        <div class="cours-deco-circle"></div>
      </div>
    </div>
  </section>

  <!-- Section danse -->
  <section class="cours-section cours-section-alt" aria-labelledby="danse-title">
    <div class="section-container cours-section-inner reverse">
      <div class="cours-deco reveal" aria-hidden="true">
        <div class="cours-deco-circle danse-circle"></div>
      </div>
      <div class="cours-text reveal">
        <h2 id="danse-title">{t.cours.danseTitle}</h2>
        <p>{t.cours.danseDescription}</p>
        <ul class="cours-list">
          {t.cours.danseList.map(item => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="cours-faq" aria-labelledby="faq-title">
    <div class="section-container">
      <div class="section-header reveal">
        <span class="eyebrow">{t.cours.faqEyebrow}</span>
        <h2 id="faq-title">{t.cours.faqTitle}</h2>
      </div>
      <div class="faq-list" id="faq-accordion">
        {faq.map((item: { q: string; a: string }, i: number) => (
          <details class="faq-item reveal" style={`transition-delay: ${i * 40}ms`}>
            <summary class="faq-question">
              {item.q}
              <span class="faq-chevron" aria-hidden="true">+</span>
            </summary>
            <p class="faq-answer">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cours-cta" aria-labelledby="cta-title">
    <div class="section-container">
      <div class="cta-inner reveal">
        <h2 id="cta-title">{t.cours.ctaTitle}</h2>
        <p>{t.cours.ctaSubtitle}</p>
        <a href="tel:+32486219896" class="btn-primary">{t.cours.ctaBtn}</a>
      </div>
    </div>
  </section>
  <CtaFloat href="tel:+32486219896" label={t.hero.ctaPrimary} />
</Layout>

<style>
  /* Hero */
  .cours-hero {
    padding-block: 5rem 3.5rem;
    background-color: var(--color-bg-card);
    overflow: hidden;
  }

  .cours-hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 2rem;
  }

  .cours-hero-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cours-hero-img {
    position: relative;
  }

  .cours-hero-img img {
    width: 100%;
    height: auto;
    display: block;
    mask-image:
      linear-gradient(to right, transparent 0%, black 15%, black 90%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, black 5%, black 95%, transparent 100%);
    mask-composite: intersect;
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, black 15%, black 90%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, black 5%, black 95%, transparent 100%);
    -webkit-mask-composite: source-in;
  }

  @media (max-width: 768px) {
    .cours-hero-inner {
      grid-template-columns: 1fr;
    }

    .cours-hero-img {
      max-height: 220px;
      overflow: hidden;
    }

    .cours-hero-img img {
      object-fit: cover;
      object-position: center top;
      height: 220px;
      width: 100%;
    }
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    text-decoration: none;
    margin-bottom: 0.25rem;
    min-height: 44px;
    padding: 0.5rem 0;
    transition: color 220ms var(--ease-out-soft), gap 220ms var(--ease-out-soft);
    -webkit-tap-highlight-color: transparent;
  }
  .back-link:hover { color: var(--color-accent); gap: 0.75rem; }

  .cours-hero-inner h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--color-section-title);
    margin: 0;
  }

  .cours-hero-subtitle {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: 0;
  }

  .reels-section { padding-block: var(--spacing-section); }

  .reels-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 1rem;
  }
  @media (min-width: 640px) { .reels-grid { grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 1.25rem; } }
  @media (min-width: 1024px) { .reels-grid { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); } }

  .reel-card { display: block; text-decoration: none; }

  .reel-thumb {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: 1.5rem;
    overflow: hidden;
    background-color: var(--color-bg-card);
    border: 0.5px solid var(--color-border);
  }

  .reel-thumb img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; position: absolute; inset: 0; transition: transform 500ms var(--ease-out-soft); }

  .reel-overlay {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    background: rgba(0,0,0,0.22);
    opacity: 0;
    transition: opacity 300ms var(--ease-out-soft);
  }

  .reel-ig-icon { filter: drop-shadow(0 2px 8px rgba(0,0,0,0.5)); }
  .reel-card:hover .reel-thumb img { transform: scale(1.03); }
  .reel-card:hover .reel-overlay { opacity: 1; }

  .reel-label {
    display: flex; align-items: center; justify-content: center; gap: 0.3rem;
    margin: 0.5rem 0 0; font-size: 0.7rem; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--color-text-secondary);
    transition: color 250ms var(--ease-out-soft);
  }
  .reel-card:hover .reel-label { color: var(--color-accent); }

  .cours-section { padding-block: 5rem; }
  .cours-section-alt { background-color: var(--color-bg-card); }

  .cours-section-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .cours-section-inner.reverse { direction: rtl; }
  .cours-section-inner.reverse > * { direction: ltr; }

  .cours-text h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); color: var(--color-text-primary); margin: 0 0 1.25rem; }
  .cours-text p { font-size: 1rem; color: var(--color-text-secondary); line-height: 1.75; margin: 0 0 1.5rem; }

  .cours-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .cours-list li {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    padding-left: 1.25rem;
    position: relative;
  }

  .cours-list li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-size: 1.25rem;
    line-height: 1;
    top: 0.1em;
  }

  .cours-deco-circle {
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--color-gold) 0%, transparent 70%);
    opacity: 0.06;
    margin-inline: auto;
  }

  .danse-circle { background: radial-gradient(circle, var(--color-accent) 0%, transparent 70%); }

  .section-header { text-align: center; margin-bottom: 3rem; display: flex; flex-direction: column; align-items: center; gap: 0.75rem; }
  .section-header h2 { font-size: clamp(1.875rem, 3.5vw, 2.75rem); color: var(--color-text-primary); margin: 0; }

  .cours-faq { padding-block: 5rem; background-color: var(--color-bg-card); }

  .faq-list { max-width: 800px; margin-inline: auto; display: flex; flex-direction: column; gap: 0; }
  .faq-item { border-bottom: 0.5px solid var(--color-border); }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    color: var(--color-text-primary);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker { display: none; }

  .faq-chevron { font-size: 1.25rem; color: var(--color-accent); transition: transform 300ms var(--ease-out-soft); flex-shrink: 0; }
  details[open] .faq-chevron { transform: rotate(45deg); }

  .faq-answer { font-size: 0.9375rem; color: var(--color-text-secondary); line-height: 1.75; margin: 0; padding-bottom: 1.25rem; padding-right: 2rem; }

  .cours-cta { padding-block: 5rem; }

  .cta-inner { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.25rem; }
  .cta-inner h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); color: var(--color-text-primary); margin: 0; }
  .cta-inner p { font-size: 1rem; color: var(--color-text-secondary); margin: 0; max-width: 45ch; line-height: 1.65; }

  /* Harmonisation avec la page Mariages & Evenements */
  .cours-hero {
    position: relative;
    padding-block: clamp(4rem, 8vw, 7rem) clamp(5rem, 9vw, 8rem);
    background:
      radial-gradient(ellipse at 11% 16%, rgba(255, 255, 255, 0.72), transparent 38%),
      radial-gradient(ellipse at 90% 30%, rgba(168, 135, 83, 0.13), transparent 34%),
      linear-gradient(180deg, #fffaf3 0%, #fbf0df 58%, #f4dec4 100%);
  }

  .cours-hero::before,
  .cours-hero::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .cours-hero::before {
    left: 0;
    top: 12%;
    width: min(420px, 46vw);
    height: min(420px, 46vw);
    border: 0.5px solid rgba(168, 135, 83, 0.13);
    border-left: 0;
    border-radius: 0 999px 999px 0;
    opacity: 0.72;
  }

  .cours-hero::after {
    inset-inline: 0;
    bottom: -1px;
    z-index: 1;
    height: clamp(5rem, 12vw, 9rem);
    background: linear-gradient(180deg, rgba(244, 222, 196, 0), #f4dec4 62%, #f7f1e6 100%);
  }

  .cours-hero-inner {
    position: relative;
    z-index: 2;
    grid-template-columns: minmax(0, 0.95fr) minmax(300px, 1.05fr);
    gap: clamp(2rem, 5vw, 5rem);
  }

  .cours-hero-img {
    justify-self: end;
    width: min(100%, 590px);
  }

  .cours-hero-img::before {
    content: '';
    position: absolute;
    inset: 8% -4% -7% 13%;
    border-radius: 32px;
    background: linear-gradient(145deg, rgba(168, 135, 83, 0.2), rgba(255, 255, 255, 0.08));
    transform: rotate(-2deg);
  }

  .cours-hero-img::after {
    content: '';
    position: absolute;
    inset: 7% 8% 7% -6%;
    border: 0.5px solid rgba(168, 135, 83, 0.28);
    border-radius: 28px;
    transform: rotate(2.4deg);
    pointer-events: none;
  }

  .cours-hero-img img {
    position: relative;
    z-index: 1;
    border-radius: 26px;
    box-shadow: 0 24px 58px rgba(72, 46, 25, 0.13);
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, black 12%, black 94%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, black 4%, black 94%, transparent 100%);
    mask-image:
      linear-gradient(to right, transparent 0%, black 12%, black 94%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, black 4%, black 94%, transparent 100%);
  }

  .cours-hero-inner h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 7vw, 5.7rem);
    font-weight: 300;
    line-height: 0.95;
    max-width: 10ch;
  }

  .reels-section {
    position: relative;
    overflow: hidden;
    margin-top: -1px;
    padding-block: clamp(3.8rem, 8vw, 6.8rem) clamp(6rem, 11vw, 9rem);
    background:
      radial-gradient(ellipse at 16% 8%, rgba(168, 135, 83, 0.08), transparent 34%),
      radial-gradient(ellipse at 88% 92%, rgba(135, 144, 115, 0.07), transparent 36%),
      linear-gradient(180deg, #f7f1e6 0%, #fff8ee 44%, #f2dfc9 100%);
  }

  .reels-section::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -1px;
    height: clamp(5rem, 12vw, 9rem);
    pointer-events: none;
    background: linear-gradient(180deg, rgba(242, 223, 201, 0), #f5e6d1 56%, #fff8ee 100%);
  }

  .reels-grid {
    position: relative;
    z-index: 1;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.72rem, 2.5vw, 1.1rem);
  }

  .reel-card {
    position: relative;
    display: grid;
    min-height: 188px;
    padding: 1rem;
    overflow: hidden;
    color: var(--color-charcoal);
    border: 0.5px solid rgba(154, 119, 72, 0.16);
    border-radius: 24px;
    background:
      radial-gradient(circle at 18% 14%, rgba(255, 255, 255, 0.74), transparent 28%),
      linear-gradient(145deg, rgba(255, 253, 248, 0.96), rgba(246, 235, 219, 0.82));
    box-shadow:
      0 14px 32px rgba(72, 46, 25, 0.065),
      inset 0 1px 0 rgba(255, 255, 255, 0.82);
    transition: transform 420ms var(--ease-out-soft), box-shadow 420ms var(--ease-out-soft);
  }

  .reel-card::after {
    content: '';
    position: absolute;
    right: -38px;
    top: -48px;
    width: 138px;
    height: 168px;
    border-radius: 999px;
    background: rgba(168, 135, 83, 0.1);
    transform: rotate(-24deg);
    transition: transform 650ms var(--ease-out-soft);
  }

  .reel-thumb {
    position: relative;
    z-index: 1;
    width: 44px;
    height: 44px;
    aspect-ratio: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-color: rgba(168, 135, 83, 0.2);
    border-radius: 15px;
    background: rgba(255, 250, 241, 0.72);
    backdrop-filter: blur(10px);
  }

  .reel-thumb img,
  .reel-overlay {
    display: none;
  }

  .reel-thumb::before {
    content: '';
    width: 18px;
    height: 18px;
    border: 1.35px solid rgba(92, 64, 41, 0.78);
    border-radius: 5px;
    box-shadow: inset 0 0 0 4px rgba(255, 250, 241, 0.72);
  }

  .reel-label {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    z-index: 1;
    justify-content: space-between;
    margin: 0;
    color: rgba(107, 86, 69, 0.78);
    font-weight: 600;
  }

  .reel-card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 18px 42px rgba(72, 46, 25, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.88);
  }

  .reel-card:hover::after {
    transform: rotate(-16deg) translate(-8px, 8px);
  }

  .cours-section,
  .cours-section-alt,
  .cours-faq,
  .cours-cta {
    position: relative;
    overflow: hidden;
    margin-top: -1px;
    border: 0;
  }

  .cours-section {
    background:
      radial-gradient(ellipse at 14% 22%, rgba(168, 135, 83, 0.07), transparent 32%),
      linear-gradient(180deg, #fff8ee 0%, #fbf1e1 100%);
  }

  .cours-section-alt {
    background:
      radial-gradient(ellipse at 86% 18%, rgba(135, 144, 115, 0.08), transparent 34%),
      linear-gradient(180deg, #fbf1e1 0%, #f7e4cd 100%);
  }

  .cours-faq {
    background:
      radial-gradient(ellipse at 50% 0%, rgba(255, 255, 255, 0.65), transparent 34%),
      linear-gradient(180deg, #f7e4cd 0%, #fff8ee 100%);
  }

  .cours-cta {
    padding-block: clamp(4rem, 8vw, 6.6rem);
    background:
      radial-gradient(ellipse at 50% 0%, rgba(255, 255, 255, 0.72), transparent 34%),
      radial-gradient(ellipse at 12% 90%, rgba(168, 135, 83, 0.08), transparent 32%),
      linear-gradient(180deg, #fff8ee 0%, #fbf1e1 56%, #f6e3cc 100%);
  }

  .cours-text h2,
  .section-header h2,
  .cta-inner h2 {
    font-family: var(--font-serif);
    font-weight: 300;
    line-height: 0.98;
  }

  .faq-item {
    border-bottom-color: rgba(168, 135, 83, 0.18);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.78rem 1.35rem;
    color: #fff7ec;
    border: 0.5px solid rgba(255, 234, 199, 0.32);
    border-radius: 999px;
    background: linear-gradient(145deg, rgba(92, 64, 41, 0.96), rgba(122, 92, 58, 0.94));
    box-shadow: 0 16px 32px rgba(72, 46, 25, 0.14), inset 0 1px 0 rgba(255, 255, 255, 0.18);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: transform 280ms var(--ease-out-soft), background 280ms var(--ease-out-soft), box-shadow 280ms var(--ease-out-soft);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    background: linear-gradient(145deg, rgba(105, 73, 46, 0.98), rgba(137, 103, 65, 0.95));
  }

  @media (max-width: 900px) {
    .cours-section-inner { grid-template-columns: 1fr; gap: 2rem; }
    .cours-section-inner.reverse { direction: ltr; }
    .cours-deco { display: none; }
  }

  @media (max-width: 768px) {
    .cours-hero {
      padding-block: 3.2rem 4.9rem;
    }

    .cours-hero-inner {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }

    .cours-hero-img {
      justify-self: stretch;
      width: 100%;
      max-height: 260px;
      border-radius: 22px;
    }

    .cours-hero-img::before,
    .cours-hero-img::after {
      display: none;
    }

    .cours-hero-img img {
      height: 260px;
      border-radius: 22px;
    }

    .reels-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
