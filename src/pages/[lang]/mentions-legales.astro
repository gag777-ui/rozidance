---
import RefonteLegal from '../refonte/mentions-legales.astro';
import { translatedLangs } from '../../i18n/refonte';

export function getStaticPaths() {
  return translatedLangs.map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props;
---

<RefonteLegal lang={lang} />
