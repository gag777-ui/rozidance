---
import Layout from '../../layouts/Layout.astro';
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
import SectionHero from '../../components/sections/SectionHero.astro';
import SectionPrestations from '../../components/sections/SectionPrestations.astro';
import SectionGalerie from '../../components/sections/SectionGalerie.astro';
import SectionVideos from '../../components/sections/SectionVideos.astro';
import SectionApropos from '../../components/sections/SectionApropos.astro';
import SectionStats from '../../components/sections/SectionStats.astro';
import SectionTemoignages from '../../components/sections/SectionTemoignages.astro';
import SectionFAQ from '../../components/sections/SectionFAQ.astro';
import SectionContact from '../../components/sections/SectionContact.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'nl' } },
    { params: { lang: 'ru' } },
    { params: { lang: 'de' } },
    { params: { lang: 'es' } },
    { params: { lang: 'it' } },
  ];
}

const lang = (Astro.currentLocale ?? Astro.params.lang ?? 'fr') as Lang;
const t = getTranslations(lang);
---

<Layout
  title={t.meta.siteTitle}
  description={t.meta.siteDescription}
  keywords={t.meta.keywords}
  ogTitle={t.meta.ogTitle}
  ogDescription={t.meta.ogDescription}
>
  <SchemaOrg slot="schema" />

  <SectionHero />

  <!-- Bande réseaux sociaux -->
  <div class="hero-tagband">
    <div class="tagband-inner">

      <!-- YouTube -->
      <a
        href="https://www.youtube.com/@luarozihayband"
        target="_blank"
        rel="noopener noreferrer"
        class="social-link social-yt"
        aria-label="Rozi Dance sur YouTube"
      >
        <svg width="26" height="22" viewBox="0 0 24 17" fill="currentColor" aria-hidden="true">
          <path d="M23.495 6.205a3.007 3.007 0 00-2.088-2.088C19.539 3.6 12 3.6 12 3.6s-7.538 0-9.407.517A3.007 3.007 0 00.505 6.205 31.247 31.247 0 000 12a31.247 31.247 0 00.505 5.795 3.007 3.007 0 002.088 2.088C4.462 20.4 12 20.4 12 20.4s7.538 0 9.407-.517a3.007 3.007 0 002.088-2.088A31.247 31.247 0 0024 12a31.247 31.247 0 00-.505-5.795zM9.609 15.601V8.399L15.873 12l-6.264 3.601z" transform="translate(0 -3.6)"/>
        </svg>
      </a>

      <span class="social-sep" aria-hidden="true"></span>

      <!-- Facebook -->
      <a
        href="https://www.facebook.com/RoziDanseenBelgique/"
        target="_blank"
        rel="noopener noreferrer"
        class="social-link social-fb"
        aria-label="Rozi Dance sur Facebook"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M24 12.073C24 5.446 18.627 0 12 0S0 5.446 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047v-2.66c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.971h-1.513c-1.491 0-1.956.93-1.956 1.886v2.264h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/>
        </svg>
      </a>

      <span class="social-sep" aria-hidden="true"></span>

      <!-- Instagram -->
      <a
        href="https://www.instagram.com/rozi.dance/"
        target="_blank"
        rel="noopener noreferrer"
        class="social-link social-ig"
        aria-label="Rozi Dance sur Instagram @rozi.dance"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
        </svg>
      </a>

    </div>
  </div>

  <div class="prestations-wrap">
    <SectionPrestations />
  </div>
  <SectionGalerie />
  <SectionVideos />
  <SectionApropos />
  <SectionStats />
  <SectionTemoignages />
  <SectionFAQ />
  <SectionContact />
</Layout>

<style>
  .hero-tagband {
    background-color: var(--color-bg-primary);
    position: relative;
    overflow: hidden;
  }

  .hero-tagband::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 34px;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(247, 241, 230, 0) 0%, #fff8ee 100%);
  }

  .tagband-inner {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.5rem;
    padding-block: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  /* Icônes réseaux sociaux — tons bijou adoucis */
  .social-link {
    --social-tone: #805f2a;
    --social-glow: rgba(128, 95, 42, 0.14);
    --social-wash: rgba(128, 95, 42, 0.08);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    color: var(--social-tone);
    border: 1px solid rgba(141, 105, 57, 0.18);
    background:
      radial-gradient(circle at 28% 20%, rgba(255, 255, 255, 0.9), transparent 36%),
      radial-gradient(circle at 72% 78%, var(--social-wash), transparent 48%),
      linear-gradient(145deg, rgba(255, 250, 241, 0.82), rgba(235, 217, 190, 0.58));
    box-shadow:
      0 12px 26px rgba(79, 50, 27, 0.08),
      0 0 0 6px var(--social-glow),
      inset 0 1px 0 rgba(255, 255, 255, 0.78);
    text-decoration: none;
    transition:
      color var(--duration-normal) var(--ease-standard),
      border-color var(--duration-normal) var(--ease-standard),
      box-shadow var(--duration-normal) var(--ease-standard),
      transform var(--duration-short) var(--ease-standard);
  }

  .social-link svg {
    width: 18px;
    height: 18px;
  }

  .social-yt svg {
    width: 22px;
    height: 18px;
  }

  .social-link:hover {
    color: var(--social-tone);
    border-color: color-mix(in srgb, var(--social-tone) 40%, rgba(255, 255, 255, 0.5));
    box-shadow:
      0 16px 34px rgba(79, 50, 27, 0.12),
      0 0 0 8px var(--social-glow),
      inset 0 1px 0 rgba(255, 255, 255, 0.86);
    transform: translateY(-3px) scale(1.12);
    animation-play-state: paused;
  }

  /* Animation respiration — décalée par icône */
  @keyframes socialBreathe {
    0%, 100% { transform: scale(1);    opacity: 1; }
    50%       { transform: scale(1.12); opacity: 0.78; }
  }

  .social-fb {
    --social-tone: #4f6f8f;
    --social-glow: rgba(79, 111, 143, 0.13);
    --social-wash: rgba(79, 111, 143, 0.12);
    animation: socialBreathe 3.6s ease-in-out 0s infinite;
  }

  .social-yt {
    --social-tone: #9b5445;
    --social-glow: rgba(155, 84, 69, 0.13);
    --social-wash: rgba(155, 84, 69, 0.12);
    animation: socialBreathe 3.6s ease-in-out 1.2s infinite;
  }

  .social-ig {
    --social-tone: #9a6b74;
    --social-glow: rgba(154, 107, 116, 0.14);
    --social-wash: rgba(154, 107, 116, 0.13);
    animation: socialBreathe 3.6s ease-in-out 2.4s infinite;
  }

  /* Séparateur losange */
  .social-sep {
    display: inline-block;
    width: 5px;
    height: 5px;
    background-color: var(--color-divider);
    transform: rotate(45deg);
    margin-inline: var(--space-xs);
    opacity: 0.6;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .social-link { transition: none; animation: none; }
  }

  .prestations-wrap :global(.section-prestations) {
    padding-top: 2rem;
  }
</style>
