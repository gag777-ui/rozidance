<script>
  function initChantCarousel() {
    const carousel = document.getElementById('chant-carousel');
    if (!carousel) return;
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.cc-slide'));
    const videos = slides.map(s => s.querySelector<HTMLVideoElement>('video')!);
    const links  = slides.map(s => s.querySelector<HTMLAnchorElement>('.cc-link')!);
    let current = 0, timer: ReturnType<typeof setInterval> | null = null;
    function activate(idx: number) {
      slides[current].classList.remove('is-active'); links[current].tabIndex = -1; videos[current]?.pause();
      current = idx;
      slides[current].classList.add('is-active'); links[current].tabIndex = 0;
      const v = videos[current];
      if (v) { v.currentTime = parseInt(slides[current].dataset.start||'0'); v.muted=true; v.play().catch(()=>{}); }
    }
    function startTimer() { if (timer) clearInterval(timer); timer = setInterval(() => activate((current+1)%slides.length), 7000); }
    let touchStartX = 0;
    carousel.addEventListener('touchstart', (e: TouchEvent) => { touchStartX = e.touches[0].clientX; }, { passive: true });
    carousel.addEventListener('touchend', (e: TouchEvent) => {
      const diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) { activate(diff>0?(current+1)%slides.length:(current-1+slides.length)%slides.length); startTimer(); }
    }, { passive: true });
    new IntersectionObserver((entries, obs) => {
      if (!entries[0].isIntersecting) return;
      obs.disconnect();
      const first = videos[0];
      if (first) { first.currentTime = parseInt(slides[0].dataset.start||'0'); first.muted=true; first.play().catch(()=>{}); }
      startTimer();
    }, { threshold: 0.1 }).observe(carousel);
    document.addEventListener('astro:before-swap', () => { if(timer) clearInterval(timer); }, { once: true });
  }

  function initVideoCarousel() {
    const wrapper = document.getElementById('video-carousel-mobile');
    if (!wrapper) return;

    const carousel = wrapper.querySelector<HTMLElement>('.video-carousel');
    if (!carousel) return;

    const cards = Array.from(carousel.querySelectorAll<HTMLElement>('.video-card'));
    let scrollRaf = 0;
    let activeVideoIndex = -1;
    let carouselVisible = false;
    let autoTimer: ReturnType<typeof setInterval> | null = null;
    let resumeTimer: ReturnType<typeof setTimeout> | null = null;
    let userInteracting = false;
    const observers: IntersectionObserver[] = [];
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const AUTO_SCROLL_DELAY = 3900;
    const RESUME_DELAY = 5200;

    const getCardMedia = (card: HTMLElement) => ({
      video: card.querySelector<HTMLVideoElement>('.video-player'),
      playBtn: card.querySelector<HTMLButtonElement>('.play-btn'),
    });

    const setPlayButton = (playBtn: HTMLButtonElement | null, visible: boolean) => {
      if (!playBtn) return;
      playBtn.style.opacity = visible ? '1' : '0';
      playBtn.style.pointerEvents = visible ? 'auto' : 'none';
    };

    const prepareVideo = (card: HTMLElement, video: HTMLVideoElement) => {
      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;
      video.setAttribute('playsinline', '');
      video.setAttribute('webkit-playsinline', '');
      video.preload = 'auto';

      const src = card.dataset.src;
      if (src && !video.currentSrc) {
        video.src = src;
      }
      if (video.readyState === 0) {
        video.load();
      }
    };

    const seekToStart = (card: HTMLElement, video: HTMLVideoElement) => {
      const startTime = parseInt(card.dataset.start || '0');
      const applySeek = () => {
        try {
          if (Math.abs(video.currentTime - startTime) > 0.5) {
            video.currentTime = startTime;
          }
        } catch {}
      };

      if (video.readyState >= 1) {
        applySeek();
      } else {
        video.addEventListener('loadedmetadata', applySeek, { once: true });
      }
    };

    const pauseInactiveVideos = (activeIndex: number) => {
      cards.forEach((card, index) => {
        if (index === activeIndex) return;
        const { video, playBtn } = getCardMedia(card);
        if (!video) return;
        video.pause();
        setPlayButton(playBtn, true);
      });
    };

    const pauseAllVideos = () => {
      cards.forEach(card => {
        const { video, playBtn } = getCardMedia(card);
        if (!video) return;
        video.pause();
        setPlayButton(playBtn, true);
      });
    };

    const playActiveVideo = (index: number, reset = false) => {
      if (!carouselVisible) return;

      const card = cards[index];
      if (!card) return;

      const { video, playBtn } = getCardMedia(card);
      if (!video) return;

      pauseInactiveVideos(index);
      prepareVideo(card, video);
      if (reset) seekToStart(card, video);

      video.play()
        .then(() => setPlayButton(playBtn, false))
        .catch(() => setPlayButton(playBtn, true));
    };

    const centerCard = (index: number, behavior: ScrollBehavior = 'smooth') => {
      const card = cards[index];
      if (!card) return;
      const targetLeft = card.offsetLeft - (carousel.clientWidth - card.offsetWidth) / 2;
      carousel.scrollTo({ left: targetLeft, behavior });
    };

    const stopAutoScroll = () => {
      if (!autoTimer) return;
      clearInterval(autoTimer);
      autoTimer = null;
    };

    const startAutoScroll = () => {
      if (prefersReducedMotion || autoTimer || cards.length < 2) return;
      autoTimer = setInterval(() => {
        if (!carouselVisible || userInteracting || document.hidden) return;
        const nextIndex = activeVideoIndex < 0 ? 0 : (activeVideoIndex + 1) % cards.length;
        centerCard(nextIndex);
      }, AUTO_SCROLL_DELAY);
    };

    const pauseAutoScrollBriefly = () => {
      userInteracting = true;
      if (resumeTimer) clearTimeout(resumeTimer);
      resumeTimer = setTimeout(() => {
        userInteracting = false;
        if (carouselVisible) startAutoScroll();
      }, RESUME_DELAY);
    };

    const updateCoverflow = () => {
      scrollRaf = 0;
      const carouselRect = carousel.getBoundingClientRect();
      const center = carouselRect.left + carouselRect.width / 2;
      let activeIndex = 0;
      let closest = Number.POSITIVE_INFINITY;

      cards.forEach((card, index) => {
        const rect = card.getBoundingClientRect();
        const cardCenter = rect.left + rect.width / 2;
        const distance = Math.abs(cardCenter - center);
        if (distance < closest) {
          closest = distance;
          activeIndex = index;
        }
      });

      cards.forEach((card, index) => {
        const rect = card.getBoundingClientRect();
        const cardCenter = rect.left + rect.width / 2;
        const rawOffset = (cardCenter - center) / Math.max(rect.width, 1);
        const offset = Math.max(-2.2, Math.min(2.2, rawOffset));
        const absOffset = Math.abs(offset);
        const depth = Math.min(absOffset, 2);
        const scale = 1 - depth * 0.105;
        const z = 110 - depth * 150;
        const rotate = -offset * 25;
        const translateX = -offset * 16;
        const opacity = Math.max(0.24, 1 - absOffset * 0.34);
        const saturation = Math.max(0.76, 1 - absOffset * 0.09);
        const brightness = Math.max(0.86, 1 - absOffset * 0.045);

        card.style.setProperty('--flow-x', `${translateX.toFixed(1)}px`);
        card.style.setProperty('--flow-z', `${z.toFixed(1)}px`);
        card.style.setProperty('--flow-rotate', `${rotate.toFixed(2)}deg`);
        card.style.setProperty('--flow-scale', scale.toFixed(3));
        card.style.setProperty('--flow-opacity', opacity.toFixed(3));
        card.style.setProperty('--flow-saturation', saturation.toFixed(3));
        card.style.setProperty('--flow-brightness', brightness.toFixed(3));

        card.classList.remove('is-active', 'is-prev', 'is-next', 'is-far-left', 'is-far-right');
        if (index === activeIndex) {
          card.classList.add('is-active');
        } else if (index === activeIndex - 1) {
          card.classList.add('is-prev');
        } else if (index === activeIndex + 1) {
          card.classList.add('is-next');
        } else if (index < activeIndex) {
          card.classList.add('is-far-left');
        } else {
          card.classList.add('is-far-right');
        }
      });

      const changedActiveVideo = activeIndex !== activeVideoIndex;
      activeVideoIndex = activeIndex;
      playActiveVideo(activeIndex, changedActiveVideo);
    };

    const scheduleCoverflow = () => {
      if (scrollRaf) return;
      scrollRaf = requestAnimationFrame(updateCoverflow);
    };

    cards.forEach(card => {
      const video = card.querySelector<HTMLVideoElement>('.video-player');
      const playBtn = card.querySelector<HTMLButtonElement>('.play-btn');
      if (!video || !playBtn) return;

      const observer = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          prepareVideo(card, video);
        }
      }, { threshold: 0, rootMargin: '500px 0px' });
      observer.observe(card);
      observers.push(observer);

      playBtn.addEventListener('click', (e: Event) => {
        e.preventDefault();
        const index = cards.indexOf(card);
        activeVideoIndex = index;
        prepareVideo(card, video);
        seekToStart(card, video);
        pauseInactiveVideos(index);
        video.play()
          .then(() => setPlayButton(playBtn, false))
          .catch(() => setPlayButton(playBtn, true));
      });

      card.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a, button')) return;
        pauseAutoScrollBriefly();
        card.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      });

      video.addEventListener('play', () => { playBtn.style.opacity = '0'; });
      video.addEventListener('pause', () => { playBtn.style.opacity = '1'; });
      video.addEventListener('ended', () => { playBtn.style.opacity = '1'; });
    });

    const visibilityObserver = new IntersectionObserver((entries) => {
      carouselVisible = entries[0]?.isIntersecting ?? false;
      if (carouselVisible) {
        playActiveVideo(activeVideoIndex >= 0 ? activeVideoIndex : 0, true);
        startAutoScroll();
      } else {
        stopAutoScroll();
        pauseAllVideos();
      }
    }, { threshold: 0.38 });
    visibilityObserver.observe(wrapper);
    observers.push(visibilityObserver);

    const handleVisibilityChange = () => {
      if (document.hidden) {
        stopAutoScroll();
        pauseAllVideos();
      } else {
        playActiveVideo(activeVideoIndex >= 0 ? activeVideoIndex : 0);
        if (carouselVisible) startAutoScroll();
      }
    };

    const handleUserInteraction = () => pauseAutoScrollBriefly();

    carousel.addEventListener('scroll', scheduleCoverflow, { passive: true });
    carousel.addEventListener('pointerdown', handleUserInteraction, { passive: true });
    carousel.addEventListener('touchstart', handleUserInteraction, { passive: true });
    carousel.addEventListener('wheel', handleUserInteraction, { passive: true });
    carousel.addEventListener('keydown', handleUserInteraction);
    window.addEventListener('resize', scheduleCoverflow, { passive: true });
    document.addEventListener('visibilitychange', handleVisibilityChange);
    updateCoverflow();

    document.addEventListener('astro:before-swap', () => {
      if (scrollRaf) cancelAnimationFrame(scrollRaf);
      stopAutoScroll();
      if (resumeTimer) clearTimeout(resumeTimer);
      pauseAllVideos();
      observers.forEach(observer => observer.disconnect());
      carousel.removeEventListener('pointerdown', handleUserInteraction);
      carousel.removeEventListener('touchstart', handleUserInteraction);
      carousel.removeEventListener('wheel', handleUserInteraction);
      carousel.removeEventListener('keydown', handleUserInteraction);
      window.removeEventListener('resize', scheduleCoverflow);
      document.removeEventListener('visibilitychange', handleVisibilityChange);
    }, { once: true });
  }

  document.addEventListener('astro:page-load', initChantCarousel);
  document.addEventListener('astro:page-load', initVideoCarousel);
</script>
