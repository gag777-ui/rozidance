---
import RefonteCoursDetail from '../../refonte/cours/[slug].astro';
import { coursPages } from '../../../data/refonte';
import { translatedLangs } from '../../../i18n/refonte';

export function getStaticPaths() {
  return translatedLangs.flatMap((lang) =>
    coursPages.map((page) => ({
      params: { lang, slug: page.slug },
      props: { lang, page },
    })),
  );
}

const { lang, page } = Astro.props;
---

<RefonteCoursDetail page={page} lang={lang} />
