---
import RefonteMariageDetail from '../../refonte/mariages/[slug].astro';
import { mariagePages } from '../../../data/refonte';
import { translatedLangs } from '../../../i18n/refonte';

export function getStaticPaths() {
  return translatedLangs.flatMap((lang) =>
    mariagePages.map((page) => ({
      params: { lang, slug: page.slug },
      props: { lang, page },
    })),
  );
}

const { lang, page } = Astro.props;
---

<RefonteMariageDetail page={page} lang={lang} />
