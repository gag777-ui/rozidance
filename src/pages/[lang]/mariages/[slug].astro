---
import Layout from '../../../layouts/Layout.astro';
import { getTranslations } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/utils';

export async function getStaticPaths() {
  const fr = (await import('../../../i18n/fr.json')).default;
  const langs = ['en', 'nl', 'ru'];
  return langs.flatMap(lang =>
    fr.mariages.categories.map(cat => ({
      params: { lang, slug: cat.slug },
      props: { slug: cat.slug },
    }))
  );
}

const { slug } = Astro.props;
const lang = (Astro.currentLocale ?? Astro.params.lang ?? 'fr') as Lang;
const t = getTranslations(lang);
const s = t.mariagesSlug;

const cat = t.mariages.categories.find(c => c.slug === slug)!;
// Reels are language-agnostic — always read from fr.json
const fr = (await import('../../../i18n/fr.json')).default;
const frCat = fr.mariages.categories.find((c: any) => c.slug === slug)!;
const reelsSrc = (frCat as any).reels as (string | null)[] | undefined;
const reels: string[] = Array.from({ length: cat.count }, (_, i) =>
  reelsSrc?.[i] ?? '#'
);

/* ── Carousels (même logique que /mariages/[slug].astro) ── */
const isDanse      = slug === 'danse-de-mariage';
const isMariee     = slug === 'chant-de-la-mariee';
const isDanseMariee = slug === 'danse-de-la-mariee';
const isMusicians  = slug === 'musiciens';

const danseVideos = [
  { src: '/videos/mariages/danse-1.mp4', href: 'https://www.instagram.com/reel/DO8kuahirNR/', start: 4  },
  { src: '/videos/mariages/danse-2.mp4', href: 'https://www.instagram.com/reel/DXPkBfZjDfG/', start: 13 },
  { src: '/videos/mariages/danse-3.mp4', href: 'https://www.instagram.com/reel/DY6ymdMsrb6/', start: 8  },
  { src: '/videos/mariages/danse-4.mp4', href: 'https://www.instagram.com/reel/DKxHqISI1Wp/', start: 9  },
];
const marieeVideos = [
  { src: '/videos/mariee/mariee-1.mp4', href: 'https://www.instagram.com/reel/DYSGbsVtK7S/', start: 4 },
  { src: '/videos/mariee/mariee-2.mp4', href: 'https://www.instagram.com/reel/DYCpnNTiIAA/', start: 8 },
  { src: '/videos/mariee/mariee-3.mp4', href: 'https://www.instagram.com/reel/DCzj6L4IQAA/', start: 5 },
];
const danseMarieeVideos = [
  { src: '/videos/danse-mariee/danse-mariee-3.mp4', href: 'https://www.instagram.com/reel/DR1unSWDMTp/', start: 12, duration: 12000 },
];
const musiciensVideos = [
  { src: '/videos/musiciens/musiciens-1.mp4', href: 'https://www.instagram.com/reel/DO8wo3NjEY0/', start: 22 },
  { src: '/videos/musiciens/musiciens-2.mp4', href: 'https://www.instagram.com/reel/DAtffBloITF/', start: 2  },
  { src: '/videos/musiciens/musiciens-3.mp4', href: 'https://www.instagram.com/reel/DPl-zEijMzZ/', start: 15 },
];
---

<Layout title={`${cat.title} — Rozi Dance`} description={cat.description}>
  <!-- Hero -->
  <section class="cat-hero">
    <div class="section-container cat-hero-inner">
      <div class="cat-hero-copy">
        <a href={`/${lang}/mariages`} class="back-link">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M12 7H2M6 3l-4 4 4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {s.backLink}
        </a>
        <span class="eyebrow">{s.eyebrow}</span>
        <h1>{cat.title}</h1>
        <p class="hero-subtitle">{cat.description}</p>
      </div>
      {isMusicians ? (
        <div class="reel-carousel" id="reel-carousel">
          {musiciensVideos.map((v, i) => (
            <div class={`reel-slide${i === 0 ? ' is-active' : ''}`} data-start={v.start}>
              <a href={v.href} target="_blank" rel="noopener noreferrer" class="reel-video-link" tabindex={i === 0 ? 0 : -1}>
                <video class="reel-video" muted loop playsinline disablepictureinpicture preload={i === 0 ? 'auto' : 'none'}>
                  <source src={v.src} type="video/mp4" />
                </video>
                <div class="reel-hover-cta" aria-hidden="true">Voir sur Instagram</div>
              </a>
            </div>
          ))}
        </div>
      ) : isDanseMariee ? (
        <div class="reel-carousel" id="reel-carousel">
          {danseMarieeVideos.map((v, i) => (
            <div class={`reel-slide${i === 0 ? ' is-active' : ''}`} data-start={v.start} data-duration={(v as any).duration}>
              <a href={v.href} target="_blank" rel="noopener noreferrer" class="reel-video-link" tabindex={i === 0 ? 0 : -1}>
                <video class="reel-video" muted loop playsinline disablepictureinpicture preload="auto">
                  <source src={v.src} type="video/mp4" />
                </video>
                <div class="reel-hover-cta" aria-hidden="true">Voir sur Instagram</div>
              </a>
            </div>
          ))}
        </div>
      ) : isMariee ? (
        <div class="reel-carousel" id="reel-carousel">
          {marieeVideos.map((v, i) => (
            <div class={`reel-slide${i === 0 ? ' is-active' : ''}`} data-start={v.start}>
              <a href={v.href} target="_blank" rel="noopener noreferrer" class="reel-video-link" tabindex={i === 0 ? 0 : -1}>
                <video class="reel-video" muted loop playsinline disablepictureinpicture preload={i === 0 ? 'auto' : 'none'}>
                  <source src={v.src} type="video/mp4" />
                </video>
                <div class="reel-hover-cta" aria-hidden="true">Voir sur Instagram</div>
              </a>
            </div>
          ))}
        </div>
      ) : isDanse ? (
        <div class="reel-carousel" id="reel-carousel">
          {danseVideos.map((v, i) => (
            <div class={`reel-slide${i === 0 ? ' is-active' : ''}`} data-start={v.start}>
              <a href={v.href} target="_blank" rel="noopener noreferrer" class="reel-video-link" tabindex={i === 0 ? 0 : -1}>
                <video class="reel-video" muted loop playsinline disablepictureinpicture preload={i === 0 ? 'auto' : 'none'}>
                  <source src={v.src} type="video/mp4" />
                </video>
                <div class="reel-hover-cta" aria-hidden="true">Voir sur Instagram</div>
              </a>
            </div>
          ))}
        </div>
      ) : (
        <div class="cat-hero-panel" aria-hidden="true">
          <span class="panel-line"></span>
          <span class="panel-arc"></span>
          <span class="panel-word">{cat.title}</span>
          <div class="panel-meta">
            <span>{cat.count} {s.videoLabel}s</span>
            <span>Instagram</span>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Reels grid -->
  <section class="reels-section" aria-labelledby="moments-title">
    <div class="section-container">
      <div class="reels-heading reveal-fade">
        <span class="eyebrow">{t.nav.reelLabel}</span>
        <h2 id="moments-title">{s.momentsTitle}</h2>
        <p>{s.momentsText}</p>
      </div>
      <div class="reels-grid">
        {reels.map((href, i) => (
          <a
            href={href}
            class="reel-card reveal"
            style={`transition-delay: ${i * 50}ms`}
            aria-label={`${cat.title} — ${s.videoLabel} ${i + 1}`}
            target={href !== '#' ? '_blank' : undefined}
            rel={href !== '#' ? 'noopener noreferrer' : undefined}
          >
            <span class="reel-card-glow" aria-hidden="true"></span>
            <span class="reel-ig-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.35"/>
                <circle cx="12" cy="12" r="3.35" stroke="currentColor" stroke-width="1.35"/>
                <circle cx="17" cy="7" r="1.1" fill="currentColor"/>
              </svg>
            </span>
            <span class="reel-line" aria-hidden="true"></span>
            <span class="reel-title">{t.nav.reelLabel}</span>
            <span class="reel-note">Instagram</span>
            <span class="reel-arrow" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M4 12 12 4M12 4H5M12 4v7" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cat-cta">
    <div class="section-container cat-cta-inner reveal-fade">
      <span class="eyebrow">{s.ctaEyebrow}</span>
      <h2>{s.ctaTitle}</h2>
      <p>{s.ctaText}</p>
      <div class="cta-actions">
        <a href={`/${lang}#contact`} class="cta-btn cta-primary">
          {s.ctaBtn}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href={`/${lang}/mariages`} class="cta-btn cta-secondary">
          {s.ctaBtnSecondary}
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .cat-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.8rem, 8vw, 7rem) clamp(5rem, 10vw, 8rem);
    background:
      radial-gradient(ellipse at 12% 18%, rgba(255, 255, 255, 0.72), transparent 38%),
      radial-gradient(ellipse at 88% 20%, rgba(168, 135, 83, 0.12), transparent 36%),
      linear-gradient(180deg, #fffaf3 0%, #fbefdf 58%, #f6e1c8 100%);
  }

  .cat-hero::before,
  .cat-hero::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .cat-hero::before {
    left: -120px;
    top: 18%;
    width: min(480px, 58vw);
    height: min(480px, 58vw);
    border: 0.5px solid rgba(168, 135, 83, 0.12);
    border-radius: 999px;
  }

  .cat-hero::after {
    inset-inline: 0;
    bottom: -1px;
    height: clamp(5rem, 12vw, 9rem);
    background: linear-gradient(180deg, rgba(246, 225, 200, 0), #f6e1c8 52%, #fff7ec 100%);
  }

  .cat-hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.98fr) minmax(280px, 0.72fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .cat-hero-copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.48rem;
    width: fit-content;
    min-height: 40px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    text-decoration: none;
    margin-bottom: 0.5rem;
    transition: color 220ms var(--ease-out-soft), gap 220ms var(--ease-out-soft);
  }

  .back-link:hover { color: var(--color-accent); gap: 0.6rem; }

  .cat-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.7rem, 7vw, 6rem);
    font-weight: 300;
    color: var(--color-text-primary);
    line-height: 0.96;
    max-width: 10ch;
    margin: 0;
  }

  .hero-subtitle {
    font-size: clamp(0.9375rem, 1.5vw, 1.0625rem);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 56ch;
    margin: 0;
  }

  .cat-hero-panel {
    position: relative;
    min-height: clamp(250px, 36vw, 430px);
    border: 0.5px solid rgba(168, 135, 83, 0.18);
    border-radius: 34px;
    background:
      radial-gradient(circle at 26% 24%, rgba(255, 255, 255, 0.75), transparent 32%),
      radial-gradient(circle at 74% 78%, rgba(168, 135, 83, 0.12), transparent 36%),
      linear-gradient(145deg, rgba(255, 253, 248, 0.84), rgba(242, 224, 201, 0.58));
    box-shadow:
      0 22px 56px rgba(72, 46, 25, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.72);
    overflow: hidden;
  }

  .panel-line,
  .panel-arc,
  .panel-word {
    position: absolute;
    pointer-events: none;
  }

  .panel-line {
    left: 10%;
    top: 22%;
    width: 54%;
    height: 1px;
    background: linear-gradient(90deg, rgba(168, 135, 83, 0.42), transparent);
    box-shadow:
      0 42px 0 rgba(168, 135, 83, 0.16),
      0 84px 0 rgba(168, 135, 83, 0.1);
  }

  .panel-arc {
    right: -24%;
    top: 12%;
    width: 78%;
    aspect-ratio: 1;
    border: 0.5px solid rgba(168, 135, 83, 0.22);
    border-radius: 999px;
  }

  .panel-word {
    left: 10%;
    right: 10%;
    bottom: 27%;
    color: rgba(43, 31, 21, 0.12);
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 4.6vw, 4.6rem);
    font-style: italic;
    font-weight: 300;
    line-height: 0.95;
  }

  .panel-meta {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .panel-meta span {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0.45rem 0.72rem;
    color: rgba(75, 53, 36, 0.72);
    border: 0.5px solid rgba(168, 135, 83, 0.18);
    border-radius: 999px;
    background: rgba(255, 251, 244, 0.58);
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
  }

  .reels-section {
    position: relative;
    overflow: hidden;
    margin-top: -1px;
    padding-block: clamp(3.6rem, 8vw, 6.6rem) clamp(5.5rem, 10vw, 8rem);
    background:
      radial-gradient(ellipse at 18% 18%, rgba(168, 135, 83, 0.08), transparent 34%),
      radial-gradient(ellipse at 88% 82%, rgba(135, 144, 115, 0.07), transparent 36%),
      linear-gradient(180deg, #fff7ec 0%, #fffaf4 48%, #f5e3cc 100%);
  }

  .reels-section::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -1px;
    height: clamp(5rem, 11vw, 8rem);
    pointer-events: none;
    background: linear-gradient(180deg, rgba(245, 227, 204, 0), #f5e3cc 48%, #fff8ee 100%);
  }

  .reels-heading {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.75rem;
    max-width: 760px;
    margin-bottom: clamp(1.4rem, 4vw, 2.6rem);
  }

  .reels-heading h2 {
    margin: 0;
    color: var(--color-charcoal);
    font-family: var(--font-serif);
    font-size: clamp(2.1rem, 6vw, 4.8rem);
    font-weight: 300;
    line-height: 0.98;
  }

  .reels-heading p {
    max-width: 58ch;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: clamp(0.95rem, 1.45vw, 1.08rem);
    line-height: 1.75;
  }

  .reels-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.72rem, 2.4vw, 1rem);
  }

  .reel-card {
    position: relative;
    display: grid;
    min-height: 188px;
    padding: 1rem;
    overflow: hidden;
    color: var(--color-charcoal);
    text-decoration: none;
    border: 0.5px solid rgba(154, 119, 72, 0.16);
    border-radius: 24px;
    background:
      radial-gradient(circle at 18% 14%, rgba(255, 255, 255, 0.74), transparent 28%),
      linear-gradient(145deg, rgba(255, 253, 248, 0.96), rgba(246, 235, 219, 0.82));
    box-shadow:
      0 14px 32px rgba(72, 46, 25, 0.065),
      inset 0 1px 0 rgba(255, 255, 255, 0.82);
    transition: transform 420ms var(--ease-out-soft), box-shadow 420ms var(--ease-out-soft);
  }

  .reel-card-glow {
    position: absolute;
    right: -38px;
    top: -48px;
    width: 138px;
    height: 168px;
    border-radius: 999px;
    background: rgba(168, 135, 83, 0.1);
    transform: rotate(-24deg);
    transition: transform 650ms var(--ease-out-soft);
  }

  .reel-ig-icon {
    position: relative;
    z-index: 1;
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: rgba(92, 64, 41, 0.78);
    border: 0.5px solid rgba(168, 135, 83, 0.2);
    border-radius: 15px;
    background: rgba(255, 250, 241, 0.72);
    backdrop-filter: blur(10px);
  }

  .reel-line {
    position: absolute;
    left: 1rem;
    top: 72px;
    width: 42%;
    height: 1px;
    opacity: 0.5;
    background: linear-gradient(90deg, rgba(168, 135, 83, 0.34), transparent);
    box-shadow: 0 19px 0 rgba(168, 135, 83, 0.12);
  }

  .reel-title,
  .reel-note,
  .reel-arrow {
    position: absolute;
    z-index: 1;
  }

  .reel-title {
    left: 1rem;
    right: 3.5rem;
    bottom: 2.65rem;
    color: var(--color-charcoal);
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 4vw, 1.45rem);
    font-style: italic;
    font-weight: 350;
    line-height: 1.1;
  }

  .reel-note {
    left: 1rem;
    bottom: 1rem;
    color: rgba(107, 86, 69, 0.76);
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .reel-arrow {
    right: 1rem;
    bottom: 1rem;
    color: var(--color-gold);
    transition: transform 320ms var(--ease-out-soft);
  }

  .reel-card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 18px 42px rgba(72, 46, 25, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.88);
  }

  .reel-card:hover .reel-card-glow {
    transform: rotate(-16deg) translate(-8px, 8px);
  }

  .reel-card:hover .reel-arrow {
    transform: translate(3px, -3px);
  }

  .cat-cta {
    position: relative;
    overflow: hidden;
    margin-top: -1px;
    padding-block: clamp(4rem, 8vw, 6.6rem);
    background:
      radial-gradient(ellipse at 50% 0%, rgba(255, 255, 255, 0.7), transparent 34%),
      linear-gradient(180deg, #fff8ee 0%, #fbf1e1 56%, #f6e3cc 100%);
  }

  .cat-cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
  }

  .cat-cta h2 {
    font-family: var(--font-serif);
    font-size: clamp(2.1rem, 5vw, 3.8rem);
    font-weight: 300;
    color: var(--color-text-primary);
    line-height: 0.98;
    margin: 0;
  }

  .cat-cta p { font-size: 1rem; color: var(--color-text-secondary); line-height: 1.7; max-width: 50ch; margin: 0; }

  .cta-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; margin-top: 0.5rem; }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    min-height: 48px;
    padding: 0.72rem 1.2rem;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 999px;
    transition: transform 280ms var(--ease-out-soft), border-color 280ms var(--ease-out-soft), background 280ms var(--ease-out-soft), color 280ms var(--ease-out-soft);
  }

  .cta-primary {
    color: #fff7ec;
    border: 0.5px solid rgba(255, 234, 199, 0.32);
    background: linear-gradient(145deg, rgba(92, 64, 41, 0.96), rgba(122, 92, 58, 0.94));
    box-shadow: 0 16px 32px rgba(72, 46, 25, 0.14);
  }

  .cta-primary:hover {
    transform: translateY(-2px);
    background: linear-gradient(145deg, rgba(105, 73, 46, 0.98), rgba(137, 103, 65, 0.95));
  }

  .cta-secondary {
    background-color: rgba(255, 250, 241, 0.58);
    color: var(--color-text-primary);
    border: 0.5px solid rgba(168, 135, 83, 0.24);
  }

  .cta-secondary:hover {
    transform: translateY(-2px);
    border-color: rgba(168, 135, 83, 0.48);
    color: var(--color-accent);
  }

  @media (min-width: 820px) {
    .reels-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1120px) {
    .reels-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.1rem;
    }

    .reel-card {
      min-height: 200px;
    }
  }

  @media (max-width: 720px) {
    .cat-hero {
      padding-block: 3rem 4.8rem;
    }

    .cat-hero-inner {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }

    .cat-hero-panel {
      min-height: 210px;
      border-radius: 26px;
    }

    .panel-word {
      font-size: clamp(2rem, 12vw, 3.6rem);
    }

    .panel-meta {
      flex-wrap: wrap;
    }

    .reels-grid {
      gap: 0.72rem;
    }

    .reel-card {
      min-height: 170px;
      border-radius: 20px;
      padding: 0.85rem;
    }

    .reel-ig-icon {
      width: 38px;
      height: 38px;
      border-radius: 13px;
    }

    .reel-line {
      left: 0.85rem;
      top: 65px;
    }

    .reel-title {
      left: 0.85rem;
      right: 2.8rem;
      bottom: 2.45rem;
      font-size: clamp(1rem, 4.8vw, 1.2rem);
    }

    .reel-note {
      left: 0.85rem;
      bottom: 0.85rem;
      font-size: 9px;
      letter-spacing: 0.1em;
    }

    .reel-arrow {
      right: 0.85rem;
      bottom: 0.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reel-card,
    .reel-card-glow,
    .reel-arrow,
    .cta-btn {
      transition: none;
    }
  }
</style>

<script>
  function initReelCarousel() {
    const carousel = document.getElementById('reel-carousel');
    if (!carousel) return;
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.reel-slide'));
    const videos = slides.map(s => s.querySelector<HTMLVideoElement>('video')!);
    const links  = slides.map(s => s.querySelector<HTMLAnchorElement>('.reel-video-link')!);
    let current = 0, timer: ReturnType<typeof setInterval> | null = null;
    const DURATION = slides.length === 3 ? 7000 : 5000;

    function activate(idx: number) {
      slides[current].classList.remove('is-active'); links[current].tabIndex = -1; videos[current]?.pause();
      current = idx;
      const startTime = parseInt(slides[current].dataset.start || '0');
      slides[current].classList.add('is-active'); links[current].tabIndex = 0;
      const v = videos[current];
      if (v) { v.currentTime = startTime; v.muted = true; v.play().catch(() => {}); }
    }
    function startTimer() {
      if (timer) clearTimeout(timer);
      const dur = parseInt(slides[current].dataset.duration || String(DURATION));
      timer = setTimeout(() => { activate((current + 1) % slides.length); startTimer(); }, dur);
    }
    const first = videos[0];
    if (first) { first.currentTime = parseInt(slides[0].dataset.start || '0'); first.muted = true; first.play().catch(() => {}); }
    videos.slice(1).forEach(v => { if (v) v.preload = 'metadata'; });
    let touchStartX = 0;
    carousel.addEventListener('touchstart', (e: TouchEvent) => { touchStartX = e.touches[0].clientX; }, { passive: true });
    carousel.addEventListener('touchend', (e: TouchEvent) => {
      const diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) { activate(diff > 0 ? (current+1)%slides.length : (current-1+slides.length)%slides.length); if (slides.length > 1) startTimer(); }
    }, { passive: true });
    if (slides.length > 1) startTimer();
    document.addEventListener('astro:before-swap', () => { if (timer) clearTimeout(timer); }, { once: true });
  }
  document.addEventListener('astro:page-load', initReelCarousel);
</script>
