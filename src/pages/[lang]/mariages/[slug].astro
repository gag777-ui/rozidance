---
import Layout from '../../../layouts/Layout.astro';
import { getTranslations } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/utils';
import CtaFloat from '../../../components/ui/CtaFloat.astro';

export async function getStaticPaths() {
  const fr = (await import('../../../i18n/fr.json')).default;
  const langs = ['en', 'nl', 'ru', 'de', 'es', 'it'];
  return langs.flatMap(lang =>
    fr.mariages.categories.map(cat => ({
      params: { lang, slug: cat.slug },
      props: { slug: cat.slug },
    }))
  );
}

const { slug } = Astro.props;
const lang = (Astro.currentLocale ?? Astro.params.lang ?? 'fr') as Lang;
const t = getTranslations(lang);
const s = t.mariagesSlug;

const cat = t.mariages.categories.find(c => c.slug === slug)!;
// Reels are language-agnostic — always read from fr.json
const fr = (await import('../../../i18n/fr.json')).default;
const frCat = fr.mariages.categories.find((c: any) => c.slug === slug)!;
const reelsSrc = (frCat as any).reels as (string | null)[] | undefined;
const reels: string[] = Array.from({ length: cat.count }, (_, i) =>
  reelsSrc?.[i] ?? '#'
);

/* ── Carousels (même logique que /mariages/[slug].astro) ── */
const isDanse      = slug === 'danse-de-mariage';
const isMariee     = slug === 'chant-de-la-mariee';
const isDanseMariee = slug === 'danse-de-la-mariee';
const isMusicians  = slug === 'musiciens';

const danseVideos = [
  { src: '/videos/mariages/danse-1.mp4', href: 'https://www.instagram.com/reel/DO8kuahirNR/', start: 4  },
  { src: '/videos/mariages/danse-2.mp4', href: 'https://www.instagram.com/reel/DXPkBfZjDfG/', start: 13 },
  { src: '/videos/mariages/danse-3.mp4', href: 'https://www.instagram.com/reel/DY6ymdMsrb6/', start: 8  },
  { src: '/videos/mariages/danse-4.mp4', href: 'https://www.instagram.com/reel/DKxHqISI1Wp/', start: 9  },
];
const marieeVideos = [
  { src: '/videos/mariee/mariee-1.mp4', href: 'https://www.instagram.com/reel/DYSGbsVtK7S/', start: 4 },
  { src: '/videos/mariee/mariee-2.mp4', href: 'https://www.instagram.com/reel/DYCpnNTiIAA/', start: 8 },
  { src: '/videos/mariee/mariee-3.mp4', href: 'https://www.instagram.com/reel/DCzj6L4IQAA/', start: 5 },
];
const danseMarieeVideos = [
  { src: '/videos/danse-mariee/danse-mariee-3.mp4', href: 'https://www.instagram.com/reel/DR1unSWDMTp/', start: 12, duration: 12000 },
];
const musiciensVideos = [
  { src: '/videos/musiciens/musiciens-1.mp4', href: 'https://www.instagram.com/reel/DO8wo3NjEY0/', start: 22 },
  { src: '/videos/musiciens/musiciens-2.mp4', href: 'https://www.instagram.com/reel/DAtffBloITF/', start: 2  },
  { src: '/videos/musiciens/musiciens-3.mp4', href: 'https://www.instagram.com/reel/DPl-zEijMzZ/', start: 15 },
];

/* ── Posters pour mobile carousels ── */
const dansePosters = danseVideos.map(v => `/images/video-posters/${v.src.split('/').pop()?.replace('.mp4', '.png')}`);
const marieePosters = marieeVideos.map(v => `/images/video-posters/${v.src.split('/').pop()?.replace('.mp4', '.png')}`);
const danseMarieePosters = danseMarieeVideos.map(v => `/images/video-posters/${v.src.split('/').pop()?.replace('.mp4', '.png')}`);
const musiciensPosters = musiciensVideos.map(v => `/images/video-posters/${v.src.split('/').pop()?.replace('.mp4', '.png')}`);
---

<Layout title={`${cat.title} — Rozi Dance`} description={cat.description}>
  <!-- Hero -->
  <section class="cat-hero">
    <div class="section-container cat-hero-inner">
      <div class="cat-hero-copy">
        <a href={`/${lang}/mariages`} class="back-link">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M12 7H2M6 3l-4 4 4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {s.backLink}
        </a>
        <span class="eyebrow">{s.eyebrow}</span>
        <h1>{cat.title}</h1>
        <p class="hero-subtitle">{cat.description}</p>
      </div>
      {isMusicians ? (
        <div class="reel-carousel" id="reel-carousel">
          {musiciensVideos.map((v, i) => (
            <div class={`reel-slide${i === 0 ? ' is-active' : ''}`} data-start={v.start}>
              <a href={v.href} target="_blank" rel="noopener noreferrer" class="reel-video-link" tabindex={i === 0 ? 0 : -1}>
                <video class="reel-video" muted loop playsinline disablepictureinpicture preload={i === 0 ? 'auto' : 'none'}>
                  <source src={v.src} type="video/mp4" />
                </video>
                <div class="reel-hover-cta" aria-hidden="true">Voir sur Instagram</div>
              </a>
            </div>
          ))}
        </div>
        <div class="video-carousel-wrapper" id="video-carousel-mobile">
          <div class="video-carousel">
            {musiciensVideos.map((v, i) => (
              <div class="video-card" data-index={i} data-start={v.start} data-src={v.src}>
                <a href={v.href} target="_blank" rel="noopener noreferrer" class="video-card-link">
                  <video class="video-card-video" muted loop playsinline disablepictureinpicture preload="metadata" poster={musiciensPosters[i]}>
                    <source src={v.src} type="video/mp4" />
                  </video>
                  <div class="video-card-hover" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                    </svg>
                    Voir sur Instagram
                  </div>
                </a>
              </div>
            ))}
          </div>
        </div>
      ) : isDanseMariee ? (
        <div class="reel-carousel" id="reel-carousel">
          {danseMarieeVideos.map((v, i) => (
            <div class={`reel-slide${i === 0 ? ' is-active' : ''}`} data-start={v.start} data-duration={(v as any).duration}>
              <a href={v.href} target="_blank" rel="noopener noreferrer" class="reel-video-link" tabindex={i === 0 ? 0 : -1}>
                <video class="reel-video" muted loop playsinline disablepictureinpicture preload="none">
                  <source src={v.src} type="video/mp4" />
                </video>
                <div class="reel-hover-cta" aria-hidden="true">Voir sur Instagram</div>
              </a>
            </div>
          ))}
        </div>
        <div class="video-carousel-wrapper" id="video-carousel-mobile">
          <div class="video-carousel">
            {danseMarieeVideos.map((v, i) => (
              <div class="video-card" data-index={i} data-start={v.start} data-src={v.src} data-duration={v.duration}>
                <a href={v.href} target="_blank" rel="noopener noreferrer" class="video-card-link">
                  <video class="video-card-video" muted loop playsinline disablepictureinpicture preload="metadata" poster={danseMarieePosters[i]}>
                    <source src={v.src} type="video/mp4" />
                  </video>
                  <div class="video-card-hover" aria-hidden="true"></div>
                </a>
              </div>
            ))}
          </div>
        </div>
      ) : isMariee ? (
        <div class="reel-carousel" id="reel-carousel">
          {marieeVideos.map((v, i) => (
            <div class={`reel-slide${i === 0 ? ' is-active' : ''}`} data-start={v.start}>
              <a href={v.href} target="_blank" rel="noopener noreferrer" class="reel-video-link" tabindex={i === 0 ? 0 : -1}>
                <video class="reel-video" muted loop playsinline disablepictureinpicture preload={i === 0 ? 'auto' : 'none'}>
                  <source src={v.src} type="video/mp4" />
                </video>
                <div class="reel-hover-cta" aria-hidden="true">Voir sur Instagram</div>
              </a>
            </div>
          ))}
        </div>
        <div class="video-carousel-wrapper" id="video-carousel-mobile">
          <div class="video-carousel">
            {marieeVideos.map((v, i) => (
              <div class="video-card" data-index={i} data-start={v.start} data-src={v.src}>
                <a href={v.href} target="_blank" rel="noopener noreferrer" class="video-card-link">
                  <video class="video-card-video" muted loop playsinline disablepictureinpicture preload="metadata" poster={marieePosters[i]}>
                    <source src={v.src} type="video/mp4" />
                  </video>
                  <div class="video-card-hover" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg></div>
                </a>
              </div>
            ))}
          </div>
        </div>
      ) : isDanse ? (
        <div class="reel-carousel" id="reel-carousel">
          {danseVideos.map((v, i) => (
            <div class={`reel-slide${i === 0 ? ' is-active' : ''}`} data-start={v.start}>
              <a href={v.href} target="_blank" rel="noopener noreferrer" class="reel-video-link" tabindex={i === 0 ? 0 : -1}>
                <video class="reel-video" muted loop playsinline disablepictureinpicture preload={i === 0 ? 'auto' : 'none'}>
                  <source src={v.src} type="video/mp4" />
                </video>
                <div class="reel-hover-cta" aria-hidden="true">Voir sur Instagram</div>
              </a>
            </div>
          ))}
        </div>
        <div class="video-carousel-wrapper" id="video-carousel-mobile">
          <div class="video-carousel">
            {danseVideos.map((v, i) => (
              <div class="video-card" data-index={i} data-start={v.start} data-src={v.src}>
                <a href={v.href} target="_blank" rel="noopener noreferrer" class="video-card-link">
                  <video class="video-card-video" muted loop playsinline disablepictureinpicture preload="metadata" poster={dansePosters[i]}>
                    <source src={v.src} type="video/mp4" />
                  </video>
                  <div class="video-card-hover" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg></div>
                </a>
              </div>
            ))}
          </div>
        </div>
      ) : (
        <div class="cat-hero-panel" aria-hidden="true">
          <span class="panel-line"></span>
          <span class="panel-arc"></span>
          <span class="panel-word">{cat.title}</span>
          <div class="panel-meta">
            <span>{cat.count} {s.videoLabel}s</span>
            <span>Instagram</span>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Reels grid -->
  <section class="reels-section" aria-labelledby="moments-title">
    <div class="section-container">
      <div class="reels-heading reveal-fade">
        <span class="eyebrow">{t.nav.reelLabel}</span>
        <h2 id="moments-title">{s.momentsTitle}</h2>
        <p>{s.momentsText}</p>
      </div>
      <div class="reels-grid">
        {reels.map((href, i) => (
          <a
            href={href}
            class="reel-card reveal"
            style={`transition-delay: ${i * 50}ms`}
            aria-label={`${cat.title} — ${s.videoLabel} ${i + 1}`}
            target={href !== '#' ? '_blank' : undefined}
            rel={href !== '#' ? 'noopener noreferrer' : undefined}
          >
            <span class="reel-card-glow" aria-hidden="true"></span>
            <span class="reel-ig-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.35"/>
                <circle cx="12" cy="12" r="3.35" stroke="currentColor" stroke-width="1.35"/>
                <circle cx="17" cy="7" r="1.1" fill="currentColor"/>
              </svg>
            </span>
            <span class="reel-line" aria-hidden="true"></span>
            <span class="reel-title">{t.nav.reelLabel}</span>
            <span class="reel-note">Instagram</span>
            <span class="reel-arrow" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M4 12 12 4M12 4H5M12 4v7" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cat-cta">
    <div class="section-container cat-cta-inner reveal-fade">
      <span class="eyebrow">{s.ctaEyebrow}</span>
      <h2>{s.ctaTitle}</h2>
      <p>{s.ctaText}</p>
      <div class="cta-actions">
        <a href={`/${lang}#contact`} class="cta-btn cta-primary">
          {s.ctaBtn}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href={`/${lang}/mariages`} class="cta-btn cta-secondary">
          {s.ctaBtnSecondary}
        </a>
      </div>
    </div>
  </section>
  <CtaFloat href="tel:+32486219896" label={t.hero.ctaPrimary} />
</Layout>

<style>
  .cat-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.8rem, 8vw, 7rem) clamp(5rem, 10vw, 8rem);
    background:
      radial-gradient(ellipse at 12% 18%, rgba(255, 255, 255, 0.72), transparent 38%),
      radial-gradient(ellipse at 88% 20%, rgba(168, 135, 83, 0.12), transparent 36%),
      linear-gradient(180deg, #fffaf3 0%, #fff3e6 58%, #faead6 100%);
  }

  .cat-hero::before,
  .cat-hero::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .cat-hero::before {
    left: -120px;
    top: 18%;
    width: min(480px, 58vw);
    height: min(480px, 58vw);
    border: 0.5px solid rgba(168, 135, 83, 0.12);
    border-radius: 999px;
  }

  .cat-hero::after {
    inset-inline: 0;
    bottom: -1px;
    height: clamp(5rem, 12vw, 9rem);
    background: linear-gradient(180deg, rgba(246, 225, 200, 0), #faead6 52%, #fff7ec 100%);
  }

  .cat-hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 1fr);
    align-items: stretch;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .cat-hero-copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.48rem;
    width: fit-content;
    min-height: 40px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    text-decoration: none;
    margin-bottom: 0.5rem;
    transition: color 220ms var(--ease-out-soft), gap 220ms var(--ease-out-soft);
  }

  .back-link:hover { color: var(--color-accent); gap: 0.6rem; }

  .cat-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.7rem, 7vw, 6rem);
    font-weight: 300;
    color: var(--color-text-primary);
    line-height: 0.96;
    max-width: 10ch;
    margin: 0;
  }

  .hero-subtitle {
    font-size: clamp(0.9375rem, 1.5vw, 1.0625rem);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 56ch;
    margin: 0;
  }

  .cat-hero-panel {
    position: relative;
    min-height: clamp(250px, 36vw, 430px);
    border: 0.5px solid rgba(168, 135, 83, 0.18);
    border-radius: 34px;
    background:
      radial-gradient(circle at 26% 24%, rgba(255, 255, 255, 0.75), transparent 32%),
      radial-gradient(circle at 74% 78%, rgba(168, 135, 83, 0.12), transparent 36%),
      linear-gradient(145deg, rgba(255, 253, 248, 0.84), rgba(242, 224, 201, 0.58));
    box-shadow:
      0 22px 56px rgba(72, 46, 25, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.72);
    overflow: hidden;
  }

  .panel-line,
  .panel-arc,
  .panel-word {
    position: absolute;
    pointer-events: none;
  }

  .panel-line {
    left: 10%;
    top: 22%;
    width: 54%;
    height: 1px;
    background: linear-gradient(90deg, rgba(168, 135, 83, 0.42), transparent);
    box-shadow:
      0 42px 0 rgba(168, 135, 83, 0.16),
      0 84px 0 rgba(168, 135, 83, 0.1);
  }

  .panel-arc {
    right: -24%;
    top: 12%;
    width: 78%;
    aspect-ratio: 1;
    border: 0.5px solid rgba(168, 135, 83, 0.22);
    border-radius: 999px;
  }

  .panel-word {
    left: 10%;
    right: 10%;
    bottom: 27%;
    color: rgba(43, 31, 21, 0.12);
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 4.6vw, 4.6rem);
    font-style: italic;
    font-weight: 300;
    line-height: 0.95;
  }

  .panel-meta {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .panel-meta span {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0.45rem 0.72rem;
    color: rgba(75, 53, 36, 0.72);
    border: 0.5px solid rgba(168, 135, 83, 0.18);
    border-radius: 999px;
    background: rgba(255, 251, 244, 0.58);
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
  }

  .reels-section {
    position: relative;
    overflow: hidden;
    margin-top: -1px;
    padding-block: clamp(3.6rem, 8vw, 6.6rem) clamp(5.5rem, 10vw, 8rem);
    background:
      radial-gradient(ellipse at 18% 18%, rgba(168, 135, 83, 0.08), transparent 34%),
      radial-gradient(ellipse at 88% 82%, rgba(135, 144, 115, 0.07), transparent 36%),
      linear-gradient(180deg, #fff7ec 0%, #fffaf4 48%, #faecd9 100%);
  }

  .reels-section::after {
    content: '';
    position: absolute;
    inset-inline: 0;
