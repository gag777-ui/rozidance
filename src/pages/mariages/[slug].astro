---
import RefonteMariageDetail from '../refonte/mariages/[slug].astro';
import { mariagePages } from '../../data/refonte';

export function getStaticPaths() {
  return mariagePages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
---

<RefonteMariageDetail page={page} lang="fr" />
