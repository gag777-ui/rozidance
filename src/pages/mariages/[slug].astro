---
import Layout from '../../layouts/Layout.astro';
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';

export async function getStaticPaths() {
  const fr = (await import('../../i18n/fr.json')).default;
  return fr.mariages.categories.map(cat => ({
    params: { slug: cat.slug },
    props: { slug: cat.slug },
  }));
}

const { slug } = Astro.props;
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = getTranslations(lang);
const s = t.mariagesSlug;
const base = lang === 'fr' ? '' : `/${lang}`;

const cat = t.mariages.categories.find(c => c.slug === slug)!;
const reelsSrc = (cat as any).reels as (string | null)[] | undefined;
const reels: string[] = Array.from({ length: cat.count }, (_, i) =>
  reelsSrc?.[i] ?? '#'
);

/* ── Carousel vidéo — danse-de-mariage (4 vidéos, 5s) ── */
const isDanse = slug === 'danse-de-mariage';
const danseVideos = [
  { src: '/videos/mariages/danse-1.mp4', href: 'https://www.instagram.com/reel/DO8kuahirNR/', start: 4  },
  { src: '/videos/mariages/danse-2.mp4', href: 'https://www.instagram.com/reel/DXPkBfZjDfG/', start: 13 },
  { src: '/videos/mariages/danse-3.mp4', href: 'https://www.instagram.com/reel/DY6ymdMsrb6/', start: 8  },
  { src: '/videos/mariages/danse-4.mp4', href: 'https://www.instagram.com/reel/DKxHqISI1Wp/', start: 9  },
];

/* ── Carousel vidéo — chant-de-la-mariee (3 vidéos, 7s) ── */
const isMariee = slug === 'chant-de-la-mariee';
const marieeVideos = [
  { src: '/videos/mariee/mariee-1.mp4', href: 'https://www.instagram.com/reel/DYSGbsVtK7S/', start: 4 },
  { src: '/videos/mariee/mariee-2.mp4', href: 'https://www.instagram.com/reel/DYCpnNTiIAA/', start: 8 },
  { src: '/videos/mariee/mariee-3.mp4', href: 'https://www.instagram.com/reel/DCzj6L4IQAA/', start: 5 },
];

/* ── Vidéo — danse-de-la-mariee (1 vidéo en boucle) ── */
const isDanseMariee = slug === 'danse-de-la-mariee';

/* ── Carousel vidéo — musiciens (3 vidéos, 7s) ── */
const isMusicians = slug === 'musiciens';
const musiciensVideos = [
  { src: '/videos/musiciens/musiciens-1.mp4', href: 'https://www.instagram.com/reel/DO8wo3NjEY0/', start: 22 },
  { src: '/videos/musiciens/musiciens-2.mp4', href: 'https://www.instagram.com/reel/DAtffBloITF/', start: 2  },
  { src: '/videos/musiciens/musiciens-3.mp4', href: 'https://www.instagram.com/reel/DPl-zEijMzZ/', start: 15 },
];
const danseMarieeVideos = [
  { src: '/videos/danse-mariee/danse-mariee-3.mp4', href: 'https://www.instagram.com/reel/DR1unSWDMTp/', start: 12, duration: 12000 },
];
---

<Layout title={`${cat.title} — Rozi Dance`} description={cat.description}>
  <!-- Hero -->
  <section class="cat-hero">
    <div class="section-container cat-hero-inner">
      <div class="cat-hero-copy">
        <a href={`${base}/mariages`} class="back-link">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M12 7H2M6 3l-4 4 4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {s.backLink}
        </a>
        <span class="eyebrow">{s.eyebrow}</span>
        <h1>{cat.title}</h1>
        <p class="hero-subtitle">{cat.description}</p>
      </div>
      {isMusicians ? (
        /* ── Carousel vidéo musiciens (3 vidéos, 7s) ── */
        <div class="reel-carousel" id="reel-carousel" aria-label="Aperçu vidéos nos musiciens">
          {musiciensVideos.map((v, i) => (
            <div class={`reel-slide${i === 0 ? ' is-active' : ''}`} data-index={i} data-start={v.start}>
              <a href={v.href} target="_blank" rel="noopener noreferrer" class="reel-video-link"
                aria-label={`Voir le reel ${i + 1} sur Instagram`} tabindex={i === 0 ? 0 : -1}>
                <video class="reel-video" muted loop playsinline disablepictureinpicture preload={i === 0 ? 'auto' : 'none'}>
                  <source src={v.src} type="video/mp4" />
                </video>
