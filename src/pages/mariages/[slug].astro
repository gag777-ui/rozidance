          {danseMarieeVideos.map((v, i) => (
            <div class={`reel-slide${i === 0 ? ' is-active' : ''}`} data-index={i} data-start={v.start} data-duration={v.duration}>
              <a href={v.href} target="_blank" rel="noopener noreferrer" class="reel-video-link"
