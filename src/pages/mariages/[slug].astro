                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                  </svg>
                  Voir sur Instagram
                </div>
              </a>
            </div>
          ))}
        </div>
      ) : isMariee ? (
        /* ── Carousel vidéo chant de la mariée (3 vidéos, 7s) ── */
        <div class="reel-carousel" id="reel-carousel" aria-label="Aperçu vidéos danse de la mariée">
          {marieeVideos.map((v, i) => (
            <div class={`reel-slide${i === 0 ? ' is-active' : ''}`} data-index={i} data-start={v.start}>
              <a href={v.href} target="_blank" rel="noopener noreferrer" class="reel-video-link"
                aria-label={`Voir le reel ${i + 1} sur Instagram`} tabindex={i === 0 ? 0 : -1}>
                <video class="reel-video" muted loop playsinline disablepictureinpicture preload={i === 0 ? 'auto' : 'none'}>
                  <source src={v.src} type="video/mp4" />
                </video>
                <div class="reel-hover-cta" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                  </svg>
                  Voir sur Instagram
                </div>
              </a>
            </div>
          ))}
        </div>
      ) : isDanse ? (
        /* ── Carousel vidéo danse de mariage (4 vidéos, 5s) ── */
        <div class="reel-carousel" id="reel-carousel" aria-label="Aperçu vidéos danse de mariage">
          {danseVideos.map((v, i) => (
            <div class={`reel-slide${i === 0 ? ' is-active' : ''}`} data-index={i} data-start={v.start}>
              <a
                href={v.href}
                target="_blank"
                rel="noopener noreferrer"
                class="reel-video-link"
                aria-label={`Voir le reel ${i + 1} sur Instagram`}
                tabindex={i === 0 ? 0 : -1}
              >
                <video
                  class="reel-video"
                  muted
                  loop
                  playsinline
                  disablepictureinpicture
                  preload={i === 0 ? 'auto' : 'none'}
                >
                  <source src={v.src} type="video/mp4" />
                </video>
                <div class="reel-hover-cta" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                  </svg>
                  Voir sur Instagram
                </div>
              </a>
            </div>
          ))}

          <!-- Dots navigation -->
        </div>
      ) : (
        <div class="cat-hero-panel" aria-hidden="true">
          <span class="panel-line"></span>
          <span class="panel-arc"></span>
          <span class="panel-word">{cat.title}</span>
          <div class="panel-meta">
            <span>{cat.count} {s.videoLabel}s</span>
            <span>Instagram</span>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Reels grid -->
  <section class="reels-section" aria-labelledby="moments-title">
    <div class="section-container">
      <div class="reels-heading reveal-fade">
        <span class="eyebrow">{t.nav.reelLabel}</span>
        <h2 id="moments-title">{s.momentsTitle}</h2>
        <p>{s.momentsText}</p>
      </div>
      <div class="reels-grid">
        {reels.map((href, i) => (
          <a
            href={href}
            class="reel-card reveal"
            style={`transition-delay: ${i * 50}ms`}
            aria-label={`${cat.title} — voir le reel Instagram ${i + 1}`}
            target={href !== '#' ? '_blank' : undefined}
            rel={href !== '#' ? 'noopener noreferrer' : undefined}
          >
            <span class="reel-card-glow" aria-hidden="true"></span>
            <span class="reel-ig-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.35"/>
                <circle cx="12" cy="12" r="3.35" stroke="currentColor" stroke-width="1.35"/>
                <circle cx="17" cy="7" r="1.1" fill="currentColor"/>
              </svg>
            </span>
            <span class="reel-line" aria-hidden="true"></span>
            <span class="reel-title">{t.nav.reelLabel}</span>
            <span class="reel-note">Instagram</span>
            <span class="reel-arrow" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M4 12 12 4M12 4H5M12 4v7" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cat-cta">
    <div class="section-container cat-cta-inner reveal-fade">
      <span class="eyebrow">{s.ctaEyebrow}</span>
      <h2>{s.ctaTitle}</h2>
      <p>{s.ctaText}</p>
      <div class="cta-actions">
        <a href={`${base || '/'}#contact`} class="cta-btn cta-primary">
          {s.ctaBtn}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href={`${base}/mariages`} class="cta-btn cta-secondary">
          {s.ctaBtnSecondary}
        </a>
      </div>
    </div>
  </section>
<script>
  function initReelCarousel() {
    const carousel = document.getElementById('reel-carousel');
    if (!carousel) return;

    const slides  = Array.from(carousel.querySelectorAll<HTMLElement>('.reel-slide'));
    const videos  = slides.map(s => s.querySelector<HTMLVideoElement>('video')!);
    const links   = slides.map(s => s.querySelector<HTMLAnchorElement>('.reel-video-link')!);

    let current = 0;
    let timer:   ReturnType<typeof setInterval> | null = null;
    const DURATION = slides.length === 3 ? 7000 : 5000;

    function activate(idx: number) {
      slides[current].classList.remove('is-active');
      links[current].tabIndex = -1;
      videos[current]?.pause();

      current = idx;
      const slide = slides[current];
      const startTime = parseInt(slide.dataset.start || '0');

      slide.classList.add('is-active');
      links[current].tabIndex = 0;

      const v = videos[current];
      if (v) {
        v.currentTime = startTime;
        v.muted = true;
        v.play().catch(() => {});
      }
    }

    function next() {
      activate((current + 1) % slides.length);
    }

    function startTimer() {
      if (timer) clearInterval(timer);
      /* Durée de la slide active (data-duration) ou DURATION par défaut */
      const slideDuration = parseInt(slides[current].dataset.duration || String(DURATION));
      timer = setTimeout(() => { next(); startTimer(); }, slideDuration);
    }

    /* Lancer la première vidéo avec son start time */
    const firstVideo = videos[0];
    if (firstVideo) {
      const firstStartTime = parseInt(slides[0].dataset.start || '0');
      firstVideo.currentTime = firstStartTime;
      firstVideo.muted = true;
      firstVideo.play().catch(() => {});
    }

    /* Précharger les autres au chargement de la page */
    videos.slice(1).forEach(v => { if (v) v.preload = 'metadata'; });

    /* Swipe gauche/droite pour changer de slide */
    let touchStartX = 0;
    carousel.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.touches[0].clientX;
    }, { passive: true });
    carousel.addEventListener('touchend', (e: TouchEvent) => {
      const diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) {
        activate(diff > 0
          ? (current + 1) % slides.length
          : (current - 1 + slides.length) % slides.length
        );
        if (slides.length > 1) startTimer();
      }
    }, { passive: true });

    /* Si 1 seule vidéo : boucle naturelle, pas de timer */
    if (slides.length > 1) startTimer();

    document.addEventListener('astro:before-swap', () => {
      if (timer) clearTimeout(timer);
    }, { once: true });
  }

  document.addEventListener('astro:page-load', initReelCarousel);
</script>

</Layout>

<style>
  .cat-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.8rem, 8vw, 7rem) clamp(5rem, 10vw, 8rem);
    background:
      radial-gradient(ellipse at 12% 18%, rgba(255, 255, 255, 0.72), transparent 38%),
      radial-gradient(ellipse at 88% 20%, rgba(168, 135, 83, 0.12), transparent 36%),
      linear-gradient(180deg, #fffaf3 0%, #fbefdf 58%, #f6e1c8 100%);
  }

  .cat-hero::before,
  .cat-hero::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .cat-hero::before {
    left: -120px;
    top: 18%;
    width: min(480px, 58vw);
    height: min(480px, 58vw);
    border: 0.5px solid rgba(168, 135, 83, 0.12);
    border-radius: 999px;
  }

  .cat-hero::after {
    inset-inline: 0;
    bottom: -1px;
    height: clamp(5rem, 12vw, 9rem);
    background: linear-gradient(180deg, rgba(246, 225, 200, 0), #f6e1c8 52%, #fff7ec 100%);
  }

  .cat-hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 1fr);
    align-items: stretch; /* carousel remplit toute la hauteur */
    gap: clamp(2rem, 6vw, 6rem);
  }

  .cat-hero-copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.48rem;
    width: fit-content;
    min-height: 40px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    text-decoration: none;
    margin-bottom: 0.5rem;
    transition: color 220ms var(--ease-out-soft), gap 220ms var(--ease-out-soft);
  }

  .back-link:hover { color: var(--color-accent); gap: 0.6rem; }

  .cat-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.7rem, 7vw, 6rem);
    font-weight: 300;
    color: var(--color-text-primary);
    line-height: 0.96;
    max-width: 10ch;
    margin: 0;
  }

  .hero-subtitle {
    font-size: clamp(0.9375rem, 1.5vw, 1.0625rem);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 56ch;
    margin: 0;
  }

  .cat-hero-panel {
    position: relative;
    min-height: clamp(250px, 36vw, 430px);
    border: 0.5px solid rgba(168, 135, 83, 0.18);
    border-radius: 34px;
    background:
      radial-gradient(circle at 26% 24%, rgba(255, 255, 255, 0.75), transparent 32%),
      radial-gradient(circle at 74% 78%, rgba(168, 135, 83, 0.12), transparent 36%),
      linear-gradient(145deg, rgba(255, 253, 248, 0.84), rgba(242, 224, 201, 0.58));
    box-shadow:
      0 22px 56px rgba(72, 46, 25, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.72);
    overflow: hidden;
  }

  .panel-line,
  .panel-arc,
  .panel-word {
    position: absolute;
    pointer-events: none;
  }

  .panel-line {
    left: 10%;
    top: 22%;
    width: 54%;
    height: 1px;
    background: linear-gradient(90deg, rgba(168, 135, 83, 0.42), transparent);
    box-shadow:
      0 42px 0 rgba(168, 135, 83, 0.16),
