---
import RefonteCoursDetail from '../refonte/cours/[slug].astro';
import { coursPages } from '../../data/refonte';

export function getStaticPaths() {
  return coursPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
---

<RefonteCoursDetail page={page} lang="fr" />
