---
import Layout from '../layouts/Layout.astro';
import { getTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/utils';
import CtaFloat from '../components/ui/CtaFloat.astro';
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = getTranslations(lang);
const base = lang === 'fr' ? '' : `/${lang}`;

const faq = t.cours.faqItems;
const reels = (t.cours as any).reels as (string | null)[];
---

<Layout
  title={t.cours.pageTitle}
  description={t.cours.pageDescription}
>
  <!-- Page hero -->
  <section class="cours-hero" aria-labelledby="cours-title">
    <div class="section-container cours-hero-inner">
      <div class="cours-hero-text">
        <a href={`${base || '/'}#prestations`} class="back-link">
          <svg width="16" height="16" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M12 7H2M6 3l-4 4 4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {t.nav.prestations}
        </a>
        <span class="eyebrow">{t.cours.heroEyebrow}</span>
        <h1 id="cours-title">{t.cours.heroTitle}</h1>
        <p class="cours-hero-subtitle">{t.cours.heroSubtitle}</p>
      </div>
      <div class="cours-hero-img" aria-hidden="true">
        <img
          src="/images/cours-hero.webp"
          alt=""
          width="1536"
          height="1024"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- Reels grid -->
  {reels.length > 0 && (
    <section class="reels-section">
      <div class="section-container">
        <div class="reels-grid">
          {reels.map((href, i) => (
            <a
              href={href ?? '#'}
              class="reel-card reveal"
              style={`transition-delay: ${i * 50}ms`}
              aria-label={`Cours — voir le reel Instagram ${i + 1}`}
              target={href ? '_blank' : undefined}
              rel={href ? 'noopener noreferrer' : undefined}
            >
              <div class="reel-thumb">
                <img src="/images/reel-logo.webp" alt={`Cours ${i + 1}`} loading="lazy" width="300" height="533" />
                <div class="reel-overlay">
                  <svg class="reel-ig-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="2" y="2" width="20" height="20" rx="5" stroke="white" stroke-width="1.4"/>
                    <circle cx="12" cy="12" r="3.5" stroke="white" stroke-width="1.4"/>
                    <circle cx="17" cy="7" r="1.2" fill="white"/>
                  </svg>
                </div>
              </div>
              <p class="reel-label">Voir le reel
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M7 17L17 7M17 7H7M17 7v10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Section chant -->
  <section class="cours-section" aria-labelledby="chant-title">
    <div class="section-container cours-section-inner">
      <div class="cours-text reveal">
        <h2 id="chant-title">{t.cours.chantTitle}</h2>
        <p>{t.cours.chantDescription}</p>
        <ul class="cours-list">
          {t.cours.chantList.map((item: string) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="cours-deco reveal" aria-hidden="true">
        <div class="cours-deco-circle"></div>
      </div>
    </div>
  </section>

  <!-- Section danse -->
  <section class="cours-section cours-section-alt" aria-labelledby="danse-title">
    <div class="section-container cours-section-inner reverse">
      <div class="cours-deco reveal" aria-hidden="true">
        <div class="cours-deco-circle danse-circle"></div>
      </div>
      <div class="cours-text reveal">
        <h2 id="danse-title">{t.cours.danseTitle}</h2>
        <p>{t.cours.danseDescription}</p>
        <ul class="cours-list">
          {t.cours.danseList.map((item: string) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="cours-faq" aria-labelledby="faq-title">
    <div class="section-container">
      <div class="section-header reveal">
        <span class="eyebrow">{t.cours.faqEyebrow}</span>
        <h2 id="faq-title">{t.cours.faqTitle}</h2>
      </div>

      <div class="faq-list" id="faq-accordion">
        {faq.map((item, i) => (
          <details class="faq-item reveal" style={`transition-delay: ${i * 40}ms`}>
            <summary class="faq-question">
              {item.q}
              <span class="faq-chevron" aria-hidden="true">+</span>
            </summary>
            <p class="faq-answer">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cours-cta" aria-labelledby="cta-title">
    <div class="section-container">
      <div class="cta-inner reveal">
        <h2 id="cta-title">{t.cours.ctaTitle}</h2>
        <p>{t.cours.ctaSubtitle}</p>
        <a href="tel:+32486219896" class="btn-primary">{t.cours.ctaBtn}</a>
      </div>
    </div>
  </section>
  <CtaFloat href="tel:+32486219896" />
</Layout>

<style>
  /* Hero */
  .cours-hero {
    padding-block: 5rem 3.5rem;
    background-color: var(--color-bg-card);
    overflow: hidden;
  }

  .cours-hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 2rem;
  }

  .cours-hero-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cours-hero-img {
    position: relative;
  }

  .cours-hero-img img {
    width: 100%;
    height: auto;
    display: block;
    mask-image:
      linear-gradient(to right, transparent 0%, black 15%, black 90%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, black 5%, black 95%, transparent 100%);
    mask-composite: intersect;
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, black 15%, black 90%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, black 5%, black 95%, transparent 100%);
    -webkit-mask-composite: source-in;
  }

  @media (max-width: 768px) {
    .cours-hero-inner {
      grid-template-columns: 1fr;
    }

    .cours-hero-img {
      max-height: 220px;
      overflow: hidden;
    }

    .cours-hero-img img {
      object-fit: cover;
      object-position: center top;
      height: 220px;
      width: 100%;
    }
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    text-decoration: none;
    margin-bottom: 0.25rem;
    min-height: 44px;
    padding: 0.5rem 0;
    transition: color 220ms var(--ease-out-soft), gap 220ms var(--ease-out-soft);
    -webkit-tap-highlight-color: transparent;
  }
  .back-link:hover { color: var(--color-accent); gap: 0.75rem; }

  .cours-hero-inner h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--color-section-title);
    margin: 0;
  }

  .cours-hero-subtitle {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: 0;
  }

  /* Reels grid */
  .reels-section { padding-block: var(--spacing-section); }

  .reels-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 1rem;
  }
  @media (min-width: 640px) { .reels-grid { grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 1.25rem; } }
  @media (min-width: 1024px) { .reels-grid { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); } }

  .reel-card { display: block; text-decoration: none; }

  .reel-thumb {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-card);
    overflow: hidden;
    background-color: var(--color-bg-card);
    border: 0.5px solid var(--color-border);
  }

  .reel-thumb img { width: 92%; height: auto; object-fit: contain; display: block; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); transition: transform 500ms var(--ease-out-soft); }
  .reel-card:hover .reel-thumb img { transform: translate(-50%, -50%) scale(1.03); }

  .reel-overlay {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    background: rgba(0,0,0,0.22);
    opacity: 0;
    transition: opacity 300ms var(--ease-out-soft);
  }

  .reel-ig-icon { filter: drop-shadow(0 2px 8px rgba(0,0,0,0.5)); }
  .reel-card:hover .reel-overlay { opacity: 1; }

  .reel-label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    margin: 0.5rem 0 0;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    transition: color 250ms var(--ease-out-soft);
  }
  .reel-card:hover .reel-label { color: var(--color-accent); }

  /* Section chant / danse */
  .cours-section {
    padding-block: 5rem;
  }

  .cours-section-alt {
    background-color: var(--color-bg-card);
  }

  .cours-section-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .cours-section-inner.reverse {
    direction: rtl;
  }

  .cours-section-inner.reverse > * {
    direction: ltr;
  }

  .cours-text h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-text-primary);
    margin: 0 0 1.25rem;
  }

  .cours-text p {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.75;
    margin: 0 0 1.5rem;
  }

  .cours-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .cours-list li {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    padding-left: 1.25rem;
    position: relative;
  }

  .cours-list li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-size: 1.25rem;
    line-height: 1;
    top: 0.1em;
  }

  .cours-deco-circle {
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--color-gold) 0%, transparent 70%);
    opacity: 0.06;
    margin-inline: auto;
  }

  .danse-circle {
    background: radial-gradient(circle, var(--color-accent) 0%, transparent 70%);
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .section-header h2 {
    font-size: clamp(1.875rem, 3.5vw, 2.75rem);
    color: var(--color-section-title);
    margin: 0;
  }

  /* FAQ */
  .cours-faq {
    padding-block: 5rem;
    background-color: var(--color-bg-card);
  }

  .faq-list {
    max-width: 800px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .faq-item {
    border-bottom: 0.5px solid var(--color-border);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    color: var(--color-text-primary);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    font-size: 1.25rem;
    color: var(--color-accent);
    transition: transform 300ms var(--ease-out-soft);
    flex-shrink: 0;
    line-height: 1;
  }

  details[open] .faq-chevron {
    transform: rotate(45deg);
  }

  .faq-answer {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.75;
    margin: 0;
    padding-bottom: 1.25rem;
    padding-right: 2rem;
  }

  /* CTA */
  .cours-cta {
    padding-block: 5rem;
  }

  .cta-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .cta-inner h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-text-primary);
    margin: 0;
  }

  .cta-inner p {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 45ch;
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .cours-section-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .cours-section-inner.reverse {
      direction: ltr;
    }

    .cours-deco {
      display: none;
    }
  }
</style>
