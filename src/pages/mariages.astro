---
import Layout from '../layouts/Layout.astro';
import { getTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/utils';
import CtaFloat from '../components/ui/CtaFloat.astro';
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = getTranslations(lang);
const m = t.mariages;
const base = lang === 'fr' ? '' : `/${lang}`;
---

<Layout title={m.pageTitle} description={m.pageDescription}>
  <!-- Hero -->
  <section class="mariages-hero">
    <div class="section-container mariages-hero-inner">
      <div class="mariages-hero-text">
        <a href={`${base || '/'}#prestations`} class="back-link">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M12 7H2M6 3l-4 4 4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {t.nav.prestations}
        </a>
        <span class="eyebrow">{m.heroEyebrow}</span>
        <h1>{m.heroTitle}</h1>
        <p class="hero-subtitle">{m.heroSubtitle}</p>
        <div class="hero-service-strip" aria-label={m.reelsTitle}>
          {m.categories.map((cat) => (
            <span>{cat.title}</span>
          ))}
        </div>
        <a href="#reels-title" class="hero-jump">
          {m.reelsTitle}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M7 2v10M3 8l4 4 4-4" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
      <!-- Desktop: Carousel classique (original) -->
      <div class="services-carousel-desktop" id="services-carousel" aria-label="Aperçu de nos services">
        {[
          { src: '/videos/musiciens/musiciens-2.mp4',    href: 'https://www.instagram.com/reel/DAtffBloITF/', start: 2  },
          { src: '/videos/mariages/danse-3.mp4',         href: 'https://www.instagram.com/reel/DY6ymdMsrb6/', start: 8  },
          { src: '/videos/musiciens/musiciens-1.mp4',    href: 'https://www.instagram.com/reel/DO8wo3NjEY0/', start: 22 },
          { src: '/videos/mariee/mariee-2.mp4',          href: 'https://www.instagram.com/reel/DYCpnNTiIAA/', start: 8  },
          { src: '/videos/danse-mariee/danse-mariee-3.mp4', href: 'https://www.instagram.com/reel/DR1unSWDMTp/', start: 12 },
        ].map((v, i) => (
          <div class={`sc-slide${i === 0 ? ' is-active' : ''}`} data-start={v.start}>
            <a href={v.href} target="_blank" rel="noopener noreferrer" class="sc-link"
              aria-label={`Voir le reel ${i + 1} sur Instagram`} tabindex={i === 0 ? 0 : -1}>
              <video class="sc-video" muted loop playsinline disablepictureinpicture preload="none">
                <source src={v.src} type="video/mp4" />
              </video>
              <div class="sc-overlay" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                </svg>
                Voir sur Instagram
              </div>
            </a>
          </div>
        ))}
      </div>

      <!-- Mobile: Horizontal Scroll Carousel (3D cards) -->
      <div class="video-carousel-wrapper" id="video-carousel-mobile" aria-label="Aperçu de nos services">
        <div class="video-carousel" aria-label="Vidéos services">
          {[
            { src: '/videos/musiciens/musiciens-2.mp4',    poster: '/images/video-posters/musiciens-musiciens-2.png', href: 'https://www.instagram.com/reel/DAtffBloITF/', start: 2  },
            { src: '/videos/mariages/danse-3.mp4',         poster: '/images/video-posters/mariages-danse-3.png', href: 'https://www.instagram.com/reel/DY6ymdMsrb6/', start: 8  },
            { src: '/videos/musiciens/musiciens-1.mp4',    poster: '/images/video-posters/musiciens-musiciens-1.png', href: 'https://www.instagram.com/reel/DO8wo3NjEY0/', start: 22 },
            { src: '/videos/mariee/mariee-2.mp4',          poster: '/images/video-posters/mariee-mariee-2.png', href: 'https://www.instagram.com/reel/DYCpnNTiIAA/', start: 8  },
            { src: '/videos/danse-mariee/danse-mariee-3.mp4', poster: '/images/video-posters/danse-mariee-danse-mariee-3.png', href: 'https://www.instagram.com/reel/DR1unSWDMTp/', start: 12 },
          ].map((v, i) => (
            <div class="video-card" data-index={i} data-start={v.start} data-src={v.src}>
              <div class="card-inner">
                <video class="video-player" muted loop playsinline disablepictureinpicture preload="none" poster={v.poster}>
                  <source src={v.src} type="video/mp4" />
                </video>
                <button class="play-btn" aria-label={`Jouer vidéo ${i + 1}`}>
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="white">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </button>
                <a href={v.href} class="insta-link" target="_blank" rel="noopener noreferrer" aria-label={`Voir le reel ${i + 1}`}>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="white">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Reels selection -->
  <section class="categories-section" aria-labelledby="reels-title">
    <div class="section-container">
      <div class="reels-intro reveal-fade">
        <span class="eyebrow">{m.cardLink}</span>
        <h2 id="reels-title">{m.reelsTitle}</h2>
      </div>
      <div class="categories-grid">
        {m.categories.map((cat, i) => (
          <a
            href={`${base}/mariages/${cat.slug}`}
            class={`card-shell reel-shell cs-${i % 3} reveal`}
            style={`transition-delay: ${i * 90}ms`}
            aria-label={`${cat.title} — ${cat.description}`}
            data-card
          >
            <div class="card-core reel-card">
              <div class="card-light"></div>
              <span class="page-watermark" aria-hidden="true"></span>
              <span class="page-thread" aria-hidden="true"></span>
              <span class="page-mark" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                  <path d="M5.25 3.75h5.1l2.4 2.4v8.1h-7.5V3.75Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>
                  <path d="M10.25 3.9v2.45h2.35M7 9h4M7 11.25h3" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="reel-tag">{m.cardLink}</span>
              <span class="reel-title">{cat.title}</span>
              <span class="reel-cta">
                {m.cardCta}
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M3 8h9.5M9 4.5 12.5 8 9 11.5" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mariages-cta">
    <div class="section-container mariages-cta-inner reveal-fade">
      <span class="eyebrow">{m.ctaEyebrow}</span>
      <h2>{m.ctaTitle}</h2>
      <p>{m.ctaText}</p>
      <a href={`${base || '/'}#contact`} class="cta-btn">
        {m.ctaBtn}
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </section>
  <CtaFloat href="tel:+32486219896" />
</Layout>

<script>
  function initMariagesTilt() {
    const shells = document.querySelectorAll<HTMLElement>('[data-card]');
    const ac = new AbortController();
    const { signal } = ac;
    const rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    shells.forEach(shell => {
      const light = shell.querySelector<HTMLElement>('.card-light');
      let startX = 0, startY = 0, hasMoved = false;

      shell.addEventListener('touchstart', (e: TouchEvent) => { if (rm) return; startX = e.touches[0].clientX; startY = e.touches[0].clientY; hasMoved = false; }, { passive: true, signal });
      shell.addEventListener('touchmove', (e: TouchEvent) => {
        if (rm) return;
        const t = e.touches[0];
        if (Math.abs(t.clientX - startX) < 8 && Math.abs(t.clientY - startY) < 8) return;
        hasMoved = true;
        shell.style.transition = 'transform 80ms linear';
        const r = shell.getBoundingClientRect();
        const dx = (t.clientX - r.left - r.width / 2) / (r.width / 2);
        const dy = (t.clientY - r.top - r.height / 2) / (r.height / 2);
        shell.style.transform = `perspective(900px) rotateX(${-dy * 10}deg) rotateY(${dx * 14}deg) translateZ(6px)`;
        if (light) { light.style.setProperty('--lx', `${50 + dx * 30}%`); light.style.setProperty('--ly', `${50 - dy * 22}%`); }
      }, { passive: true, signal });
      const reset = () => {
        if (!hasMoved) { shell.style.transition = 'none'; shell.style.transform = 'perspective(900px) rotateX(0deg) rotateY(0deg)'; }
        else { shell.style.transition = 'transform 500ms var(--ease-out-soft)'; shell.style.transform = 'perspective(900px) rotateX(0deg) rotateY(0deg) translateZ(0)'; if (light) { light.style.setProperty('--lx','28%'); light.style.setProperty('--ly','22%'); } }
        hasMoved = false;
      };
      shell.addEventListener('touchend', reset, { passive: true, signal });
      shell.addEventListener('touchcancel', reset, { passive: true, signal });
      shell.addEventListener('mousemove', (e: MouseEvent) => {
        if (rm) return;
        const r = shell.getBoundingClientRect();
        const dx = (e.clientX - r.left - r.width / 2) / (r.width / 2);
        const dy = (e.clientY - r.top - r.height / 2) / (r.height / 2);
        shell.style.transition = 'transform 100ms linear';
        shell.style.transform = `perspective(900px) rotateX(${-dy * 7}deg) rotateY(${dx * 10}deg) translateZ(4px)`;
        if (light) { light.style.setProperty('--lx', `${50 + dx * 10 * 2}%`); light.style.setProperty('--ly', `${50 - (-dy * 7) * 2}%`); }
      }, { signal });
      shell.addEventListener('mouseleave', () => { shell.style.transition = 'transform 600ms var(--ease-out-soft)'; shell.style.transform = 'perspective(900px) rotateX(0deg) rotateY(0deg)'; if (light) { light.style.setProperty('--lx','28%'); light.style.setProperty('--ly','22%'); } }, { signal });
    });

    document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });
  }
  document.addEventListener('astro:page-load', initMariagesTilt);
</script>

<style>
  .mariages-hero {
    position: relative;
    padding-block: clamp(4rem, 8vw, 7rem) clamp(5rem, 9vw, 8rem);
    background:
      radial-gradient(ellipse at 11% 16%, rgba(255, 255, 255, 0.72), transparent 38%),
      radial-gradient(ellipse at 90% 30%, rgba(168, 135, 83, 0.13), transparent 34%),
      linear-gradient(180deg, #fffaf3 0%, #fbf0df 58%, #f4dec4 100%);
    overflow: hidden;
  }

  .mariages-hero::before,
  .mariages-hero::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .mariages-hero::before {
    left: 0;
    top: 12%;
    width: min(420px, 46vw);
    height: min(420px, 46vw);
    border: 0.5px solid rgba(168, 135, 83, 0.13);
    border-left: 0;
    border-radius: 0 999px 999px 0;
    opacity: 0.72;
  }

  .mariages-hero::after {
    inset-inline: 0;
    bottom: -1px;
    height: clamp(5rem, 12vw, 9rem);
    z-index: 1;
    background: linear-gradient(180deg, rgba(244, 222, 196, 0), #f4dec4 62%, #f7f1e6 100%);
  }

  .mariages-hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(300px, 1.05fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .mariages-hero-text {
    display: flex;
    flex-direction: column;
    gap: clamp(0.9rem, 2vw, 1.15rem);
  }

  /* ── Desktop: Classic Carousel (classique) ── */
  .services-carousel-desktop {
    position: relative;
    isolation: isolate;
    justify-self: end;
    width: min(100%, 480px);
    aspect-ratio: 4 / 5;
    padding: clamp(8px, 1.2vw, 12px);
    border-radius: 36px;
    overflow: visible;
    background:
      radial-gradient(circle at 18% 12%, rgba(255, 255, 255, 0.62), transparent 30%),
      linear-gradient(145deg, rgba(255, 253, 248, 0.72), rgba(236, 216, 190, 0.32));
    box-shadow:
      0 26px 58px rgba(72, 46, 25, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.62);
    touch-action: pan-y;
  }

  .services-carousel-desktop::before,
  .services-carousel-desktop::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .services-carousel-desktop::before {
    inset: -9% -12% -11% 10%;
    z-index: -1;
    border-radius: 44px;
    background:
      radial-gradient(ellipse at 70% 18%, rgba(168, 135, 83, 0.2), transparent 35%),
      radial-gradient(ellipse at 18% 86%, rgba(135, 144, 115, 0.12), transparent 38%),
      linear-gradient(145deg, rgba(168, 135, 83, 0.14), rgba(255, 255, 255, 0));
    filter: blur(0.2px);
    transform: rotate(-2.2deg);
  }

  .services-carousel-desktop::after {
    inset: 0;
    z-index: 8;
    border: 0.5px solid rgba(168, 135, 83, 0.24);
    border-radius: inherit;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.26),
      inset 0 -80px 90px rgba(55, 35, 22, 0.18),
      inset 0 80px 90px rgba(255, 248, 238, 0.16);
  }

  .sc-slide {
    position: absolute;
    inset: clamp(8px, 1.2vw, 12px);
    overflow: hidden;
    border-radius: 28px;
    opacity: 0;
    transition: opacity 900ms ease-in-out;
  }
  .sc-slide.is-active { opacity: 1; }

  .sc-link {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    text-decoration: none;
    overflow: hidden;
    border-radius: inherit;
    background: #2b1f15;
  }

  .sc-link::before,
  .sc-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .sc-link::before {
    background:
      linear-gradient(90deg, rgba(35, 21, 13, 0.32), transparent 18%, transparent 82%, rgba(35, 21, 13, 0.28)),
      linear-gradient(180deg, rgba(255, 245, 231, 0.12), transparent 22%, transparent 64%, rgba(35, 21, 13, 0.34));
    mix-blend-mode: multiply;
  }

  .sc-link::after {
    inset: 10px;
    border: 0.5px solid rgba(255, 242, 219, 0.24);
    border-radius: 22px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      0 0 44px rgba(255, 240, 215, 0.08);
  }

  .sc-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    display: block;
  }

  .sc-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    padding: 1rem;
    background: linear-gradient(to top, rgba(20,10,5,0.72) 0%, transparent 55%);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0;
    z-index: 4;
    transition: opacity 300ms;
    pointer-events: none;
  }
  .sc-slide.is-active .sc-link:hover .sc-overlay { opacity: 1; }

  /* ── Mobile: Horizontal Scroll Carousel (3D) ── */
  .video-carousel-wrapper {
    display: none;
    justify-self: center;
    width: 100%;
    max-width: 1200px;
    overflow: hidden;
    perspective: 1200px;
  }

  .video-carousel {
    display: flex;
    gap: clamp(1rem, 2vw, 2rem);
    overflow-x: auto;
    padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1rem, 2vw, 1.5rem);
    scroll-behavior: smooth;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
  }

  .video-carousel::-webkit-scrollbar {
    height: 6px;
  }

  .video-carousel::-webkit-scrollbar-track {
    background: rgba(168, 135, 83, 0.1);
    border-radius: 10px;
  }

  .video-carousel::-webkit-scrollbar-thumb {
    background: rgba(168, 135, 83, 0.3);
    border-radius: 10px;
  }

  .video-carousel::-webkit-scrollbar-thumb:hover {
    background: rgba(168, 135, 83, 0.5);
  }

  .video-card {
    flex: 0 0 clamp(240px, 50vw, 380px);
    height: clamp(320px, 66vw, 500px);
    scroll-snap-align: center;
    scroll-snap-stop: always;
  }

  .card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: clamp(16px, 3vw, 24px);
    overflow: hidden;
    background: #1a1a1a;
    box-shadow: 0 16px 40px rgba(72, 46, 25, 0.2);
    transition: transform 300ms ease-out, box-shadow 300ms ease-out;
    cursor: pointer;
  }

  .video-card:hover .card-inner {
    transform: scale(1.04) translateY(-4px);
    box-shadow: 0 24px 60px rgba(72, 46, 25, 0.3);
  }

  .video-player {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .play-btn {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 60px;
    height: 60px;
    background: rgba(0, 0, 0, 0.4);
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 300ms ease-out;
    backdrop-filter: blur(4px);
    z-index: 2;
  }

  .video-card:hover .play-btn {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
  }

  .play-btn:active {
    transform: scale(0.95);
  }

  .insta-link {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    width: 44px;
    height: 44px;
    background: rgba(255, 255, 255, 0.1);
    border: 0.5px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 300ms ease-out;
    z-index: 3;
    backdrop-filter: blur(4px);
    text-decoration: none;
  }

  .insta-link:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
  }

  @media (max-width: 720px) {
    /* Hide desktop carousel on mobile */
    .services-carousel-desktop {
      display: none;
    }

    /* Show mobile carousel on mobile */
    .video-carousel-wrapper {
      display: block;
    }

    .video-carousel {
      padding: 1.2rem 0.8rem;
      gap: 1rem;
    }

    .video-card {
      flex: 0 0 min(80vw, 280px);
      height: min(106vw, 373px);
    }

    .play-btn {
      width: 50px;
      height: 50px;
    }
  }

  .mariages-hero-img::after {
    content: '';
    position: absolute;
    inset: 7% 8% 7% -6%;
    border: 0.5px solid rgba(168, 135, 83, 0.28);
    border-radius: 28px;
