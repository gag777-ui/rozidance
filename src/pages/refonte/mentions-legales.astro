---
import RefonteLayout from '../../layouts/RefonteLayout.astro';
import { legalTranslations } from '../../i18n/legal';
import { localePath } from '../../i18n/refonte';
import { getTranslations, type Lang } from '../../i18n/utils';

const { lang = 'fr' } = Astro.props as { lang?: Lang };
const t = getTranslations(lang);
const legal = legalTranslations[lang];
---

<RefonteLayout
  title={`${t.footer.legal} — Rozi Dance`}
  description={legal.description}
  bodyClass="rf-system-page rf-legal-page"
  chapter={t.footer.legal}
  lang={lang}
>
  <main id="contenu">
    <section class="rf-legal-hero" data-camera="in">
      <div class="rf-legal-hero__plane" data-camera-plane>
        <a class="rf-back-link" href={localePath(lang)}>
          <span aria-hidden="true">←</span>
          {t.footer.homeAria}
        </a>
        <span class="rf-eyebrow">Rozi Dance</span>
        <h1 class="rf-detail-title">
          <span class="rf-line-mask"><span data-hero-line>{t.footer.legal}</span></span>
        </h1>
        <div class="rf-legal-hero__seal" aria-hidden="true"></div>
      </div>
    </section>

    <div class="rf-legal-content">
      <section data-reveal>
        <h2>{legal.publisherTitle}</h2>
        <p>
          <strong>Rozi Dance</strong><br />
          {legal.publisherRole}<br />
          {legal.country}<br />
          {legal.email} : <a href="mailto:abrahamyan.rose@mail.ru">abrahamyan.rose@mail.ru</a><br />
          {legal.phone} : <a href="tel:+32486219896">+32 486 21 98 96</a>
        </p>
      </section>

      <section data-reveal>
        <h2>{legal.hostingTitle}</h2>
        <p>
          {legal.hostingText} <strong>Vercel Inc.</strong><br />
          340 Pine Street, Suite 701 — San Francisco, CA 94104, {legal.hostingCountry}<br />
          <a href="https://vercel.com" target="_blank" rel="noopener noreferrer">vercel.com</a>
        </p>
      </section>

      <section data-reveal>
        <h2>{legal.intellectualPropertyTitle}</h2>
        {legal.intellectualProperty.map((paragraph) => <p>{paragraph}</p>)}
      </section>

      <section data-reveal>
        <h2>{legal.privacyTitle}</h2>
        <p>{legal.privacyIntro}</p>
        <p>
          {legal.privacyRights} <a href="mailto:abrahamyan.rose@mail.ru">abrahamyan.rose@mail.ru</a>.
        </p>
      </section>

      <section data-reveal>
        <h2>{legal.cookiesTitle}</h2>
        <p>{legal.cookies}</p>
      </section>

      <section data-reveal>
        <h2>{legal.externalLinksTitle}</h2>
        <p>{legal.externalLinks}</p>
      </section>

      <section data-reveal>
        <h2>{legal.applicableLawTitle}</h2>
        <p>{legal.applicableLaw}</p>
      </section>
    </div>
  </main>
</RefonteLayout>
