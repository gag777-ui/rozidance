---
import RefonteLayout from '../../layouts/RefonteLayout.astro';
import VideoFrame from '../../components/refonte/VideoFrame.astro';
import { galleryPhotos, heroVideos, socials } from '../../data/refonte';
import { getTranslations, type Lang } from '../../i18n/utils';
import { localePath } from '../../i18n/refonte';

const { lang = 'fr' } = Astro.props as { lang?: Lang };
const t = getTranslations(lang);
const localizedPhotos = galleryPhotos.map((photo, index) => ({
  ...photo,
  alt: `${t.galerie.altPlaceholder} ${index + 1}`,
}));
const galleryVideo = {
  ...heroVideos[1],
  title: t.galerie.title,
  label: t.videos.eyebrow,
};
---

<RefonteLayout
  title={`${t.galerie.title} — Rozi Dance`}
  description={t.galerie.pageDescription}
  bodyClass="rf-gallery-page"
  chapter={t.galerie.title}
  lang={lang}
>
  <main id="contenu">
    <section class="rf-page-hero rf-page-hero--gallery" data-camera="out">
      <div class="rf-page-hero__plane" data-camera-plane>
        <div class="rf-page-hero__copy">
          <a class="rf-back-link" href={localePath(lang)}>
            <span aria-hidden="true">←</span>
            {t.hero.line3a} {t.hero.line3italic}
          </a>
          <span class="rf-eyebrow">{t.galerie.eyebrow}</span>
          <h1 class="rf-page-title rf-page-title--localized">
            <span class="rf-line-mask"><span data-hero-line>{t.galerie.title}</span></span>
          </h1>
          <p>{t.galerie.pageDescription}</p>
          <div class="rf-action-row">
            <a class="rf-button rf-button--ink" href={socials.instagram} target="_blank" rel="noopener noreferrer">
              {t.galerie.instagramLink}
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="rf-page-hero__media rf-page-hero__media--gallery" data-hero-media data-depth="1">
          <VideoFrame video={galleryVideo} shape="oval" tone="gallery-hero" eager={true} lang={lang} />
        </div>

        <div class="rf-gallery-aperture" aria-hidden="true"></div>
      </div>
    </section>

    <section class="rf-gallery-stream" aria-label={t.galerie.title}>
      {localizedPhotos.map((photo, index) => (
        <a
          class={`rf-gallery-stream__photo rf-gallery-stream__photo--${(index % 7) + 1}`}
          href={photo.src}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${t.galerie.openPhoto} — ${photo.alt}`}
          data-depth={(index % 5) * 0.35 - 0.7}
          data-reveal
        >
          <img src={photo.src} alt={photo.alt} loading={index < 4 ? 'eager' : 'lazy'} />
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        </a>
      ))}
    </section>

    <section class="rf-gallery-exit" data-camera="in">
      <div data-camera-plane>
        <span class="rf-eyebrow">{t.galerie.eyebrow}</span>
        <h2>{t.galerie.title}</h2>
        <a class="rf-button rf-button--light" href={socials.instagram} target="_blank" rel="noopener noreferrer">
          {t.galerie.instagramLink}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </main>
</RefonteLayout>
