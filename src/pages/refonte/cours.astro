---
import RefonteLayout from '../../layouts/RefonteLayout.astro';
import VideoFrame from '../../components/refonte/VideoFrame.astro';
import ContactScene from '../../components/refonte/ContactScene.astro';
import ServiceBridge from '../../components/refonte/ServiceBridge.astro';
import { coursPages, coursVideos } from '../../data/refonte';
import { getTranslations, type Lang } from '../../i18n/utils';
import { localePath } from '../../i18n/refonte';

const { lang = 'fr' } = Astro.props as { lang?: Lang };
const t = getTranslations(lang);
const courseShapes = ['portrait', 'oval', 'ribbon', 'arch', 'soft'] as const;
const localizedPages = coursPages.map((page, index) => ({
  ...page,
  title: t.cours.cards[index]?.title ?? page.title,
  text: t.cours.cards[index]?.description ?? page.text,
}));
const localizedVideos = coursVideos.map((video, index) => ({
  ...video,
  title: `${t.cours.cardLink} ${index + 1}`,
  label: t.videos.eyebrow,
}));
---

<RefonteLayout
  title={t.cours.pageTitle}
  description={t.cours.pageDescription}
  bodyClass="rf-courses"
  chapter={t.cours.heroTitle}
  lang={lang}
>
  <main id="contenu">
    <section class="rf-page-hero rf-page-hero--courses" data-camera="in">
      <div class="rf-page-hero__plane" data-camera-plane>
        <div class="rf-page-hero__copy">
          <a class="rf-back-link" href={localePath(lang)}>
            <span aria-hidden="true">←</span>
            {t.hero.line3a} {t.hero.line3italic}
          </a>
          <span class="rf-eyebrow">{t.cours.heroEyebrow}</span>
          <h1 class="rf-page-title rf-page-title--course rf-page-title--localized">
            <span class="rf-line-mask"><span data-hero-line>{t.cours.heroTitle}</span></span>
          </h1>
          <p>{t.cours.heroSubtitle}</p>
        </div>

        <div class="rf-page-hero__media rf-page-hero__media--courses" data-hero-media data-depth="-1">
          <VideoFrame video={localizedVideos[0]} shape="soft" tone="course-hero" eager={true} lang={lang} />
        </div>

        <div class="rf-course-beat" aria-hidden="true">
          <i></i><i></i><i></i><i></i><i></i>
        </div>
      </div>
    </section>

    <section class="rf-course-score">
      <header class="rf-section-heading rf-section-heading--split" data-reveal>
        <span class="rf-eyebrow">{t.cours.heroEyebrow}</span>
        <h2>{t.cours.heroTitle}</h2>
      </header>

      <div class="rf-course-score__line" aria-hidden="true"></div>
      <div class="rf-course-score__items">
        {localizedPages.map((page, index) => (
          <a
            class:list={['rf-course-score__item', index % 2 ? 'rf-course-score__item--right' : '']}
            href={localePath(lang, `/cours/${page.slug}`)}
            data-reveal
          >
            <span class="rf-course-score__number">{String(index + 1).padStart(2, '0')}</span>
            <span class="rf-course-score__body">
              <strong>{page.title}</strong>
              <span>{page.text}</span>
            </span>
            <i aria-hidden="true">→</i>
          </a>
        ))}
      </div>
    </section>

    <section class="rf-horizontal-story rf-course-film" data-horizontal-story>
      <div class="rf-horizontal-stage" data-horizontal-stage>
        <header class="rf-course-film__heading">
          <span class="rf-eyebrow">{t.videos.eyebrow}</span>
          <h2>{t.cours.cardLink}</h2>
        </header>
        <div class="rf-horizontal-rail" data-horizontal-rail>
          {localizedVideos.map((video, index) => (
            <article class="rf-course-film__scene">
              <span class="rf-course-film__index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <VideoFrame
                video={video}
                shape={courseShapes[index]}
                tone={`course-${index + 1}`}
                lang={lang}
              />
            </article>
          ))}
        </div>
      </div>
    </section>

    <ContactScene
      eyebrow={t.contact.eyebrow}
      title={t.cours.ctaTitle}
      text={t.cours.ctaSubtitle}
      primaryLabel={t.cours.ctaBtn}
    />
    <ServiceBridge
      currentHref={localePath(lang, '/cours')}
      eyebrow={t.prestations.eyebrow}
      title={t.prestations.title}
      lang={lang}
    />
  </main>
</RefonteLayout>
