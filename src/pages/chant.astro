---
import Layout from '../layouts/Layout.astro';
import { getTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/utils';
import CtaFloat from '../components/ui/CtaFloat.astro';
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = getTranslations(lang);
const c = t.chant;
const base = lang === 'fr' ? '' : `/${lang}`;
---

<Layout title={c.pageTitle} description={c.pageDescription}>
  <!-- Hero -->
  <section class="chant-hero">
    <div class="section-container chant-hero-inner">
      <div class="chant-hero-text">
        <a href={`${base || '/'}#prestations`} class="back-link">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M12 7H2M6 3l-4 4 4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {t.nav.prestations}
        </a>
        <span class="eyebrow">{c.heroEyebrow}</span>
        <h1>{c.heroTitle}</h1>
        <p class="hero-subtitle">{c.heroSubtitle}</p>
      </div>
      <div class="chant-hero-img" aria-hidden="true">
        <img
          src="/images/chant-hero.webp"
          alt=""
          width="1536"
          height="1024"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- 3 category cards -->
  <section class="categories-section">
    <div class="section-container">
      <div class="categories-grid">
        {c.categories.map((cat, i) => {
          const reelHrefs: (string | null)[] = [
            'https://www.instagram.com/reel/DDXmkVPoV5g/?igsh=MWN6bzR2MnlndnQ4MQ%3D%3D',
            'https://www.instagram.com/reel/DDch0BjoQfT/?igsh=dHJ5Zzhqbmt5cmly',
            'https://www.instagram.com/reel/DDVA4oQI4c1/?igsh=MWw3d3UwbWoxbWl5bA%3D%3D',
          ];
          const href = reelHrefs[i];
          return (
            href
              ? (
                <a
                  class={`card-shell cs-${i} reveal`}
                  style={`transition-delay: ${i * 100}ms`}
                  data-card
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={cat.title}
                >
                  <div class={`card-core cc-${i}`}>
                    <div class="card-light"></div>
                    <div class="card-top">
                      <span class="card-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                      <div class="card-thumb">
                        <img src="/images/reel-mariages.webp" alt={cat.title} loading="lazy" width="1013" height="1372" />
                      </div>
                    </div>
                    <h2 class="card-title">{cat.title}</h2>
                    <div class="card-line"></div>
                    <p class="card-desc">{cat.description}</p>
                    <span class="card-cta">
                      {c.cardLink}
                      <span class="cta-circle" aria-hidden="true">
                        <svg width="10" height="10" viewBox="0 0 14 14" fill="none">
                          <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                    </span>
                  </div>
                </a>
              )
              : (
                <div class={`card-shell cs-${i} reveal`} style={`transition-delay: ${i * 100}ms`} data-card>
                  <div class={`card-core cc-${i}`}>
                    <div class="card-light"></div>
                    <div class="card-top">
                      <span class="card-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                      <div class="card-thumb">
                        <img src="/images/reel-mariages.webp" alt={cat.title} loading="lazy" width="1013" height="1372" />
                      </div>
                    </div>
                    <h2 class="card-title">{cat.title}</h2>
                    <div class="card-line"></div>
                    <p class="card-desc">{cat.description}</p>
                    <span class="card-cta">
                      {c.cardLink}
                      <span class="cta-circle" aria-hidden="true">
                        <svg width="10" height="10" viewBox="0 0 14 14" fill="none">
                          <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                    </span>
                  </div>
                </div>
              )
          );
        })}
      </div>
    </div>
  </section>

  <script>
    function initChantTilt() {
      const shells = document.querySelectorAll<HTMLElement>('[data-card]');
      const ac = new AbortController(); const { signal } = ac;
      const rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      shells.forEach(shell => {
        const light = shell.querySelector<HTMLElement>('.card-light');
        let startX = 0, startY = 0, hasMoved = false;
        shell.addEventListener('touchstart', (e: TouchEvent) => { if (rm) return; startX = e.touches[0].clientX; startY = e.touches[0].clientY; hasMoved = false; }, { passive: true, signal });
        shell.addEventListener('touchmove', (e: TouchEvent) => {
          if (rm) return;
          const t = e.touches[0];
          if (Math.abs(t.clientX - startX) < 8 && Math.abs(t.clientY - startY) < 8) return;
          hasMoved = true;
          shell.style.transition = 'transform 80ms linear';
          const r = shell.getBoundingClientRect();
          const dx = (t.clientX-r.left-r.width/2)/(r.width/2), dy = (t.clientY-r.top-r.height/2)/(r.height/2);
          shell.style.transform = `perspective(900px) rotateX(${-dy*10}deg) rotateY(${dx*14}deg) translateZ(6px)`;
          if (light) { light.style.setProperty('--lx',`${50+dx*30}%`); light.style.setProperty('--ly',`${50-dy*22}%`); }
        }, { passive: true, signal });
        const reset = () => {
          if (!hasMoved) { shell.style.transition = 'none'; shell.style.transform = 'perspective(900px) rotateX(0deg) rotateY(0deg)'; }
          else { shell.style.transition = 'transform 500ms var(--ease-out-soft)'; shell.style.transform = 'perspective(900px) rotateX(0deg) rotateY(0deg)'; if (light) { light.style.setProperty('--lx','28%'); light.style.setProperty('--ly','22%'); } }
          hasMoved = false;
        };
        shell.addEventListener('touchend', reset, { passive: true, signal });
        shell.addEventListener('touchcancel', reset, { passive: true, signal });
        shell.addEventListener('mousemove', (e: MouseEvent) => {
          if (rm) return; const r = shell.getBoundingClientRect();
          const dx = (e.clientX-r.left-r.width/2)/(r.width/2), dy = (e.clientY-r.top-r.height/2)/(r.height/2);
          shell.style.transition = 'transform 100ms linear';
          shell.style.transform = `perspective(900px) rotateX(${-dy*7}deg) rotateY(${dx*10}deg) translateZ(4px)`;
          if (light) { light.style.setProperty('--lx',`${50+dx*20}%`); light.style.setProperty('--ly',`${50-dy*14}%`); }
        }, { signal });
        shell.addEventListener('mouseleave', () => { shell.style.transition = 'transform 600ms var(--ease-out-soft)'; shell.style.transform = 'perspective(900px) rotateX(0deg) rotateY(0deg)'; if (light) { light.style.setProperty('--lx','28%'); light.style.setProperty('--ly','22%'); } }, { signal });
      });
      document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });
    }
    document.addEventListener('astro:page-load', initChantTilt);
  </script>

  <!-- CTA -->
  <section class="chant-cta">
    <div class="section-container chant-cta-inner reveal-fade">
      <span class="eyebrow">{c.ctaEyebrow}</span>
      <h2>{c.ctaTitle}</h2>
      <p>{c.ctaText}</p>
      <a href={`${base || '/'}#contact`} class="cta-btn">
        {c.ctaBtn}
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </section>
  <CtaFloat href="tel:+32486219896" />
</Layout>

<style>
  .chant-hero {
    padding-block: var(--spacing-section);
    background-color: var(--color-bg-section);
    border-bottom: 0.5px solid var(--color-border);
    overflow: hidden;
  }

  .chant-hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 2rem;
  }

  .chant-hero-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .chant-hero-img {
    position: relative;
  }

  .chant-hero-img img {
    width: 100%;
    height: auto;
    display: block;
    mask-image:
      linear-gradient(to right, transparent 0%, black 15%, black 90%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, black 5%, black 95%, transparent 100%);
    mask-composite: intersect;
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, black 15%, black 90%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, black 5%, black 95%, transparent 100%);
    -webkit-mask-composite: source-in;
  }

  @media (max-width: 768px) {
    .chant-hero-inner {
      grid-template-columns: 1fr;
    }

    .chant-hero-img {
      max-height: 220px;
      overflow: hidden;
    }

    .chant-hero-img img {
      object-fit: cover;
      object-position: center top;
      height: 220px;
      width: 100%;
    }
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    text-decoration: none;
    margin-bottom: 0.5rem;
    min-height: 44px;
    padding: 0.5rem 0;
    transition: color 220ms var(--ease-out-soft), gap 220ms var(--ease-out-soft);
    -webkit-tap-highlight-color: transparent;
  }

  .back-link:hover { color: var(--color-accent); gap: 0.75rem; }

  .chant-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 400;
    color: var(--color-section-title);
    line-height: 1.15;
    margin: 0;
  }

  .hero-subtitle {
    font-size: clamp(0.9375rem, 1.5vw, 1.0625rem);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 56ch;
    margin: 0;
  }

  .categories-section { padding-block: var(--spacing-section); }

  .categories-grid {
    display: flex; flex-direction: column;
    gap: 0.85rem; max-width: 420px; margin-inline: auto;
  }
  @media (min-width: 600px) { .categories-grid { display: grid; grid-template-columns: repeat(3, 1fr); max-width: 100%; gap: 1.25rem; } }

  .card-shell {
    border-radius: 28px; padding: 5px;
    border: 0.5px solid rgba(229,215,190,0.6);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.9), 0 2px 8px rgba(43,31,21,0.04);
    transform-style: preserve-3d;
    transform: perspective(900px) rotateX(0deg) rotateY(0deg);
    transition: transform 500ms var(--ease-out-soft), box-shadow 500ms var(--ease-out-soft);
    will-change: transform;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .cs-0 { background: rgba(168,135,83,0.07); }
  .cs-1 { background: rgba(193,104,71,0.07); }
  .cs-2 { background: rgba(122,92,32,0.06); }

  .card-core {
    border-radius: 22px; padding: 1.1rem 1.25rem;
    display: flex; flex-direction: column; gap: 0.65rem;
    position: relative; overflow: hidden;
  }
  .cc-0 { background: linear-gradient(145deg, #FEFCF8 0%, #EDDEB8 100%); }
  .cc-1 { background: linear-gradient(145deg, #FEFCF8 0%, #F0CBBA 100%); }
  .cc-2 { background: linear-gradient(145deg, #FEFCF8 0%, #E6D8A8 100%); }

  .card-light {
    position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(circle at var(--lx,28%) var(--ly,22%), rgba(255,255,255,0.38) 0%, rgba(255,255,255,0.1) 35%, transparent 65%);
    border-radius: inherit; transition: background 80ms linear;
  }
  .card-top { display: flex; align-items: center; justify-content: space-between; position: relative; }
  .card-num { font-family: var(--font-serif); font-size: 2.5rem; font-weight: 200; font-style: italic; line-height: 1; color: rgba(43,31,21,0.09); user-select: none; pointer-events: none; }
  .card-thumb { width: 48px; height: 48px; border-radius: 50%; overflow: hidden; border: 0.5px solid rgba(229,215,190,0.7); flex-shrink: 0; }
  .card-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .card-title { font-family: var(--font-serif); font-size: 1.25rem; font-weight: 300; font-style: italic; color: var(--color-text-primary); margin: 0; line-height: 1.2; position: relative; }
  .card-line { height: 0.5px; background: linear-gradient(90deg, var(--color-border), transparent); position: relative; }
  .card-desc { font-size: 0.95rem; color: var(--color-text-secondary); line-height: 1.72; margin: 0; flex: 1; position: relative; }
  .card-cta { display: inline-flex; align-items: center; gap: 0.55rem; font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; font-style: normal; font-weight: 500; text-decoration: none; color: var(--color-accent); padding: 0.5rem 0.6rem 0.5rem 0.9rem; min-height: 44px; border-radius: 999px; background: rgba(255,255,255,0.5); border: 0.5px solid rgba(255,255,255,0.85); box-shadow: inset 0 1px 0 rgba(255,255,255,0.95), 0 1px 4px rgba(43,31,21,0.06); align-self: flex-start; margin-top: 0.2rem; position: relative; overflow: hidden; cursor: pointer; transition: background 300ms var(--ease-out-soft), gap 300ms var(--ease-out-soft); }
  .card-cta::before { content: ''; position: absolute; top: 0; left: -80%; width: 55%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.6), transparent); animation: cta-shimmer 4s ease-in-out infinite; pointer-events: none; }
  @keyframes cta-shimmer { 0% { left: -80%; } 30% { left: 130%; } 100% { left: 130%; } }
  .card-shell:nth-child(2) .card-cta::before { animation-delay: 1.3s; }
  .card-shell:nth-child(3) .card-cta::before { animation-delay: 2.6s; }
  .cs-0 .card-cta { color: var(--color-gold); }
  .cs-2 .card-cta { color: #7A5C20; }
  .card-cta:hover { background: rgba(255,255,255,0.78); gap: 0.8rem; }
  .cta-circle { width: 28px; height: 28px; border-radius: 50%; border: 1px solid currentColor; opacity: 0.75; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: transform 350ms var(--ease-out-soft), opacity 300ms; animation: arrow-nudge 4s ease-in-out infinite; }
  @keyframes arrow-nudge { 0%, 50%, 100% { transform: translateX(0); } 62% { transform: translateX(4px); } 70% { transform: translateX(1px); } 78% { transform: translateX(3px); } 86% { transform: translateX(0); } }
  .card-shell:nth-child(2) .cta-circle { animation-delay: 1.3s; }
  .card-shell:nth-child(3) .cta-circle { animation-delay: 2.6s; }
  .card-cta:hover .cta-circle, .card-cta:focus .cta-circle { opacity: 1; transform: translateX(4px); animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) { .card-cta::before { animation: none; } .cta-circle { animation: none; } }

  .chant-cta {
    padding-block: var(--spacing-section);
    background-color: var(--color-bg-section);
    border-top: 0.5px solid var(--color-border);
  }

  .chant-cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
  }

  .chant-cta h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 400;
    color: var(--color-text-primary);
    margin: 0;
  }

  .chant-cta p { font-size: 1rem; color: var(--color-text-secondary); line-height: 1.7; max-width: 50ch; margin: 0; }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.75rem;
    background-color: var(--color-accent);
    color: white;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-btn);
    transition: background-color 300ms var(--ease-out-soft), gap 250ms var(--ease-out-soft);
    margin-top: 0.5rem;
  }

  .cta-btn:hover { background-color: color-mix(in srgb, var(--color-accent) 85%, black); gap: 0.75rem; }

  /* Harmonisation avec la page Mariages & Evenements */
  .chant-hero {
    position: relative;
    padding-block: clamp(4rem, 8vw, 7rem) clamp(5rem, 9vw, 8rem);
    background:
      radial-gradient(ellipse at 11% 16%, rgba(255, 255, 255, 0.72), transparent 38%),
      radial-gradient(ellipse at 90% 30%, rgba(168, 135, 83, 0.13), transparent 34%),
      linear-gradient(180deg, #fffaf3 0%, #fbf0df 58%, #f4dec4 100%);
    border-bottom: 0;
  }

  .chant-hero::before,
  .chant-hero::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .chant-hero::before {
    left: 0;
    top: 12%;
    width: min(420px, 46vw);
    height: min(420px, 46vw);
    border: 0.5px solid rgba(168, 135, 83, 0.13);
    border-left: 0;
    border-radius: 0 999px 999px 0;
    opacity: 0.72;
  }

  .chant-hero::after {
    inset-inline: 0;
    bottom: -1px;
    z-index: 1;
    height: clamp(5rem, 12vw, 9rem);
    background: linear-gradient(180deg, rgba(244, 222, 196, 0), #f4dec4 62%, #f7f1e6 100%);
  }

  .chant-hero-inner {
    position: relative;
    z-index: 2;
    grid-template-columns: minmax(0, 0.95fr) minmax(300px, 1.05fr);
    gap: clamp(2rem, 5vw, 5rem);
  }

  .chant-hero-img {
    justify-self: end;
    width: min(100%, 590px);
  }

  .chant-hero-img::before {
    content: '';
    position: absolute;
    inset: 8% -4% -7% 13%;
    border-radius: 32px;
    background: linear-gradient(145deg, rgba(168, 135, 83, 0.2), rgba(255, 255, 255, 0.08));
    transform: rotate(-2deg);
  }

  .chant-hero-img::after {
    content: '';
    position: absolute;
    inset: 7% 8% 7% -6%;
    border: 0.5px solid rgba(168, 135, 83, 0.28);
    border-radius: 28px;
    transform: rotate(2.4deg);
    pointer-events: none;
  }

  .chant-hero-img img {
    position: relative;
    z-index: 1;
    border-radius: 26px;
    box-shadow: 0 24px 58px rgba(72, 46, 25, 0.13);
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, black 12%, black 94%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, black 4%, black 94%, transparent 100%);
    mask-image:
      linear-gradient(to right, transparent 0%, black 12%, black 94%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, black 4%, black 94%, transparent 100%);
  }

  .chant-hero h1 {
    font-size: clamp(2.6rem, 7vw, 5.7rem);
    font-weight: 300;
    line-height: 0.95;
    max-width: 9ch;
  }

  .categories-section {
    position: relative;
    overflow: hidden;
    margin-top: -1px;
    padding-block: clamp(3.8rem, 8vw, 6.8rem) clamp(6rem, 11vw, 9rem);
    background:
      radial-gradient(ellipse at 16% 8%, rgba(168, 135, 83, 0.08), transparent 34%),
      radial-gradient(ellipse at 88% 92%, rgba(135, 144, 115, 0.07), transparent 36%),
      linear-gradient(180deg, #f7f1e6 0%, #fff8ee 44%, #f2dfc9 100%);
  }

  .categories-section::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -1px;
    height: clamp(5rem, 12vw, 9rem);
    pointer-events: none;
    background: linear-gradient(180deg, rgba(242, 223, 201, 0), #f5e6d1 56%, #fff8ee 100%);
  }

  .categories-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 100%;
    gap: clamp(0.72rem, 2.5vw, 1.1rem);
  }

  .card-shell {
    padding: 0;
    color: var(--color-charcoal);
    border: 0;
    border-radius: 24px;
    background: transparent;
    box-shadow: none;
    text-decoration: none;
  }

  .card-core {
    min-height: 214px;
    padding: 1.15rem;
    gap: 0.75rem;
    border: 0.5px solid rgba(154, 119, 72, 0.18);
    border-radius: 22px;
    background:
      radial-gradient(circle at 16% 10%, rgba(255, 255, 255, 0.82), transparent 28%),
      radial-gradient(circle at 92% 96%, rgba(168, 135, 83, 0.12), transparent 34%),
      linear-gradient(145deg, rgba(255, 253, 248, 0.98), rgba(246, 235, 219, 0.94));
    box-shadow:
      0 14px 32px rgba(72, 46, 25, 0.07),
      inset 0 1px 0 rgba(255, 255, 255, 0.86);
  }

  .card-core::before {
    content: '';
    position: absolute;
    inset: 10px;
    pointer-events: none;
    border: 0.5px solid rgba(154, 119, 72, 0.13);
    border-radius: 17px;
  }

  .card-core::after {
    content: '';
    position: absolute;
    right: -30px;
    top: -52px;
    width: 132px;
    height: 172px;
    pointer-events: none;
    border-radius: 999px;
    background: rgba(168, 135, 83, 0.095);
    transform: rotate(-24deg);
    transition: transform 700ms var(--ease-out-soft);
  }

  .card-top {
    min-height: 38px;
  }

  .card-num {
    display: none;
  }

  .card-thumb {
    width: 40px;
    height: 40px;
    border-radius: 14px;
    background: rgba(255, 250, 241, 0.72);
    backdrop-filter: blur(10px);
  }

  .card-thumb img {
    display: none;
  }

  .card-thumb::before {
    content: '';
    display: block;
    width: 18px;
    height: 18px;
    margin: 10px auto;
    border: 1.25px solid rgba(95, 70, 48, 0.74);
    border-radius: 50%;
    box-shadow: 6px 0 0 -4px rgba(95, 70, 48, 0.74), -6px 0 0 -4px rgba(95, 70, 48, 0.74);
  }

  .card-title {
    font-size: clamp(1.15rem, 2.2vw, 1.55rem);
    line-height: 1.12;
  }

  .card-line {
    background: linear-gradient(90deg, rgba(168, 135, 83, 0.28), transparent);
  }

