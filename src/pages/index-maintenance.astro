---
// Page de maintenance temporaire avec accès par code
const passCode = "rozi2026";
const userPass = Astro.url.searchParams.get("pass");
const isAuthorized = userPass === passCode;

if (!isAuthorized) {
  // Afficher la page de maintenance
}
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Rozi Dance — Bientôt disponible</title>
  <meta name="robots" content="noindex, nofollow">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: linear-gradient(135deg, #2b1f15 0%, #1c1410 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      color: #f5f5f5;
    }

    .container {
      text-align: center;
      max-width: 500px;
    }

    .logo {
      width: 120px;
      height: 120px;
      margin-bottom: 2rem;
      opacity: 0.9;
    }

    h1 {
      font-size: 2.5rem;
      margin-bottom: 1rem;
      font-weight: 300;
      letter-spacing: 1px;
    }

    p {
      font-size: 1.1rem;
      color: rgba(255, 255, 255, 0.7);
      margin-bottom: 2rem;
      line-height: 1.6;
    }

    .access-form {
      margin-top: 3rem;
      padding: 2rem;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 12px;
      backdrop-filter: blur(10px);
    }

    .access-form label {
      display: block;
      font-size: 0.9rem;
      margin-bottom: 0.5rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      opacity: 0.8;
    }

    .access-form input {
      width: 100%;
      padding: 12px;
      margin-bottom: 1rem;
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 6px;
      color: white;
      font-size: 1rem;
    }

    .access-form input::placeholder {
      color: rgba(255, 255, 255, 0.5);
    }

    .access-form input:focus {
      outline: none;
      border-color: rgba(184, 134, 11, 0.5);
      background: rgba(255, 255, 255, 0.15);
    }

    .access-form button {
      width: 100%;
      padding: 12px;
      background: linear-gradient(135deg, #b8860b 0%, #d4af37 100%);
      color: #1c1410;
      border: none;
      border-radius: 6px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: transform 200ms, box-shadow 200ms;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .access-form button:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 16px rgba(184, 134, 11, 0.3);
    }

    .footer {
      margin-top: 3rem;
      font-size: 0.9rem;
      opacity: 0.6;
    }
  </style>
</head>
<body>
  <div class="container">
    <svg class="logo" viewBox="0 0 500 500" xmlns="http://www.w3.org/2000/svg">
      <circle cx="250" cy="250" r="240" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="2"/>
      <text x="250" y="280" font-size="80" fill="rgba(184,134,11,0.8)" text-anchor="middle" font-weight="300">RD</text>
    </svg>

    <h1>Rozi Dance</h1>
    <p>Le site arrive bientôt 🎭<br>Une surprise vous attend...</p>

    <div class="access-form">
      <form method="GET">
        <label for="pass">Accès privé</label>
        <input 
          type="password" 
          id="pass" 
          name="pass" 
          placeholder="Entrez le code"
          required
        >
        <button type="submit">Accéder</button>
      </form>
    </div>

    <div class="footer">
      <p>Livraison fin de semaine</p>
    </div>
  </div>
</body>
</html>
