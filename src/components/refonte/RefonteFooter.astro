---
import { socials } from '../../data/refonte';
import { getTranslations, type Lang } from '../../i18n/utils';
import { localePath } from '../../i18n/refonte';

const { lang = 'fr' } = Astro.props as { lang?: Lang };
const t = getTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="rf-footer">
  <div class="rf-footer__brand">
    <a href={localePath(lang)} aria-label={t.footer.homeAria}>
      <img src="/images/logo-transparent.png" alt="Rozi Dance" width="500" height="500" />
    </a>
    <p>{t.footer.tagline}</p>
  </div>

  <nav class="rf-footer__nav" aria-label={t.footer.nav}>
    <a href={localePath(lang, '/mariages')}>{t.prestations.items[0].title}</a>
    <a href={localePath(lang, '/chant')}>{t.prestations.items[1].title}</a>
    <a href={localePath(lang, '/cours')}>{t.nav.cours}</a>
    <a href={localePath(lang, '/galerie')}>{t.nav.galerie}</a>
  </nav>

  <nav class="rf-footer__contact" aria-label={t.nav.contact}>
    <a href={socials.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a>
    <a href={socials.youtube} target="_blank" rel="noopener noreferrer">YouTube ↗</a>
    <a href={socials.facebook} target="_blank" rel="noopener noreferrer">Facebook ↗</a>
    <a href={socials.email}>E-mail</a>
    <a href={socials.phone}>+32 486 21 98 96</a>
  </nav>

  <div class="rf-footer__base">
    <span>{t.footer.copyright.replace('{year}', String(year))}</span>
    <a href={localePath(lang, '/mentions-legales')}>{t.footer.legal}</a>
  </div>
</footer>
