---
import { socials } from '../../data/refonte';

const year = new Date().getFullYear();
---

<footer class="rf-footer">
  <div class="rf-footer__brand">
    <a href="/refonte" aria-label="Rozi Dance — accueil">
      <img src="/images/logo-transparent.png" alt="Rozi Dance" width="500" height="500" />
    </a>
    <p>L'âme arménienne en mouvement.</p>
  </div>

  <nav class="rf-footer__nav" aria-label="Navigation secondaire">
    <a href="/refonte/mariages">Mariages & événements</a>
    <a href="/refonte/chant">L'art du chant</a>
    <a href="/refonte/cours">Cours chant & danse</a>
    <a href="/refonte/galerie">Galerie</a>
  </nav>

  <nav class="rf-footer__contact" aria-label="Contact et réseaux sociaux">
    <a href={socials.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a>
    <a href={socials.youtube} target="_blank" rel="noopener noreferrer">YouTube ↗</a>
    <a href={socials.facebook} target="_blank" rel="noopener noreferrer">Facebook ↗</a>
    <a href={socials.email}>E-mail</a>
    <a href={socials.phone}>+32 486 21 98 96</a>
  </nav>

  <div class="rf-footer__base">
    <span>© {year} Rozi Dance. Tous droits réservés.</span>
    <a href="/refonte/mentions-legales">Mentions légales</a>
  </div>
</footer>
