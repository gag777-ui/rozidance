---
import { prestations } from '../../data/refonte';
import { getTranslations, type Lang } from '../../i18n/utils';
import { localePath } from '../../i18n/refonte';

const {
  currentHref,
  eyebrow,
  title,
  lang = 'fr',
} = Astro.props as {
  currentHref: string;
  eyebrow: string;
  title: string;
  lang?: Lang;
};
const t = getTranslations(lang);
const localizedPrestations = prestations.map((item, index) => ({
  ...item,
  href: localePath(lang, item.href),
  title: t.prestations.items[index]?.title ?? item.title,
  kicker: t.prestations.eyebrow,
}));
const currentIndex = Math.max(0, localizedPrestations.findIndex((item) => item.href === currentHref));
const nextIndex = (currentIndex + 1) % localizedPrestations.length;
---

<section class="rf-service-bridge" id="service-bridge" data-service-bridge>
  <div class="rf-service-bridge__inner">
    <header class="rf-service-bridge__heading" data-reveal>
      <span class="rf-eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
    </header>

    <nav aria-label={eyebrow}>
      {localizedPrestations.map((item, index) => (
        <a
          class:list={[
            'rf-service-bridge__link',
            item.href === currentHref && 'is-current',
            index === nextIndex && 'is-next',
          ]}
          href={item.href}
          aria-current={item.href === currentHref ? 'page' : undefined}
          style={`--bridge-index:${index}`}
          data-reveal
        >
          <span class="rf-service-bridge__number">{String(index + 1).padStart(2, '0')}</span>
          <span class="rf-service-bridge__body">
            <span>{item.kicker}</span>
            <strong>{item.title}</strong>
            <span class="rf-service-bridge__cta">{t.mariages.cardCta}</span>
          </span>
          <i aria-hidden="true">→</i>
        </a>
      ))}
    </nav>
  </div>
</section>
