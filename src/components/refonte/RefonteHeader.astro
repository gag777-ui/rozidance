---
import { socials } from '../../data/refonte';
import { getTranslations, type Lang } from '../../i18n/utils';
import { languageSwitcherLabels, localePath, officialPath, refonteLangs } from '../../i18n/refonte';

const { chapter = 'Rozi Dance', lang = 'fr' } = Astro.props as { chapter?: string; lang?: Lang };
const t = getTranslations(lang);
const currentPath = officialPath(Astro.url.pathname);

const links = [
  { href: localePath(lang), label: 'Rozi Dance' },
  { href: localePath(lang, '/mariages'), label: t.prestations.items[0].title },
  { href: localePath(lang, '/chant'), label: t.prestations.items[1].title },
  { href: localePath(lang, '/cours'), label: t.nav.cours },
  { href: localePath(lang, '/galerie'), label: t.nav.galerie },
];
---

<header class="rf-header" data-rf-header>
  <div class="rf-header__identity">
    <a
      class="rf-brand"
      href={localePath(lang)}
      aria-label={t.footer.homeAria}
      data-rf-nav-link
      data-rf-home-link
    >
      <img src="/images/logo-transparent.png" alt="Rozi Dance" width="500" height="500" />
    </a>
    <span class="rf-header__chapter">{chapter}</span>
  </div>

  <nav class="rf-nav" aria-label={t.footer.nav}>
    {links.slice(1).map((link) => (
      <a href={link.href} data-rf-nav-link>{link.label}</a>
    ))}
  </nav>

  <div class="rf-header__actions">
    <a class="rf-header__instagram" href={socials.phone}>
      {t.hero.ctaPrimary}
      <span aria-hidden="true">↗</span>
    </a>
    <details class="rf-language-switcher">
      <summary aria-label={languageSwitcherLabels[lang]}>{lang.toUpperCase()}</summary>
      <div>
        {refonteLangs.map((language) => (
          <a
            href={localePath(language, currentPath)}
            lang={language}
            aria-current={language === lang ? 'page' : undefined}
          >
            {language.toUpperCase()}
          </a>
        ))}
      </div>
    </details>
    <button
      class="rf-menu-btn"
      type="button"
      aria-label={t.footer.nav}
      aria-expanded="false"
      aria-controls="rf-menu"
      data-rf-menu-btn
      data-navigation-label={t.footer.nav}
    >
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<div class="rf-menu" id="rf-menu" data-rf-menu aria-hidden="true" inert>
  <div class="rf-menu__wash" aria-hidden="true"></div>
  <nav aria-label={t.footer.nav}>
    {links.map((link, index) => (
      <a
        href={link.href}
        data-rf-nav-link
        data-rf-home-link={index === 0 ? true : undefined}
        style={`--menu-index:${index}`}
      >
        <span>{String(index + 1).padStart(2, '0')}</span>
        {link.label}
      </a>
    ))}
  </nav>
  <div class="rf-menu__socials">
    <a href={socials.instagram} target="_blank" rel="noopener noreferrer">@rozi.dance</a>
    <a href={socials.phone}>+32 486 21 98 96</a>
  </div>
</div>
