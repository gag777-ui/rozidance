---
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
import LanguageSwitcher from '../ui/LanguageSwitcher.astro';
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = getTranslations(lang);
const base = lang === 'fr' ? '' : `/${lang}`;
---

<header id="site-header" class="site-header">
  <div class="section-container header-inner">
    <!-- Logo -->
    <a href={base || '/'} class="logo" aria-label="Rozi Dance — accueil">
      <img
        src="/images/logo.webp"
        alt=""
        class="logo-img"
        width="76"
        height="76"
        loading="eager"
        decoding="async"
      />
      <span class="logo-text">Rozi <span class="logo-dot">·</span> Dance</span>
    </a>

    <!-- Nav desktop -->
    <nav class="nav-desktop" aria-label="Navigation principale">
      <ul>
        <li><a href={`${base || '/'}#prestations`} class="nav-link">{t.nav.prestations}</a></li>
        <li><a href={`${base || '/'}#galerie`} class="nav-link">{t.nav.galerie}</a></li>
        <li><a href={`${base}/cours`} class="nav-link">{t.nav.cours}</a></li>
        <li><a href={`${base || '/'}#apropos`} class="nav-link">{t.nav.apropos}</a></li>
        <li><a href={`${base || '/'}#contact`} class="nav-link nav-link-contact">{t.nav.contact}</a></li>
      </ul>
    </nav>

    <!-- Sélecteur de langue + hamburger groupés -->
    <div class="header-end">
      <LanguageSwitcher />
      <button
        id="menu-toggle"
        class="menu-toggle"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<!-- Backdrop semi-transparent derrière le drawer -->
<div id="menu-backdrop" class="menu-backdrop" aria-hidden="true"></div>

<!-- Drawer mobile depuis la droite -->
<nav id="mobile-menu" class="nav-mobile" aria-label="Menu mobile" aria-hidden="true">
  <div class="mobile-menu-inner">

    <!-- Liens nav -->
    <ul>
      <li><a href={`${base || '/'}#prestations`} class="mobile-nav-link">{t.nav.prestations}</a></li>
      <li><a href={`${base || '/'}#galerie`} class="mobile-nav-link">{t.nav.galerie}</a></li>
      <li><a href={`${base}/cours`} class="mobile-nav-link">{t.nav.cours}</a></li>
      <li><a href={`${base || '/'}#apropos`} class="mobile-nav-link">{t.nav.apropos}</a></li>
      <li><a href={`${base || '/'}#contact`} class="mobile-nav-link mobile-nav-contact">{t.nav.contact}</a></li>
    </ul>
  </div>
</nav>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 150;
    background-color: var(--color-bg-primary);
    border-bottom: 0.5px solid transparent;
    transition: border-color 300ms, backdrop-filter 300ms, background-color 300ms;
  }

  .site-header.scrolled {
    border-color: var(--color-border);
    backdrop-filter: blur(12px);
    background-color: rgba(247, 241, 230, 0.85);
  }

  /* Header ivoire quand le menu est ouvert */
  .site-header.menu-open {
    background-color: var(--color-bg-primary);
    border-bottom-color: transparent;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: clamp(1rem, 2.2vw, 1.6rem);
  }

  .logo {
    text-decoration: none;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .logo-img {
    display: block;
    width: 76px;
    height: 76px;
    object-fit: contain;
  }

  .logo-text {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 400;
    color: var(--color-text-primary);
    letter-spacing: 0.02em;
  }

  .logo-dot {
    color: var(--color-accent);
  }

  .nav-desktop ul {
    display: flex;
    align-items: center;
    gap: clamp(1.3rem, 2.3vw, 1.85rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link-contact {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0.34rem 0.82rem;
    border: 0.5px solid rgba(168, 135, 83, 0.28);
    border-radius: var(--radius-full);
    background:
      linear-gradient(135deg, rgba(255, 249, 239, 0.72), rgba(236, 216, 190, 0.22));
    box-shadow:
      0 10px 24px rgba(43, 31, 21, 0.055),
      inset 0 1px 0 rgba(255, 255, 255, 0.56);
    color: var(--color-charcoal);
    transform: translateZ(0);
  }

  .nav-link-contact::before {
    content: '';
    width: 5px;
    height: 5px;
    margin-right: 0.48rem;
    border-radius: 999px;
    background: rgba(168, 135, 83, 0.9);
    box-shadow: 0 0 0 4px rgba(168, 135, 83, 0.1);
  }

  .nav-link-contact::after {
    content: none;
  }

  .nav-link-contact:hover {
    border-color: rgba(168, 135, 83, 0.46);
    background:
      linear-gradient(135deg, rgba(255, 249, 239, 0.92), rgba(236, 216, 190, 0.34));
    box-shadow:
      0 14px 28px rgba(43, 31, 21, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.7);
  }

  .header-end {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
    margin-left: -0.55rem;
  }

  /* ── Hamburger ── */
  .menu-toggle {
    display: none;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 34px;
    background: rgba(251, 246, 236, 0.68);
    border: 0.5px solid rgba(168, 135, 83, 0.28);
    border-radius: var(--radius-full);
    padding: 0;
    cursor: pointer;
    z-index: 1;
    box-shadow:
      0 10px 26px rgba(43, 31, 21, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.45);
    transition:
      background-color 420ms var(--ease-standard),
      border-color 420ms var(--ease-standard),
      transform 420ms var(--ease-standard),
      box-shadow 420ms var(--ease-standard);
  }

  .menu-toggle span {
    display: block;
    width: 18px;
    height: 1px;
    background-color: var(--color-text-primary);
    transition: transform 350ms var(--ease-out-soft), opacity 250ms, width 350ms var(--ease-out-soft), background-color 350ms var(--ease-out-soft);
    transform-origin: center;
  }

  .menu-toggle span:nth-child(2) {
    width: 12px;
  }

  .menu-toggle:hover {
    background: rgba(251, 246, 236, 0.9);
    border-color: rgba(168, 135, 83, 0.44);
    transform: translateY(-1px);
    box-shadow:
      0 14px 30px rgba(43, 31, 21, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.58);
  }

  .menu-toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .menu-toggle[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
    width: 0;
  }
  .menu-toggle[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .menu-backdrop { display: none; }

  /* ── Overlay plein écran ── */
  .nav-mobile {
    position: fixed;
    inset: 0;
    z-index: 140;
    background:
      radial-gradient(circle at 50% 0%, rgba(168, 135, 83, 0.12), transparent 34%),
      rgba(247, 241, 230, 0.78);
    backdrop-filter: blur(22px) saturate(1.25);
    -webkit-backdrop-filter: blur(22px) saturate(1.25);

    opacity: 0;
    pointer-events: none;
    transition: opacity 420ms var(--ease-out-soft);
  }

  .nav-mobile::before {
    content: '';
    position: absolute;
    inset: 86px 18px 18px;
    border: 0.5px solid rgba(168, 135, 83, 0.2);
    border-radius: 28px;
    pointer-events: none;
  }

  .nav-mobile::after {
    content: '';
    position: absolute;
    inset: auto 42px 28px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(168, 135, 83, 0.44), transparent);
    pointer-events: none;
  }

  .nav-mobile.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-menu-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    height: 100%;
    gap: 0;
    padding: 96px 2rem 34px;
  }

  .nav-mobile ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
  }

  .mobile-nav-link {
    font-family: var(--font-serif);
    font-size: clamp(1.78rem, 8.6vw, 2.7rem);
    color: var(--color-text-primary);
    text-decoration: none;
    letter-spacing: 0;
    display: block;
    text-align: center;
    padding: 0.82rem 0;
    border-bottom: 0.5px solid rgba(168, 135, 83, 0.18);

    opacity: 0;
    transform: translateY(24px);
    filter: blur(5px);
    transition: color 220ms,
                transform 420ms cubic-bezier(0.34, 1.4, 0.64, 1),
                opacity 400ms var(--ease-out-soft),
                filter 400ms var(--ease-out-soft);
  }

  .nav-mobile ul li:first-child .mobile-nav-link {
    border-top: 0.5px solid rgba(168, 135, 83, 0.18);
  }

  .mobile-nav-link:hover {
    color: var(--color-gold-hover);
  }

  .mobile-nav-contact {
    width: max-content;
    min-width: min(220px, 78vw);
    margin: 0.92rem auto 0;
    padding: 0.86rem 1.25rem;
    border: 0.5px solid rgba(168, 135, 83, 0.3);
    border-radius: var(--radius-full);
    background:
      linear-gradient(135deg, rgba(255, 249, 239, 0.78), rgba(236, 216, 190, 0.24));
    box-shadow:
      0 14px 32px rgba(43, 31, 21, 0.07),
      inset 0 1px 0 rgba(255, 255, 255, 0.55);
    font-family: var(--font-sans);
    font-size: clamp(0.88rem, 4vw, 1.05rem);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .nav-mobile.is-open .mobile-nav-link {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  .nav-mobile.is-open li:nth-child(1) .mobile-nav-link { transition-delay: 80ms; }
  .nav-mobile.is-open li:nth-child(2) .mobile-nav-link { transition-delay: 140ms; }
  .nav-mobile.is-open li:nth-child(3) .mobile-nav-link { transition-delay: 200ms; }
  .nav-mobile.is-open li:nth-child(4) .mobile-nav-link { transition-delay: 260ms; }
  .nav-mobile.is-open li:nth-child(5) .mobile-nav-link { transition-delay: 320ms; }

  @media (max-width: 768px) {
    .nav-desktop {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }
  }

  /* Sur desktop : jamais d'overlay */
  @media (min-width: 769px) {
    .nav-mobile {
      display: none !important;
    }
  }
</style>

<script>
  let headerScrollHandler: (() => void) | null = null;

  function initHeader() {
    if (headerScrollHandler) {
      window.removeEventListener('scroll', headerScrollHandler);
    }

    const header = document.getElementById('site-header');
    const toggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const backdrop = document.getElementById('menu-backdrop');

    headerScrollHandler = () => {
      header?.classList.toggle('scrolled', window.scrollY > 40);
    };
    window.addEventListener('scroll', headerScrollHandler, { passive: true });
    headerScrollHandler();

    function openMenu() {
      mobileMenu?.classList.add('is-open');
      backdrop?.classList.add('is-open');
      mobileMenu?.setAttribute('aria-hidden', 'false');
      toggle?.setAttribute('aria-expanded', 'true');
      toggle?.setAttribute('aria-label', 'Fermer le menu');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      mobileMenu?.classList.remove('is-open');
      backdrop?.classList.remove('is-open');
      mobileMenu?.setAttribute('aria-hidden', 'true');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Ouvrir le menu');
      document.body.style.overflow = '';
    }

    toggle?.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      isOpen ? closeMenu() : openMenu();
    });

    backdrop?.addEventListener('click', closeMenu);

    mobileMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    // Ferme au swipe vers le haut (UX mobile)
    let touchStartY = 0;
    mobileMenu?.addEventListener('touchstart', (e) => {
      touchStartY = e.touches[0].clientY;
    }, { passive: true });
    mobileMenu?.addEventListener('touchend', (e) => {
      if (touchStartY - e.changedTouches[0].clientY > 60) closeMenu();
    }, { passive: true });
  }

  document.addEventListener('astro:page-load', initHeader);
</script>
