---
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = getTranslations(lang);
const year = new Date().getFullYear();
const base = lang === 'fr' ? '' : `/${lang}`;
---

<footer class="site-footer">
  <!-- Geometric pattern watermark (SVG inline) -->
  <div class="footer-pattern" aria-hidden="true">
    <svg viewBox="0 0 400 200" xmlns="http://www.w3.org/2000/svg" class="footer-pattern-svg">
      <!-- Armenian carpet geometric motif — border & diamonds -->
      <g fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.12">
        <line x1="0" y1="140" x2="400" y2="140" />
        <line x1="0" y1="145" x2="400" y2="145" />
        <rect x="20" y="155" width="8" height="8" transform="rotate(45 24 159)" />
        <rect x="50" y="155" width="8" height="8" transform="rotate(45 54 159)" />
        <rect x="80" y="155" width="8" height="8" transform="rotate(45 84 159)" />
        <rect x="110" y="155" width="8" height="8" transform="rotate(45 114 159)" />
        <rect x="140" y="155" width="8" height="8" transform="rotate(45 144 159)" />
        <rect x="170" y="155" width="8" height="8" transform="rotate(45 174 159)" />
        <rect x="200" y="155" width="8" height="8" transform="rotate(45 204 159)" />
        <rect x="230" y="155" width="8" height="8" transform="rotate(45 234 159)" />
        <rect x="260" y="155" width="8" height="8" transform="rotate(45 264 159)" />
        <rect x="290" y="155" width="8" height="8" transform="rotate(45 294 159)" />
        <rect x="320" y="155" width="8" height="8" transform="rotate(45 324 159)" />
        <rect x="350" y="155" width="8" height="8" transform="rotate(45 354 159)" />
        <rect x="380" y="155" width="8" height="8" transform="rotate(45 384 159)" />
      </g>
    </svg>
  </div>

  <div class="section-container footer-inner">
    <!-- Logo + tagline -->
    <div class="footer-brand">
      <a href={base || '/'} class="footer-logo" aria-label={t.footer.homeAria}>
        <img src="/images/logo-footer.webp" alt="Rozi Dance" class="footer-logo-img" width="500" height="500" loading="lazy" decoding="async" />
      </a>
      <p class="footer-tagline">{t.footer.tagline}</p>
    </div>

    <!-- Navigation + Liens sociaux -->
    <div class="footer-links-group">
      <nav class="footer-nav" aria-label={t.footer.nav}>
        <p class="footer-nav-title">{t.footer.nav}</p>
        <ul>
          <li><a href={`${base || '/'}#prestations`} class="nav-link">{t.nav.prestations}</a></li>
          <li><a href={`${base || '/'}#galerie`} class="nav-link">{t.nav.galerie}</a></li>
          <li><a href={`${base}/cours`} class="nav-link">{t.nav.cours}</a></li>
          <li><a href={`${base || '/'}#apropos`} class="nav-link">{t.nav.apropos}</a></li>
          <li><a href={`${base || '/'}#contact`} class="nav-link">{t.nav.contact}</a></li>
        </ul>
      </nav>

      <div class="footer-social">
        <p class="footer-nav-title">{t.footer.links}</p>
        <ul>
          <li>
            <a href="https://instagram.com/rozi.dance" target="_blank" rel="noopener noreferrer" class="nav-link">
              Instagram
            </a>
          </li>
          <li>
            <a href="https://www.youtube.com/@luarozihayband" target="_blank" rel="noopener noreferrer" class="nav-link">
              YouTube
            </a>
          </li>
          <li>
            <a href="mailto:abrahamyan.rose@mail.ru" class="nav-link">
              abrahamyan.rose@mail.ru
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <div class="section-container footer-bottom-inner">
      <div class="footer-bottom-row">
        <p>{t.footer.copyright.replace('{year}', String(year))}</p>
        <a href={`${base}/mentions-legales`} class="nav-link footer-legal">{t.footer.legal}</a>
      </div>
      <a href="https://synaplink.be" target="_blank" rel="noopener noreferrer" class="footer-synaplink">
        {t.footer.poweredBy} <span class="footer-synaplink-name">Synap'Link</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    margin-top: -8px;
    padding-top: clamp(3.4rem, 7vw, 5.2rem);
    color: rgba(255, 248, 238, 0.74);
    background:
      radial-gradient(ellipse at 16% 12%, rgba(168, 135, 83, 0.18), transparent 35%),
      radial-gradient(ellipse at 88% 88%, rgba(135, 144, 115, 0.12), transparent 42%),
      linear-gradient(180deg, #2b1f15 0%, #211711 46%, #1c1410 100%),
      #1c1410;
    box-shadow: 0 100vh 0 100vh #1c1410;
  }

  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: clamp(90px, 13vw, 150px);
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(241, 223, 202, 0.38) 0%, rgba(43, 31, 21, 0.72) 48%, rgba(43, 31, 21, 0) 100%);
    mix-blend-mode: normal;
    z-index: 0;
  }

  .footer-pattern {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.32;
  }

  .footer-pattern-svg {
    width: 100%;
    height: 100%;
    color: rgba(255, 248, 238, 0.42);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(2.2rem, 6vw, 4.8rem);
    padding-bottom: clamp(2.2rem, 5vw, 3.5rem);
    position: relative;
    z-index: 1;
  }

  .footer-links-group {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .footer-logo {
    text-decoration: none;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .footer-logo-img {
    width: 56px;
    height: 56px;
    object-fit: contain;
    display: block;
    border-radius: 16px;
    background-color: #FBF4EA;
    box-shadow:
      0 14px 34px rgba(43, 31, 21, 0.18),
      0 0 0 1px rgba(255, 248, 238, 0.22);
  }

  @media (min-width: 769px) {
    .footer-logo-img {
      width: 72px;
      height: 72px;
    }
  }

  .footer-logo-text {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 400;
    color: #fff8ee;
    letter-spacing: 0.02em;
  }

  .footer-logo-dot {
    color: var(--color-accent);
  }

  .footer-tagline {
    font-size: 0.875rem;
    color: rgba(255, 248, 238, 0.7);
    line-height: 1.6;
    max-width: 27ch;
    margin: 0;
  }

  .footer-nav-title {
    font-size: 11px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(255, 232, 190, 0.82);
    margin: 0 0 1rem;
  }

  .footer-nav ul,
  .footer-social ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.72rem;
  }

  .footer-nav .nav-link,
  .footer-social .nav-link {
    color: rgba(255, 248, 238, 0.7);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .footer-nav .nav-link:hover,
  .footer-social .nav-link:hover {
    color: #fff8ee;
  }

  .footer-nav .nav-link::after,
  .footer-social .nav-link::after {
    background-color: rgba(255, 232, 190, 0.72);
  }

  .footer-bottom {
    border-top: 0.5px solid rgba(255, 248, 238, 0.1);
    padding-block: 1.15rem;
    position: relative;
    z-index: 1;
    background: rgba(28, 20, 16, 0.24);
  }

  .footer-bottom-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-size: 12px;
    color: rgba(255, 248, 238, 0.64);
  }

  .footer-bottom-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 1rem;
  }

  .footer-legal {
    color: rgba(255, 248, 238, 0.64);
    font-size: 12px;
    white-space: nowrap;
  }

  .footer-synaplink {
    font-size: 12px;
    color: rgba(255, 248, 238, 0.64);
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 220ms;
  }
  .footer-synaplink:hover { opacity: 1; }
  .footer-synaplink-name { color: #7EB8C9; }

  @media (max-width: 768px) {
    .site-footer {
      padding-top: 3.15rem;
    }

    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-bottom: 2rem;
      text-align: left;
    }

    .footer-brand {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-logo {
      margin-bottom: 0.85rem;
    }

    .footer-tagline {
      max-width: 24ch;
      font-size: 0.92rem;
      line-height: 1.55;
    }

    .footer-links-group {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(1.2rem, 7vw, 2.1rem);
      text-align: left;
      align-items: start;
    }

    .footer-nav,
    .footer-social {
      min-width: 0;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
    }

    .footer-nav-title {
      margin-bottom: 0.85rem;
      font-size: 10px;
      letter-spacing: 0.2em;
    }

    .footer-nav ul,
    .footer-social ul {
      gap: 0.55rem;
    }

    .footer-nav .nav-link,
    .footer-social .nav-link {
      display: inline-block;
      max-width: 100%;
      font-size: 0.86rem;
      overflow-wrap: anywhere;
      word-break: normal;
    }

    .footer-bottom-row {
      flex-direction: column;
      justify-content: center;
      text-align: center;
      gap: 0.35rem;
    }
  }

  @media (max-width: 430px) {
    .footer-links-group {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
      gap: 1rem;
    }

    .footer-nav,
    .footer-social {
      text-align: left;
      padding: 0;
    }

    .footer-social .nav-link[href^="mailto:"] {
      font-size: clamp(0.66rem, 3.2vw, 0.78rem);
      line-height: 1.35;
    }
  }
</style>
