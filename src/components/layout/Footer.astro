---
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = getTranslations(lang);
const year = new Date().getFullYear();
const base = lang === 'fr' ? '' : `/${lang}`;
---

<footer class="site-footer">
  <!-- Geometric pattern watermark (SVG inline) -->
  <div class="footer-pattern" aria-hidden="true">
    <svg viewBox="0 0 400 200" xmlns="http://www.w3.org/2000/svg" class="footer-pattern-svg">
      <!-- Armenian carpet geometric motif — border & diamonds -->
      <g fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.12">
        <line x1="0" y1="140" x2="400" y2="140" />
        <line x1="0" y1="145" x2="400" y2="145" />
        <rect x="20" y="155" width="8" height="8" transform="rotate(45 24 159)" />
        <rect x="50" y="155" width="8" height="8" transform="rotate(45 54 159)" />
        <rect x="80" y="155" width="8" height="8" transform="rotate(45 84 159)" />
        <rect x="110" y="155" width="8" height="8" transform="rotate(45 114 159)" />
        <rect x="140" y="155" width="8" height="8" transform="rotate(45 144 159)" />
        <rect x="170" y="155" width="8" height="8" transform="rotate(45 174 159)" />
        <rect x="200" y="155" width="8" height="8" transform="rotate(45 204 159)" />
        <rect x="230" y="155" width="8" height="8" transform="rotate(45 234 159)" />
        <rect x="260" y="155" width="8" height="8" transform="rotate(45 264 159)" />
        <rect x="290" y="155" width="8" height="8" transform="rotate(45 294 159)" />
        <rect x="320" y="155" width="8" height="8" transform="rotate(45 324 159)" />
        <rect x="350" y="155" width="8" height="8" transform="rotate(45 354 159)" />
        <rect x="380" y="155" width="8" height="8" transform="rotate(45 384 159)" />
      </g>
    </svg>
  </div>

  <div class="section-container footer-inner">
    <!-- Logo + tagline -->
    <div class="footer-brand">
      <a href={base || '/'} class="footer-logo" aria-label="Rozi · Dance — accueil">
        <img src="/images/logo-footer.webp" alt="Rozi Dance" class="footer-logo-img" width="500" height="500" loading="lazy" decoding="async" />
      </a>
      <p class="footer-tagline">{t.footer.tagline}</p>
    </div>

    <!-- Navigation + Liens sociaux -->
    <div class="footer-links-group">
      <nav class="footer-nav" aria-label="Navigation footer">
        <p class="footer-nav-title">{t.footer.nav}</p>
        <ul>
          <li><a href={`${base || '/'}#prestations`} class="nav-link">{t.nav.prestations}</a></li>
          <li><a href={`${base || '/'}#galerie`} class="nav-link">{t.nav.galerie}</a></li>
          <li><a href={`${base}/cours`} class="nav-link">{t.nav.cours}</a></li>
          <li><a href={`${base || '/'}#apropos`} class="nav-link">{t.nav.apropos}</a></li>
          <li><a href={`${base || '/'}#contact`} class="nav-link">{t.nav.contact}</a></li>
        </ul>
      </nav>

      <div class="footer-social">
        <p class="footer-nav-title">{t.footer.links}</p>
        <ul>
          <li>
            <a href="https://instagram.com/rozi.dance" target="_blank" rel="noopener noreferrer" class="nav-link">
              Instagram
            </a>
          </li>
          <li>
            <a href="https://youtube.com/@rozidance" target="_blank" rel="noopener noreferrer" class="nav-link">
              YouTube
            </a>
          </li>
          <li>
            <a href="mailto:abrahamyan.rose@mail.ru" class="nav-link">
              abrahamyan.rose@mail.ru
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <div class="section-container footer-bottom-inner">
      <div class="footer-bottom-row">
        <p>{t.footer.copyright.replace('{year}', String(year))}</p>
        <a href={`${base}/mentions-legales`} class="nav-link footer-legal">{t.footer.legal}</a>
      </div>
      <a href="https://synaplink.be" target="_blank" rel="noopener noreferrer" class="footer-synaplink">
        Propulsé par <span class="footer-synaplink-name">Synap'Link</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    margin-top: -8px;
    padding-top: 3.4rem;
    color: rgba(255, 248, 238, 0.74);
    background:
      radial-gradient(ellipse at 12% 0%, rgba(255, 248, 238, 0.12), transparent 34%),
      radial-gradient(ellipse at 88% 92%, rgba(135, 144, 115, 0.14), transparent 38%),
      linear-gradient(180deg, #d8c2a8 0%, #8b755f 42%, #5f4b3c 100%);
  }

  .footer-pattern {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.42;
  }

  .footer-pattern-svg {
    width: 100%;
    height: 100%;
    color: rgba(255, 248, 238, 0.42);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 3rem;
    padding-bottom: 2.6rem;
    position: relative;
    z-index: 1;
  }

  .footer-links-group {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
  }

  .footer-logo {
    text-decoration: none;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .footer-logo-img {
    width: 56px;
    height: 56px;
    object-fit: contain;
    display: block;
    border-radius: 16px;
    background-color: #F7F1E6;
    box-shadow:
      0 14px 34px rgba(43, 31, 21, 0.18),
      0 0 0 1px rgba(255, 248, 238, 0.22);
  }

  @media (min-width: 769px) {
    .footer-logo-img {
      width: 72px;
      height: 72px;
    }
  }

  .footer-logo-text {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 400;
    color: #fff8ee;
    letter-spacing: 0.02em;
  }

  .footer-logo-dot {
    color: var(--color-accent);
  }

  .footer-tagline {
    font-size: 0.875rem;
    color: rgba(255, 248, 238, 0.7);
    line-height: 1.6;
  }

  .footer-nav-title {
    font-size: 11px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(255, 232, 190, 0.82);
    margin-bottom: 1rem;
  }

  .footer-nav ul,
  .footer-social ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer-nav .nav-link,
  .footer-social .nav-link {
    color: rgba(255, 248, 238, 0.7);
    font-size: 0.875rem;
  }

  .footer-nav .nav-link:hover,
  .footer-social .nav-link:hover {
    color: #fff8ee;
  }

  .footer-nav .nav-link::after,
  .footer-social .nav-link::after {
    background-color: rgba(255, 232, 190, 0.72);
  }

  .footer-bottom {
    border-top: 0.5px solid rgba(255, 248, 238, 0.14);
    padding-block: 1.25rem;
    position: relative;
    z-index: 1;
  }

  .footer-bottom-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-size: 12px;
    color: rgba(255, 248, 238, 0.64);
  }

  .footer-bottom-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 1rem;
  }

  .footer-legal {
    color: rgba(255, 248, 238, 0.64);
    font-size: 12px;
    white-space: nowrap;
  }

  .footer-synaplink {
    font-size: 12px;
    color: rgba(255, 248, 238, 0.64);
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 220ms;
  }
  .footer-synaplink:hover { opacity: 1; }
  .footer-synaplink-name { color: #7EB8C9; }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

  }
</style>
