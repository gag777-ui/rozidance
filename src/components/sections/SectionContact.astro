---
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = getTranslations(lang);
---

<section id="contact" class="section-contact" aria-labelledby="contact-title">
  <div class="section-container contact-shell">
    <div class="contact-panel">
      <div class="section-header reveal-fade">
        <span class="eyebrow">{t.contact.eyebrow}</span>
        <h2 class="section-title" id="contact-title">{t.contact.title}</h2>
        <p class="contact-subtitle">{t.contact.subtitle}</p>
      </div>

      <div class="contact-cards">

      <!-- Instagram -->
      <a
        href="https://instagram.com/rozi.dance"
        target="_blank"
        rel="noopener noreferrer"
        class="contact-card reveal-scale"
        aria-label="Nous contacter sur Instagram @rozi.dance"
        style="transition-delay: 0ms"
      >
        <div class="card-body">
          <div class="card-icon card-icon-instagram" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <defs>
                <linearGradient id="ig-grad" x1="0%" y1="100%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#feda75"/>
                  <stop offset="25%" stop-color="#fa7e1e"/>
                  <stop offset="55%" stop-color="#d62976"/>
                  <stop offset="80%" stop-color="#962fbf"/>
                  <stop offset="100%" stop-color="#4f5bd5"/>
                </linearGradient>
              </defs>
              <rect x="2" y="2" width="20" height="20" rx="5" stroke="url(#ig-grad)"/>
              <circle cx="12" cy="12" r="4.5" stroke="url(#ig-grad)"/>
              <circle cx="17.5" cy="6.5" r="0.5" fill="url(#ig-grad)" stroke="none"/>
            </svg>
          </div>
          <p class="card-label">{t.contact.instagram.label}</p>
          <p class="card-value">{t.contact.instagram.handle}</p>
          <span class="card-link">
            {t.contact.instagram.label}
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" class="card-arrow-svg">
              <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>
      </a>

      <!-- Email -->
      <a
        href="mailto:abrahamyan.rose@mail.ru"
        class="contact-card reveal-scale"
        aria-label="Nous envoyer un e-mail à abrahamyan.rose@mail.ru"
        style="transition-delay: 120ms"
      >
        <div class="card-body">
          <div class="card-icon card-icon-email" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="M2 7l10 7 10-7"/>
            </svg>
          </div>
          <p class="card-label">{t.contact.email.label}</p>
          <p class="card-value">{t.contact.email.address}</p>
          <span class="card-link">
            {t.contact.email.label}
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" class="card-arrow-svg">
              <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>
      </a>

      <!-- Téléphone -->
      <a
        href="tel:+32486219896"
        class="contact-card reveal-scale"
        aria-label="Appeler le +32 486 21 98 96"
        style="transition-delay: 240ms"
      >
        <div class="card-body">
          <div class="card-icon card-icon-phone" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.09 10.8 19.79 19.79 0 01.07 2.18 2 2 0 012.06 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
            </svg>
          </div>
          <p class="card-label">Téléphone</p>
          <p class="card-value">+32 486 21 98 96</p>
          <span class="card-link">
            Appeler
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" class="card-arrow-svg">
              <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>
      </a>

      </div>
    </div>
  </div>
</section>

<style>
  .section-contact {
    position: relative;
    overflow: clip;
    margin-top: -8px;
    padding-block: 56px 72px;
    background:
      radial-gradient(ellipse at 16% 12%, rgba(168, 135, 83, 0.055), transparent 34%),
      radial-gradient(ellipse at 88% 88%, rgba(135, 144, 115, 0.05), transparent 36%),
      linear-gradient(180deg, #fff8ee 0%, #f6e8d7 34%, #fffaf1 66%, #f1dfca 100%);
  }

  .contact-shell {
    position: relative;
  }

  .contact-panel {
    position: relative;
    overflow: hidden;
    padding: clamp(0.5rem, 3.2vw, 1.4rem) 0 0;
    border: 0;
    border-radius: 0;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(255, 248, 238, 0.58), transparent 46%);
    box-shadow: none;
  }

  .contact-panel::before {
    content: none;
  }

  .contact-panel::after {
    content: '';
    position: absolute;
    top: -40%;
    right: -18%;
    width: 42%;
    height: 92%;
    pointer-events: none;
    border-radius: 999px;
    background: rgba(168, 135, 83, 0.06);
    filter: blur(22px);
    transform: rotate(-18deg);
  }

  .section-header,
  .contact-cards {
    position: relative;
    z-index: 1;
  }

  .section-header {
    text-align: center;
    margin-bottom: 2.2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }

  .section-header .eyebrow {
    color: rgba(122, 92, 32, 0.82);
  }

  .section-title {
    max-width: 10ch;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 11vw, 6.4rem);
    font-weight: 300;
    line-height: 0.92;
    letter-spacing: 0;
    color: var(--color-charcoal);
    margin: 0;
    text-wrap: balance;
  }

  .contact-subtitle {
    font-size: clamp(0.95rem, 2vw, 1.05rem);
    color: rgba(107, 86, 69, 0.78);
    margin: 0;
    max-width: 46ch;
    text-align: center;
    line-height: 1.65;
  }

  .contact-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .contact-card {
    position: relative;
    isolation: isolate;
    background:
      linear-gradient(145deg, rgba(255, 250, 241, 0.82), rgba(245, 232, 211, 0.52));
    border: 0.5px solid rgba(168, 135, 83, 0.2);
    border-radius: 24px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 16px 42px rgba(68, 43, 25, 0.08);
    transition:
      transform 400ms var(--ease-out-soft),
      border-color 400ms var(--ease-out-soft),
      background 400ms var(--ease-out-soft),
      box-shadow 400ms var(--ease-out-soft);
  }

  .contact-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(120deg, transparent 0%, rgba(168, 135, 83, 0.12) 48%, transparent 62%);
    opacity: 0;
    transform: translateX(-45%);
    transition:
      opacity 420ms var(--ease-out-soft),
      transform 720ms var(--ease-out-soft);
  }

  .card-body {
    padding: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.78rem;
    flex: 1;
    position: relative;
  }

  .card-icon {
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    display: flex;
    flex-shrink: 0;
    border: 0.5px solid rgba(168, 135, 83, 0.22);
    border-radius: 50%;
    background: rgba(255, 248, 238, 0.58);
  }

  .card-icon-email {
    color: #EA4335;
  }

  .card-icon-phone {
    color: #34A853;
  }

  .card-label {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(122, 92, 32, 0.82);
    margin: 0;
    font-family: var(--font-sans);
  }

  .card-value {
    font-family: var(--font-serif);
    font-size: clamp(1rem, 2vw, 1.18rem);
    color: var(--color-charcoal);
    margin: 0;
    flex: 1;
    line-height: 1.4;
    word-break: break-all;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #879073;
    margin-top: 0.25rem;
    transition: gap 250ms var(--ease-out-soft);
  }

  .card-arrow-svg {
    flex-shrink: 0;
    transition: transform 250ms var(--ease-out-soft);
  }

  @media (hover: hover) {
    .contact-card:hover {
      transform: translateY(-5px);
      border-color: rgba(232, 216, 190, 0.34);
      background:
        linear-gradient(145deg, rgba(255, 250, 241, 0.96), rgba(245, 232, 211, 0.72));
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.13),
        0 24px 56px rgba(68, 43, 25, 0.12);
    }

    .contact-card:hover::before {
      opacity: 1;
      transform: translateX(34%);
    }

    .contact-card:hover .card-link {
      gap: 0.75rem;
    }

    .contact-card:hover .card-arrow-svg {
      transform: translateX(3px);
    }
  }

  @media (max-width: 768px) {
    .section-contact {
      padding-block: 46px 60px;
    }

    .contact-panel {
      border-radius: 28px;
      padding: 1.2rem;
    }

    .contact-panel::before {
      inset: 10px;
      border-radius: 21px;
    }

    .contact-cards {
      grid-template-columns: 1fr;
      max-width: 390px;
      margin-inline: auto;
      gap: 0.75rem;
    }

    .card-body {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      column-gap: 0.9rem;
      row-gap: 0.38rem;
      padding: 1rem;
    }

    .card-icon {
      grid-row: span 3;
    }

    .card-link {
      margin-top: 0;
    }
  }

  @media (min-width: 600px) and (max-width: 768px) {
    .contact-cards {
      grid-template-columns: repeat(2, 1fr);
      max-width: 100%;
    }

    .card-body {
      display: flex;
      align-items: flex-start;
    }
  }
</style>
