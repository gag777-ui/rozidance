---
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = getTranslations(lang);
const base = lang === 'fr' ? '' : `/${lang}`;

const categories = ['Mariage · Cérémonie', 'Chant · Performance', 'Cours · Atelier'] as const;
const badges = ['Cérémonie', 'Live', 'Atelier'] as const;
const cardImages = [
  '/images/mariages-hero.webp',
  '/images/chant-hero.webp',
  '/images/cours-hero.webp',
] as const;

function getHref(id: string) {
  if (id === 'mariages') return `${base}/mariages`;
  if (id === 'danse-evenementielle') return `${base}/chant`;
  if (id === 'cours') return `${base}/cours`;
  return `${base || '/'}#contact`;
}

function splitTitle(title: string) {
  return title.split(' ').filter(Boolean);
}
---

<section id="prestations" class="section-prestations" aria-labelledby="prestations-title">
  <div class="section-container">
    <div class="prestations-head section-header reveal-fade">
      <span class="eyebrow">{t.prestations.eyebrow}</span>
      <h2 class="section-title" id="prestations-title">{t.prestations.title}</h2>
      <p class="prestations-subtitle">{t.hero.subtitle}</p>
    </div>

    <div class="prestations-couture">
      {t.prestations.items.map((item, i) => (
        <a class="prestation-card" href={getHref(item.id)} aria-label={item.title}>
          <div class="prestation-photo">
            <img
              src={cardImages[i]}
              alt=""
              loading="lazy"
              decoding="async"
            />
            <span class="prestation-badge">{badges[i]}</span>
          </div>

          <div class="prestation-copy">
            <span class="prestation-tag">{categories[i]}</span>
            <h3 class="prestation-title">
              {splitTitle(item.title).map((word) => (
                <span class="title-mask"><span class="title-line">{word}</span></span>
              ))}
            </h3>
            <p class="prestation-desc">{item.description}</p>
            <span class="prestation-cta">
              <span>{item.link}</span>
              <span class="cta-icon" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 15 15" fill="none">
                  <path
                    d="M2 7.5h10.5M8.5 3.5l4 4-4 4"
                    stroke="currentColor"
                    stroke-width="1.35"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .section-prestations {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: 64px 72px;
    background:
      radial-gradient(circle at 88% 8%, rgba(135, 144, 115, 0.11), transparent 26%),
      radial-gradient(circle at 10% 86%, rgba(168, 135, 83, 0.1), transparent 30%),
      linear-gradient(90deg, rgba(168, 135, 83, 0.05) 0 1px, transparent 1px 100%),
      linear-gradient(180deg, #fff8ee 0%, #faecdc 42%, #f0dcc8 100%);
    background-size: auto, auto, 100% 88px, auto;
  }

  .section-prestations::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.36;
    background:
      linear-gradient(135deg, transparent 0 44%, rgba(135, 144, 115, 0.14) 44% 45%, transparent 45% 100%),
      linear-gradient(135deg, transparent 0 60%, rgba(168, 135, 83, 0.11) 60% 61%, transparent 61% 100%);
  }

  .section-prestations::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    z-index: 0;
    height: 92px;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 0%, rgba(240, 220, 200, 0.68) 54%, #f0dcc8 100%);
  }

  .section-prestations > .section-container {
    position: relative;
    z-index: 1;
  }

  .prestations-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    max-width: 680px;
    margin-bottom: 22px;
    text-align: left;
  }

  .prestations-head .section-title {
    max-width: 8.5ch;
    margin: 0;
    color: var(--color-charcoal);
    font-size: clamp(2.55rem, 12vw, 4.7rem);
    line-height: 0.88;
    letter-spacing: 0;
  }

  .prestations-subtitle {
    max-width: 31ch;
    margin: 4px 0 0;
    color: var(--color-taupe);
    font-size: 14px;
    font-style: italic;
    line-height: 1.56;
    text-align: left;
  }

  .prestations-couture {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 16px;
  }

  .prestation-card {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
    color: var(--color-charcoal);
    text-decoration: none;
    border: 0.5px solid rgba(135, 144, 115, 0.24);
    border-radius: 26px;
    background:
      linear-gradient(145deg, rgba(255, 249, 239, 0.96), rgba(236, 216, 190, 0.78));
    box-shadow:
      0 18px 48px rgba(58, 35, 21, 0.13),
      inset 0 1px 0 rgba(255, 255, 255, 0.82);
    transition:
      opacity 880ms var(--ease-standard),
      transform 880ms var(--ease-standard),
      filter 880ms var(--ease-standard),
      box-shadow 640ms var(--ease-standard);
  }

  .prestation-card::before {
    content: '';
    position: absolute;
    inset: 6px;
    z-index: 2;
    pointer-events: none;
    border: 0.5px solid rgba(255, 255, 255, 0.62);
    border-radius: 20px;
  }

  .prestation-card:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 4px;
  }

  .prestation-card:active {
    transform: scale(0.986);
  }

  .prestation-photo {
    position: relative;
    min-height: 205px;
    overflow: hidden;
    margin: 6px 6px 0;
    border-radius: 20px 20px 10px 10px;
    background: var(--color-dark);
  }

  .prestation-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.025);
    backface-visibility: hidden;
    transition: transform 1100ms var(--ease-standard);
    will-change: transform;
  }

  .prestation-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, transparent 35%, rgba(37, 23, 15, 0.5)),
      linear-gradient(120deg, rgba(135, 144, 115, 0.2), transparent 58%);
  }

  .prestation-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 1;
    padding: 7px 10px;
    color: var(--color-ivory-card);
    border: 0.5px solid rgba(255, 249, 239, 0.42);
    border-radius: var(--radius-full);
    background: rgba(37, 23, 15, 0.48);
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .prestation-copy {
    display: grid;
    align-content: center;
    gap: 8px;
    padding: 15px 16px 17px;
  }

  .prestation-tag {
    color: #7a653e;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.17em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .prestation-title {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.16em;
    row-gap: 0.03em;
    max-width: 100%;
    margin: 0;
    color: var(--color-charcoal);
    font-family: var(--font-serif);
    font-size: clamp(1.7rem, 7.6vw, 3.35rem);
    font-weight: 300;
    line-height: 0.96;
    letter-spacing: 0;
  }

  .title-mask {
    display: inline-block;
    overflow: hidden;
  }

  .title-line {
    display: block;
  }

  .prestation-desc {
    max-width: 34ch;
    margin: 0;
    color: var(--color-taupe);
    font-family: var(--font-sans);
    font-size: 13.5px;
    line-height: 1.52;
  }

  .prestation-cta {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    margin-top: 4px;
    padding: 5px 5px 5px 14px;
    color: var(--color-charcoal);
    border: 0.5px solid rgba(135, 144, 115, 0.3);
    border-radius: var(--radius-full);
    background: rgba(135, 144, 115, 0.12);
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .cta-icon {
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    color: var(--color-ivory-card);
    border-radius: var(--radius-full);
    background: #879073;
    transition: transform 560ms var(--ease-standard);
  }

  .section-prestations.is-motion-ready .prestation-card {
    opacity: 0;
    filter: blur(4px);
    transform: translate3d(0, 22px, 0) scale(0.992);
  }

  .section-prestations.is-motion-ready .prestation-card:nth-child(odd) {
    transform: translate3d(0, 22px, 0) scale(0.992);
  }

  .section-prestations.is-motion-ready .prestation-card:nth-child(even) {
    transform: translate3d(0, 22px, 0) scale(0.992);
  }

  .section-prestations.is-motion-ready .prestation-card.is-visible {
    opacity: 1;
    filter: blur(0);
    transform: translate3d(0, 0, 0) scale(1);
  }

  .section-prestations.is-motion-ready .prestation-badge,
  .section-prestations.is-motion-ready .prestation-tag,
  .section-prestations.is-motion-ready .prestation-title,
  .section-prestations.is-motion-ready .prestation-desc,
  .section-prestations.is-motion-ready .prestation-cta {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 620ms var(--ease-standard),
      transform 620ms var(--ease-standard);
  }

  .section-prestations.is-motion-ready .prestation-badge {
    transform: translateY(-6px) scale(0.98);
  }

  .section-prestations.is-motion-ready .prestation-card.is-visible .prestation-badge,
  .section-prestations.is-motion-ready .prestation-card.is-visible .prestation-tag,
  .section-prestations.is-motion-ready .prestation-card.is-visible .prestation-title,
  .section-prestations.is-motion-ready .prestation-card.is-visible .prestation-desc,
  .section-prestations.is-motion-ready .prestation-card.is-visible .prestation-cta {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .section-prestations.is-motion-ready .title-line {
    transform: translateY(112%);
    transition: transform 760ms var(--ease-standard);
  }

  .section-prestations.is-motion-ready .prestation-card.is-visible .title-line {
    transform: translateY(0);
  }

  .section-prestations.is-motion-ready .prestation-card.is-visible .prestation-badge {
    transition-delay: 180ms;
  }

  .section-prestations.is-motion-ready .prestation-card.is-visible .prestation-tag {
    transition-delay: 120ms;
  }

  .section-prestations.is-motion-ready .prestation-card.is-visible .prestation-title {
    transition-delay: 190ms;
  }

  .section-prestations.is-motion-ready .prestation-card.is-visible .title-mask:nth-child(1) .title-line {
    transition-delay: 220ms;
  }

  .section-prestations.is-motion-ready .prestation-card.is-visible .title-mask:nth-child(2) .title-line {
    transition-delay: 280ms;
  }

  .section-prestations.is-motion-ready .prestation-card.is-visible .title-mask:nth-child(3) .title-line {
    transition-delay: 340ms;
  }

  .section-prestations.is-motion-ready .prestation-card.is-visible .title-mask:nth-child(4) .title-line {
    transition-delay: 390ms;
  }

  .section-prestations.is-motion-ready .prestation-card.is-visible .title-mask:nth-child(5) .title-line {
    transition-delay: 430ms;
  }

  .section-prestations.is-motion-ready .prestation-card.is-visible .prestation-desc {
    transition-delay: 260ms;
  }

  .section-prestations.is-motion-ready .prestation-card.is-visible .prestation-cta {
    transition-delay: 330ms;
  }

  @media (min-width: 768px) {
    .section-prestations {
      padding-block: 76px 84px;
    }

    .prestations-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(300px, 0.48fr);
      align-items: end;
      max-width: none;
      gap: 36px;
      margin-bottom: 36px;
    }

    .prestations-head .eyebrow {
      grid-column: 1 / -1;
    }

    .prestations-head .section-title {
      font-size: clamp(3.5rem, 7.2vw, 6.2rem);
    }

    .prestations-subtitle {
      margin-bottom: 10px;
    }

    .prestations-couture {
      gap: 20px;
    }

    .prestation-card {
      grid-template-columns: minmax(240px, 0.44fr) minmax(0, 1fr);
      min-height: 270px;
    }

    .section-prestations.is-motion-ready .prestation-card:nth-child(odd) {
      transform: translate3d(-14px, 26px, 0) scale(0.99);
    }

    .section-prestations.is-motion-ready .prestation-card:nth-child(even) {
      transform: translate3d(14px, 26px, 0) scale(0.99);
    }

    .section-prestations.is-motion-ready .prestation-card.is-visible {
      transform: translate3d(0, 0, 0) scale(1);
    }

    .prestation-card:nth-child(even) {
      grid-template-columns: minmax(0, 1fr) minmax(240px, 0.44fr);
    }

    .prestation-card:nth-child(even) .prestation-photo {
      order: 2;
      margin: 6px 6px 6px 0;
      border-radius: 10px 20px 20px 10px;
    }

    .prestation-card:not(:nth-child(even)) .prestation-photo {
      margin: 6px 0 6px 6px;
      border-radius: 20px 10px 10px 20px;
    }

    .prestation-photo {
      min-height: 254px;
    }

    .prestation-copy {
      padding: 26px;
    }

    .prestation-title {
      font-size: clamp(1.95rem, 4vw, 3.7rem);
    }

    .prestation-card:nth-child(even) .prestation-copy {
      padding-left: 30px;
    }

    .prestation-cta {
      width: max-content;
      min-width: 190px;
    }
  }

  @media (hover: hover) {
    .prestation-card:hover {
      transform: translateY(-5px);
      box-shadow:
        0 24px 58px rgba(58, 35, 21, 0.17),
        inset 0 1px 0 rgba(255, 255, 255, 0.82);
    }

    .prestation-card:hover .prestation-photo img {
      transform: scale(1.055);
    }

    .prestation-card:hover .cta-icon {
      transform: translateX(3px) scale(1.04);
    }
  }

  @media (max-width: 390px) {
    .prestation-title {
      font-size: clamp(1.55rem, 7.2vw, 3rem);
    }

    .prestation-photo {
      min-height: 190px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-prestations.is-motion-ready .prestation-card,
    .section-prestations.is-motion-ready .prestation-badge,
    .section-prestations.is-motion-ready .prestation-tag,
    .section-prestations.is-motion-ready .prestation-title,
    .section-prestations.is-motion-ready .prestation-desc,
    .section-prestations.is-motion-ready .prestation-cta,
    .section-prestations.is-motion-ready .title-line {
      opacity: 1;
      filter: none;
      transform: none;
      transition: none;
    }

    .prestation-card,
    .prestation-photo img,
    .cta-icon {
      transition: none;
    }
  }
</style>

<script>
  function initPrestations() {
    const section = document.querySelector<HTMLElement>('#prestations.section-prestations');
    if (!section) return;

    const cards = Array.from(section.querySelectorAll<HTMLElement>('.prestation-card'));
    if (!cards.length) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reducedMotion || !('IntersectionObserver' in window)) {
      cards.forEach(card => card.classList.add('is-visible'));
      return;
    }

    section.classList.add('is-motion-ready');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, {
      threshold: 0.18,
      rootMargin: '0px 0px -8% 0px',
    });

    cards.forEach(card => observer.observe(card));

    document.addEventListener(
      'astro:before-swap',
      () => observer.disconnect(),
      { once: true }
    );
  }

  document.addEventListener('astro:page-load', initPrestations);
</script>
