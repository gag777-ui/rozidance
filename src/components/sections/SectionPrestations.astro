---
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = getTranslations(lang);
const base = lang === 'fr' ? '' : `/${lang}`;

/* ── Icons (52px, stroke-only pour lisibilité sur fond coloré) ── */
const svgIcons = [
  /* Alliances */
  `<svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor"
    stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="8"  cy="12" r="5"/>
    <circle cx="16" cy="12" r="5"/>
  </svg>`,
  /* Micro */
  `<svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor"
    stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="9" y="2" width="6" height="11" rx="3"/>
    <path d="M5 10a7 7 0 0014 0"/>
    <line x1="12" y1="19" x2="12" y2="22"/>
    <line x1="8"  y1="22" x2="16" y2="22"/>
  </svg>`,
  /* Notes */
  `<svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor"
    stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M9 18V5l12-2v13"/>
    <circle cx="6"  cy="18" r="3"/>
    <circle cx="18" cy="16" r="3"/>
  </svg>`,
] as const;

const ordinals   = ['01', '02', '03'] as const;
const categories = ['Mariage · Cérémonie', 'Chant · Performance', 'Cours · Atelier'] as const;

function getHref(id: string) {
  if (id === 'mariages')              return `${base}/mariages`;
  if (id === 'danse-evenementielle')  return `${base}/chant`;
  if (id === 'cours')                 return `${base}/cours`;
  return `${base || '/'}#contact`;
}
---

<section id="prestations" class="section-prestations" aria-labelledby="prestations-title">
  <div class="section-container">

    <!-- En-tête -->
    <div class="section-header reveal-fade">
      <span class="eyebrow">{t.prestations.eyebrow}</span>
      <h2 class="section-title" id="prestations-title">{t.prestations.title}</h2>
      <p class="prestations-subtitle">{t.hero.subtitle}</p>
    </div>

    <!-- Grille des cards -->
    <div class="prestations-grid">
      {t.prestations.items.map((item, i) => (
        <a
          class={`prestation-card pc-${i}`}
          href={getHref(item.id)}
          aria-label={item.title}
        >

          <!-- Zone visuelle : gradient + motif arménien + icône -->
          <div class={`card-visual cv-${i}`}>
            <!-- Motif tapis arménien (losanges imbriqués) -->
            <svg
              class="card-pattern"
              viewBox="0 0 64 64"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
              focusable="false"
            >
              <defs>
                <pattern
                  id={`arm-${i}`}
                  width="32"
                  height="32"
                  patternUnits="userSpaceOnUse"
                >
                  <!-- Losange extérieur -->
                  <path d="M16 1 L31 16 L16 31 L1 16 Z"
                    fill="none" stroke="currentColor" stroke-width="0.45"/>
                  <!-- Losange intérieur -->
                  <path d="M16 7 L25 16 L16 25 L7 16 Z"
                    fill="none" stroke="currentColor" stroke-width="0.4"/>
                  <!-- Motif croix arménienne au centre -->
                  <line x1="16" y1="12" x2="16" y2="20" stroke="currentColor" stroke-width="0.35"/>
                  <line x1="12" y1="16" x2="20" y2="16" stroke="currentColor" stroke-width="0.35"/>
                  <!-- Points aux coins -->
                  <circle cx="16" cy="1"  r="0.8" fill="currentColor"/>
                  <circle cx="31" cy="16" r="0.8" fill="currentColor"/>
                  <circle cx="16" cy="31" r="0.8" fill="currentColor"/>
                  <circle cx="1"  cy="16" r="0.8" fill="currentColor"/>
                </pattern>
              </defs>
              <rect width="100%" height="100%" fill={`url(#arm-${i})`}/>
            </svg>

            <!-- Icône centrée -->
            <div class="card-icon" set:html={svgIcons[i]}/>

            <!-- Overlay hover (terracotta wash) -->
            <div class="card-overlay" aria-hidden="true"></div>
          </div>

          <!-- Zone contenu -->
          <div class="card-content">
            <!-- Numéro éditorial (décoratif) -->
            <span class="card-num" aria-hidden="true">{ordinals[i]}</span>

            <!-- Catégorie eyebrow -->
            <span class="card-cat">{categories[i]}</span>

            <!-- Titre -->
            <h3 class="card-title">{item.title}</h3>

            <!-- Séparateur fin -->
            <div class="card-rule" aria-hidden="true"></div>

            <!-- Description -->
            <p class="card-desc">{item.description}</p>

            <!-- CTA discret -->
            <span class="card-cta">
              <span class="cta-text">{item.link}</span>
              <svg
                class="cta-arrow"
                width="13" height="13"
                viewBox="0 0 14 14"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M2 7h10M8 3l4 4-4 4"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </div>

        </a>
      ))}
    </div>

  </div>
</section>


<style>
  /* ════════════════════════════════════════════════════
     SECTION
     ════════════════════════════════════════════════════ */
  .section-prestations {
    padding-block: var(--spacing-section);
  }

  /* Subtitle sous le section-title */
  .prestations-subtitle {
    margin: 0;
    font-size: var(--text-sm);            /* 14px */
    color: var(--color-taupe);
    font-style: italic;
    max-width: 54ch;
    text-align: center;
    line-height: var(--leading-relaxed);
  }

  /* ════════════════════════════════════════════════════
     GRILLE
     Mobile   : 1 colonne
     Tablet   : 2 colonnes
     Desktop  : 3 colonnes
     ════════════════════════════════════════════════════ */
  .prestations-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm);                 /* 16px mobile */
    margin-top: var(--space-lg);          /* 40px */
  }

  @media (min-width: 768px) {
    .prestations-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-md);              /* 24px */
    }
    /* 3ème card seule : centrée mais pas étirée */
    .prestation-card:last-child:nth-child(2n+1) {
      grid-column: 1 / -1;
      max-width: calc(50% - var(--space-md) / 2);
      margin-inline: auto;
    }
  }

  @media (min-width: 1024px) {
    .prestations-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-md);
    }
    /* Reset orphan rule */
    .prestation-card:last-child:nth-child(2n+1) {
      grid-column: auto;
      max-width: unset;
      margin-inline: 0;
    }
  }

  /* ════════════════════════════════════════════════════
     CARD — shell
     ════════════════════════════════════════════════════ */
  .prestation-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-ivory-card);
    border: 0.5px solid var(--color-line);
    border-radius: var(--radius-md);      /* 12px */
    overflow: hidden;
    text-decoration: none;
    cursor: pointer;
    /* GPU-composited transitions */
    transition:
      border-color var(--duration-normal) var(--ease-standard),
      box-shadow    var(--duration-normal) var(--ease-standard),
      transform     var(--duration-normal) var(--ease-standard);
    will-change: transform;
  }

  @media (hover: hover) {
    .prestation-card:hover {
      transform: translateY(-8px);
      border-color: var(--color-terracotta);
      box-shadow: var(--shadow-lg);
    }
  }

  /* ════════════════════════════════════════════════════
     ZONE VISUELLE (gradient + pattern + icône)
     ════════════════════════════════════════════════════ */
  .card-visual {
    position: relative;
    height: 200px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* Gradient par card */
  .cv-0 {
    background: linear-gradient(145deg, #C16847 0%, #8B3F25 100%);
    color: rgba(255, 255, 255, 0.85);
  }
  .cv-1 {
    background: linear-gradient(145deg, #C09A5A 0%, #8A6A30 100%);
    color: rgba(255, 255, 255, 0.85);
  }
  .cv-2 {
    background: linear-gradient(145deg, #7B5C45 0%, #452E22 100%);
    color: rgba(255, 255, 255, 0.85);
  }

  /* Motif tapis arménien — SVG en couverture totale */
  .card-pattern {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.08;
    pointer-events: none;
  }

  /* Icône centrale */
  .card-icon {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--duration-normal) var(--ease-standard);
    filter: drop-shadow(0 2px 12px rgba(0, 0, 0, 0.20));
  }

  @media (hover: hover) {
    .prestation-card:hover .card-icon {
      transform: scale(1.12);
    }
  }

  /* Overlay hover — wash sombre subtil */
  .card-overlay {
    position: absolute;
    inset: 0;
    background-color: transparent;
    transition: background-color var(--duration-normal) var(--ease-standard);
    pointer-events: none;
    z-index: 2;
  }

  @media (hover: hover) {
    .prestation-card:hover .card-overlay {
      background-color: rgba(20, 10, 5, 0.16);
    }
  }

  /* ════════════════════════════════════════════════════
     ZONE CONTENU
     ════════════════════════════════════════════════════ */
  .card-content {
    position: relative;
    padding: var(--space-md);            /* 24px */
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);               /* 8px */
    flex: 1;
  }

  /* ── Numéro éditorial ── */
  .card-num {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    font-family: var(--font-serif);
    font-size: var(--text-5xl);          /* 60px — gros watermark */
    font-weight: 200;
    font-style: italic;
    line-height: 1;
    color: var(--color-gold);
    opacity: 0.20;
    pointer-events: none;
    user-select: none;
    transition: opacity var(--duration-normal) var(--ease-standard);
  }

  @media (hover: hover) {
    .prestation-card:hover .card-num {
      opacity: 0.10;                    /* Recule quand le titre prend le focus */
    }
  }

  /* ── Catégorie (eyebrow) ── */
  .card-cat {
    font-family: var(--font-sans);
    font-size: var(--text-caption);      /* 11px */
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-gold);
    display: block;
  }

  /* ── Titre H3 ── */
  .card-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);           /* 24px */
    font-weight: 400;
    color: var(--color-charcoal);
    line-height: var(--leading-snug);
    margin: 0;
    transition: color var(--duration-normal) var(--ease-standard);
  }

  @media (hover: hover) {
    .prestation-card:hover .card-title {
      color: var(--color-terracotta);
    }
  }

  /* ── Séparateur ── */
  .card-rule {
    height: 0.5px;
    background: linear-gradient(90deg, var(--color-line), transparent);
    margin-block: var(--space-xxs);      /* 4px */
    flex-shrink: 0;
  }

  /* ── Description ── */
  .card-desc {
    font-family: var(--font-sans);
    font-size: var(--text-sm);           /* 14px */
    color: var(--color-taupe);
    line-height: var(--leading-relaxed); /* 1.7 */
    margin: 0;
    flex: 1;
  }

  /* ── CTA discret ── */
  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);               /* 8px */
    font-family: var(--font-sans);
    font-size: var(--text-caption);      /* 11px */
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-terracotta);
    margin-top: var(--space-xs);
    position: relative;
    /* Soulignement qui s'étend */
    padding-bottom: 2px;
    align-self: flex-start;
  }

  /* Underline animé */
  .card-cta::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background-color: var(--color-terracotta);
    transition: width var(--duration-normal) var(--ease-standard);
  }

  @media (hover: hover) {
    .prestation-card:hover .card-cta::after {
      width: 100%;
    }
  }

  /* Flèche qui glisse */
  .cta-arrow {
    flex-shrink: 0;
    transition: transform var(--duration-short) var(--ease-standard);
  }

  @media (hover: hover) {
    .prestation-card:hover .cta-arrow {
      transform: translateX(4px);
    }
  }

  /* ════════════════════════════════════════════════════
     ACCESSIBILITÉ — focus clavier
     ════════════════════════════════════════════════════ */
  .prestation-card:focus-visible {
    outline: 2px solid var(--color-terracotta);
    outline-offset: 3px;
    border-color: var(--color-terracotta);
    box-shadow: var(--shadow-accent-md);
  }

  /* ════════════════════════════════════════════════════
     REDUCED MOTION
     ════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .prestation-card,
    .card-icon,
    .card-overlay,
    .card-num,
    .card-title,
    .card-cta::after,
    .cta-arrow {
      transition: none;
    }
  }
</style>


<script>
  import gsap from 'gsap';

  function initPrestations() {
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>('#prestations .prestation-card')
    );
    if (!cards.length) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reducedMotion) {
      /* ── État initial : invisible, décalées vers le bas + blur ── */
      gsap.set(cards, { autoAlpha: 0, y: 32, filter: 'blur(8px)' });

      /* ── IntersectionObserver : déclenche l'entrée au scroll ── */
      const obs = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          obs.unobserve(entry.target);

          const idx = cards.indexOf(entry.target as HTMLElement);

          gsap.to(entry.target, {
            autoAlpha: 1,
            y: 0,
            filter: 'blur(0px)',
            duration: 0.7,
            delay: idx * 0.12,
            ease: 'power3.out',
            /* Libère le contrôle à CSS après l'animation */
            onComplete: () => gsap.set(entry.target, { clearProps: 'all' }),
          });
        });
      }, {
        threshold: 0.12,
        rootMargin: '0px 0px -48px 0px',
      });

      cards.forEach(card => obs.observe(card));

      document.addEventListener(
        'astro:before-swap',
        () => obs.disconnect(),
        { once: true }
      );
    }
  }

  document.addEventListener('astro:page-load', initPrestations);
</script>
