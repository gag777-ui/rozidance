---
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = getTranslations(lang);
const base = lang === 'fr' ? '' : `/${lang}`;

const svgIcons = [
  `<svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor"
    stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="9" cy="12" r="4.5"/>
    <circle cx="15" cy="12" r="4.5"/>
  </svg>`,
  `<svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor"
    stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="9" y="2" width="6" height="12" rx="3"/>
    <path d="M5 10a7 7 0 0014 0"/>
    <line x1="12" y1="19" x2="12" y2="22"/>
    <line x1="8" y1="22" x2="16" y2="22"/>
  </svg>`,
  `<svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor"
    stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M22 9L12 5L2 9l10 4l10-4"/>
    <path d="M6 11.5V16a6 6 0 0012 0v-4.5"/>
    <line x1="22" y1="9" x2="22" y2="14"/>
  </svg>`,
] as const;

const ordinals = ['01', '02', '03'] as const;
const categories = ['Mariage · Cérémonie', 'Chant · Performance', 'Cours · Atelier'] as const;
const cardImages = [
  '/images/mariages-hero.webp',
  '/images/chant-hero.webp',
  '/images/cours-hero.webp',
] as const;

function getHref(id: string) {
  if (id === 'mariages') return `${base}/mariages`;
  if (id === 'danse-evenementielle') return `${base}/chant`;
  if (id === 'cours') return `${base}/cours`;
  return `${base || '/'}#contact`;
}
---

<section id="prestations" class="section-prestations" aria-labelledby="prestations-title">
  <div class="section-container">
    <div class="prestations-head reveal-fade">
      <span class="eyebrow">{t.prestations.eyebrow}</span>
      <h2 class="section-title" id="prestations-title">{t.prestations.title}</h2>
      <p class="prestations-subtitle">{t.hero.subtitle}</p>
    </div>

    <div class="services-stack">
      {t.prestations.items.map((item, i) => (
        <a class={`service-panel panel-${i}`} href={getHref(item.id)} aria-label={item.title}>
          <img
            src={cardImages[i]}
            alt=""
            class="service-img"
            loading="lazy"
            decoding="async"
          />
          <span class="service-shade" aria-hidden="true"></span>
          <span class="service-line" aria-hidden="true"></span>

          <div class="service-content">
            <div class="service-topline">
              <span class="service-cat">{categories[i]}</span>
              <span class="service-icon" set:html={svgIcons[i]} />
            </div>

            <div class="service-copy">
              <span class="service-num" aria-hidden="true">{ordinals[i]}</span>
              <h3 class="service-title">{item.title}</h3>
              <p class="service-desc">{item.description}</p>
            </div>

            <span class="service-cta">
              <span>{item.link}</span>
              <span class="cta-disc" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 15 15" fill="none">
                  <path
                    d="M2 7.5h10.5M8.5 3.5l4 4-4 4"
                    stroke="currentColor"
                    stroke-width="1.35"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .section-prestations {
    position: relative;
    isolation: isolate;
    padding-block: 76px 88px;
    overflow: hidden;
    background:
      radial-gradient(circle at 12% 8%, rgba(193, 104, 71, 0.22), transparent 30%),
      radial-gradient(circle at 88% 22%, rgba(168, 135, 83, 0.18), transparent 28%),
      linear-gradient(180deg, #24170f 0%, #130c08 54%, #2b1f15 100%);
    color: var(--color-ivory-card);
  }

  .section-prestations::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.18;
    pointer-events: none;
    background-image:
      linear-gradient(90deg, rgba(247, 241, 230, 0.12) 1px, transparent 1px),
      linear-gradient(180deg, rgba(247, 241, 230, 0.08) 1px, transparent 1px);
    background-size: 58px 58px;
    mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 88%, transparent);
  }

  .prestations-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    max-width: 680px;
    margin-bottom: 28px;
  }

  .prestations-head .eyebrow {
    color: #d7b071;
  }

  .prestations-head .section-title {
    max-width: 8ch;
    margin: 0;
    color: var(--color-ivory-card);
    font-size: clamp(3rem, 15vw, 5.6rem);
    line-height: 0.88;
    letter-spacing: 0;
  }

  .prestations-subtitle {
    max-width: 31ch;
    margin: 4px 0 0;
    color: rgba(251, 246, 236, 0.74);
    font-size: 15px;
    font-style: italic;
    line-height: 1.62;
  }

  .services-stack {
    display: grid;
    gap: 18px;
  }

  .service-panel {
    position: relative;
    min-height: min(690px, 74dvh);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    border: 0.5px solid rgba(247, 241, 230, 0.18);
    border-radius: 28px;
    color: var(--color-ivory-card);
    text-decoration: none;
    background-color: #120b07;
    box-shadow:
      0 24px 58px rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transform: translateZ(0);
    transition:
      transform 650ms var(--ease-standard),
      border-color 650ms var(--ease-standard),
      box-shadow 650ms var(--ease-standard);
  }

  .service-panel:focus-visible {
    outline: 2px solid var(--color-terracotta);
    outline-offset: 4px;
  }

  .service-panel:active {
    transform: scale(0.986);
  }

  .service-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 900ms var(--ease-standard);
  }

  .panel-0 .service-img {
    object-position: 50% 42%;
  }

  .panel-1 .service-img {
    object-position: 52% 38%;
  }

  .panel-2 .service-img {
    object-position: 52% 40%;
  }

  .service-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(12, 7, 4, 0.06) 0%, rgba(12, 7, 4, 0.34) 38%, rgba(12, 7, 4, 0.9) 100%),
      linear-gradient(115deg, rgba(43, 31, 21, 0.96) 0%, rgba(43, 31, 21, 0.5) 38%, rgba(43, 31, 21, 0.12) 74%);
    pointer-events: none;
  }

  .service-line {
    position: absolute;
    inset: 10px;
    border: 0.5px solid rgba(251, 246, 236, 0.22);
    border-radius: 22px;
    pointer-events: none;
  }

  .service-content {
    position: relative;
    z-index: 1;
    width: 100%;
    display: grid;
    gap: 22px;
    padding: 28px 22px 24px;
  }

  .service-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .service-cat {
    max-width: 18ch;
    color: #d7b071;
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.18em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .service-icon {
    width: 48px;
    height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    color: var(--color-ivory-card);
    border: 0.5px solid rgba(251, 246, 236, 0.24);
    border-radius: var(--radius-full);
    background-color: rgba(251, 246, 236, 0.08);
  }

  .service-icon :global(svg) {
    width: 24px;
    height: 24px;
  }

  .service-copy {
    display: grid;
    gap: 12px;
  }

  .service-num {
    display: block;
    color: rgba(215, 176, 113, 0.72);
    font-family: var(--font-serif);
    font-size: 22px;
    font-style: italic;
    line-height: 1;
  }

  .service-title {
    max-width: 9.5ch;
    margin: 0;
    color: var(--color-ivory-card);
    font-family: var(--font-serif);
    font-size: clamp(2.35rem, 12vw, 4.3rem);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: 0;
  }

  .service-desc {
    max-width: 31ch;
    margin: 2px 0 0;
    color: rgba(251, 246, 236, 0.78);
    font-family: var(--font-sans);
    font-size: 14.5px;
    line-height: 1.58;
  }

  .service-cta {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    width: 100%;
    padding: 8px 8px 8px 18px;
    color: var(--color-ivory-card);
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    border: 0.5px solid rgba(251, 246, 236, 0.24);
    border-radius: var(--radius-full);
    background-color: rgba(251, 246, 236, 0.08);
  }

  .cta-disc {
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    color: #24170f;
    border-radius: var(--radius-full);
    background-color: #d7b071;
    transition: transform 500ms var(--ease-standard);
  }

  @media (min-width: 768px) {
    .section-prestations {
      padding-block: 112px 124px;
    }

    .prestations-head {
      margin-bottom: 48px;
    }

    .prestations-head .section-title {
      font-size: clamp(4.4rem, 9vw, 8rem);
    }

    .services-stack {
      gap: 24px;
    }

    .service-panel {
      min-height: 440px;
      border-radius: 34px;
    }

    .service-line {
      inset: 14px;
      border-radius: 25px;
    }

    .service-content {
      max-width: 560px;
      padding: 46px;
    }

    .service-title {
      font-size: clamp(3.4rem, 7vw, 6.4rem);
    }

    .service-desc {
      font-size: 15px;
    }

    .service-cta {
      width: max-content;
      min-width: 210px;
    }
  }

  @media (min-width: 1024px) {
    .prestations-head {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(320px, 0.55fr);
      align-items: end;
      max-width: none;
      gap: 48px;
    }

    .prestations-head .eyebrow {
      grid-column: 1 / -1;
    }

    .prestations-subtitle {
      margin-bottom: 12px;
    }

    .services-stack {
      gap: 28px;
    }

    .service-panel {
      min-height: 480px;
    }

    .service-panel:nth-child(even) {
      justify-content: flex-end;
    }

    .service-panel:nth-child(even) .service-shade {
      background:
        linear-gradient(180deg, rgba(12, 7, 4, 0.04) 0%, rgba(12, 7, 4, 0.28) 44%, rgba(12, 7, 4, 0.88) 100%),
        linear-gradient(245deg, rgba(43, 31, 21, 0.96) 0%, rgba(43, 31, 21, 0.52) 42%, rgba(43, 31, 21, 0.1) 78%);
    }

    .service-content {
      max-width: 620px;
      padding: 54px;
    }

    .service-title {
      max-width: 10.2ch;
    }
  }

  @media (hover: hover) {
    .service-panel:hover {
      transform: translateY(-8px);
      border-color: rgba(215, 176, 113, 0.42);
      box-shadow:
        0 34px 78px rgba(0, 0, 0, 0.36),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }

    .service-panel:hover .service-img {
      transform: scale(1.075);
    }

    .service-panel:hover .cta-disc {
      transform: translateX(3px) scale(1.04);
    }
  }

  @media (max-width: 390px) {
    .service-panel {
      min-height: 620px;
    }

    .service-content {
      padding-inline: 19px;
    }

    .service-title {
      font-size: clamp(2.12rem, 11vw, 3.7rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-panel,
    .service-img,
    .cta-disc {
      transition: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';

  function initPrestations() {
    const panels = Array.from(
      document.querySelectorAll<HTMLElement>('#prestations .service-panel')
    );
    if (!panels.length) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reducedMotion) return;

    gsap.set(panels, { autoAlpha: 0, y: 34, filter: 'blur(10px)' });

    const obs = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        obs.unobserve(entry.target);

        const idx = panels.indexOf(entry.target as HTMLElement);
        gsap.to(entry.target, {
          autoAlpha: 1,
          y: 0,
          filter: 'blur(0px)',
          duration: 0.72,
          delay: idx * 0.1,
          ease: 'power3.out',
          onComplete: () => gsap.set(entry.target, { clearProps: 'all' }),
        });
      });
    }, { threshold: 0.14, rootMargin: '0px 0px -52px 0px' });

    panels.forEach(panel => obs.observe(panel));

    document.addEventListener(
      'astro:before-swap',
      () => obs.disconnect(),
      { once: true }
    );
  }

  document.addEventListener('astro:page-load', initPrestations);
</script>
