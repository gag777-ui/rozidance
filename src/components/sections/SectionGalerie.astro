---
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = getTranslations(lang);
const base = lang === 'fr' ? '' : `/${lang}`;

const photos = [
  { src: '/images/galerie/photo-01.webp', thumb: '/images/galerie/photo-01-thumb.webp', w: 1108, h: 1420 },
  { src: '/images/galerie/photo-02.webp', thumb: '/images/galerie/photo-02-thumb.webp', w: 1137, h: 1383 },
  { src: '/images/galerie/photo-03.webp', thumb: '/images/galerie/photo-03-thumb.webp', w: 1132, h: 1389 },
  { src: '/images/galerie/photo-04.webp', thumb: '/images/galerie/photo-04-thumb.webp', w: 1560, h: 1008 },
  { src: '/images/galerie/photo-06.webp', thumb: '/images/galerie/photo-06-thumb.webp', w: 1129, h: 1393 },
].map((photo, i) => ({
  ...photo,
  alt: `${t.galerie.altPlaceholder} ${i + 1}`,
}));
---

<section id="galerie" class="section-galerie" aria-labelledby="galerie-title">
  <div class="section-container">
    <div class="section-header reveal-fade">
      <span class="eyebrow">{t.galerie.eyebrow}</span>
      <h2 class="section-title" id="galerie-title">{t.galerie.title}</h2>
    </div>

    <!-- Gallery grid -->
    <div class="gallery-grid" id="gallery-grid">
      {photos.map((photo, i) => (
        <a
          href={photo.src}
          class={`gallery-item gallery-item-${i + 1}`}
          data-pswp-width={photo.w}
          data-pswp-height={photo.h}
          aria-label={`${t.galerie.openPhoto} : ${photo.alt}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          <div class="gallery-img-wrap">
            <img
              src={photo.thumb}
              alt={photo.alt}
              loading="lazy"
              decoding="async"
              class="gallery-img"
              width={photo.w}
              height={photo.h}
              data-fallback="/images/placeholder.webp"
            />
          </div>
        </a>
      ))}
    </div>

    <!-- Boutons footer -->
    <div class="gallery-footer reveal-fade">
      <a href={`${base}/galerie`} class="btn-primary gallery-all-btn">
        {t.galerie.ctaAll}
      </a>
      <a
        href="https://instagram.com/rozi.dance"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ghost gallery-insta-btn"
        aria-label={t.galerie.instagramAria}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <defs>
            <radialGradient id="ig-g" cx="30%" cy="107%" r="150%">
              <stop offset="0%"   stop-color="#feda77"/>
              <stop offset="12%"  stop-color="#fa7e1e"/>
              <stop offset="50%"  stop-color="#d62976"/>
              <stop offset="75%"  stop-color="#962fbf"/>
              <stop offset="100%" stop-color="#4f5bd5"/>
            </radialGradient>
          </defs>
          <path fill="url(#ig-g)" d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
        </svg>
        {t.galerie.instagramLink}
      </a>
    </div>
  </div>
</section>

<script>
  import 'photoswipe/style.css';

  let lightbox: any = null;

  async function initGallery() {
    if (lightbox) { lightbox.destroy(); lightbox = null; }
    const { default: PhotoSwipeLightbox } = await import('photoswipe/lightbox');
    lightbox = new PhotoSwipeLightbox({
      gallery: '#gallery-grid',
      children: 'a',
      pswpModule: () => import('photoswipe'),
      padding: { top: 20, bottom: 20, left: 20, right: 20 },
    });
    lightbox.init();
  }

  document.addEventListener('astro:page-load', initGallery);

  function initGalleryReveal() {
    const section = document.querySelector<HTMLElement>('#galerie.section-galerie');
    if (!section) return;

    const items = Array.from(section.querySelectorAll<HTMLElement>('.gallery-item'));
    if (!items.length) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reducedMotion || !('IntersectionObserver' in window)) {
      items.forEach(item => item.classList.add('is-visible'));
      return;
    }

    section.classList.add('is-motion-ready');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, {
      threshold: 0.18,
      rootMargin: '0px 0px -8% 0px',
    });

    items.forEach(item => observer.observe(item));

    document.addEventListener(
      'astro:before-swap',
      () => observer.disconnect(),
      { once: true }
    );
  }

  document.addEventListener('astro:page-load', initGalleryReveal);
</script>

<style>
  .section-galerie {
    position: relative;
    overflow: clip;
    margin-top: -8px;
    --flow-top: #f6eadc;
    --flow-bottom: #faf0e3;
    padding-block: 60px 68px;
    background:
      radial-gradient(ellipse at 48% 0%, rgba(168, 135, 83, 0.08), transparent 34%),
      radial-gradient(ellipse at 92% 72%, rgba(135, 144, 115, 0.07), transparent 32%),
      linear-gradient(180deg, #f6eadc 0%, #fff4e8 18%, #fff8ee 48%, #faf0e3 100%);
    box-shadow:
      inset 0 18px 24px var(--flow-top),
      inset 0 -18px 24px var(--flow-bottom);
  }

  .section-header {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 560px;
    margin-inline: auto;
    margin-bottom: 1.65rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
  }

  .section-title {
    font-size: clamp(2.7rem, 12vw, 5.8rem);
    color: var(--color-charcoal);
    font-weight: 300;
    line-height: 0.9;
    letter-spacing: 0;
    margin: 0;
  }

  .gallery-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 10px;
  }

  .gallery-item {
    display: block;
    min-height: 0;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .gallery-item-1 { grid-column: 1 / -1; }
  .gallery-item-2 { grid-column: 1 / 4; }
  .gallery-item-3 { grid-column: 4 / 7; }
  .gallery-item-4 { grid-column: 1 / -1; }
  .gallery-item-5 { grid-column: 2 / 6; }

  .gallery-img-wrap {
    position: relative;
    width: 100%;
    height: auto;
    overflow: hidden;
    aspect-ratio: 0.82 / 1;
    border-radius: 24px;
    background: rgba(41, 29, 20, 0.08);
    box-shadow:
      0 24px 56px rgba(63, 39, 21, 0.14),
      0 0 0 1px rgba(89, 55, 31, 0.07);
    transform: translateZ(0);
    transition:
      box-shadow 720ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 720ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .gallery-img-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.08), transparent 22%),
      linear-gradient(0deg, rgba(33, 24, 17, 0.14), transparent 42%);
    opacity: 0.58;
    transition: opacity 720ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .gallery-item-4 .gallery-img-wrap {
    aspect-ratio: 1.42 / 1;
  }

  .gallery-item-1 .gallery-img-wrap {
    aspect-ratio: 1.03 / 1;
    border-radius: 30px;
  }

  .gallery-item-5 .gallery-img-wrap {
    aspect-ratio: 1 / 1;
    border-radius: 26px;
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    filter: saturate(0.96) contrast(1.03);
    transition:
      filter 720ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 980ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .gallery-item-1 .gallery-img { object-position: 50% 18%; }
  .gallery-item-2 .gallery-img { object-position: 50% 24%; }
  .gallery-item-3 .gallery-img { object-position: 50% 24%; }
  .gallery-item-4 .gallery-img { object-position: 50% 44%; }
  .gallery-item-5 .gallery-img { object-position: 50% 25%; }

  .section-galerie.is-motion-ready .gallery-item {
    opacity: 0;
    transform: translate3d(0, 28px, 0) scale(0.99);
    transition:
      opacity 820ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 820ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .section-galerie.is-motion-ready .gallery-item.is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }

  .section-galerie.is-motion-ready .gallery-item:nth-child(2) { transition-delay: 70ms; }
  .section-galerie.is-motion-ready .gallery-item:nth-child(3) { transition-delay: 120ms; }
  .section-galerie.is-motion-ready .gallery-item:nth-child(4) { transition-delay: 60ms; }
  .section-galerie.is-motion-ready .gallery-item:nth-child(5) { transition-delay: 110ms; }

  .gallery-item:hover .gallery-img {
    filter: saturate(1.04) contrast(1.05);
    transform: scale(1.035);
  }

  .gallery-item:hover .gallery-img-wrap {
    box-shadow:
      0 30px 66px rgba(63, 39, 21, 0.18),
      0 0 0 1px rgba(89, 55, 31, 0.08);
    transform: translate3d(0, -4px, 0);
  }

  .gallery-item:hover .gallery-img-wrap::after {
    opacity: 0.36;
  }

  .gallery-footer {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 1.8rem;
    flex-wrap: wrap;
  }

  .gallery-insta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
  }

  .gallery-all-btn,
  .gallery-insta-btn {
    min-height: 42px;
    border-radius: var(--radius-full);
  }

  .gallery-all-btn {
    background: #7f876b;
    box-shadow: 0 16px 34px rgba(75, 85, 59, 0.19);
  }

  .gallery-all-btn:hover {
    background: #717b5d;
  }

  @media (min-width: 768px) {
    .section-galerie {
      padding-block: 78px 88px;
    }

    .section-header {
      margin-bottom: 3rem;
    }

    .gallery-grid {
      grid-template-columns: repeat(12, 1fr);
      grid-template-rows: 170px 170px 170px;
      gap: 14px;
      max-width: 1080px;
      margin-inline: auto;
    }

    .gallery-item-1 { grid-column: 1 / 6; grid-row: 1 / 4; }
    .gallery-item-2 { grid-column: 6 / 9; grid-row: 1 / 2; }
    .gallery-item-3 { grid-column: 9 / 13; grid-row: 1 / 2; }
    .gallery-item-4 { grid-column: 6 / 10; grid-row: 2 / 4; }
    .gallery-item-5 { grid-column: 10 / 13; grid-row: 2 / 4; }

    .gallery-img-wrap,
    .gallery-item-1 .gallery-img-wrap,
    .gallery-item-4 .gallery-img-wrap {
      height: 100%;
      aspect-ratio: auto;
      border-radius: 26px;
    }

    .gallery-item-1 .gallery-img-wrap {
      border-radius: 34px;
    }

    .gallery-item-4 .gallery-img { object-position: 50% 45%; }

    .gallery-item:hover .gallery-img-wrap {
      transform: translate3d(0, -4px, 0);
    }
  }

  @media (max-width: 390px) {
    .gallery-grid {
      gap: 8px;
    }

    .gallery-img-wrap {
      border-radius: 20px;
    }

    .gallery-item-1 .gallery-img-wrap {
      border-radius: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-galerie.is-motion-ready .gallery-item,
    .gallery-img {
      opacity: 1;
      filter: none;
      transform: none;
      transition: none;
    }
  }
</style>
