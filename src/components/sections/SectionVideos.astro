---
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = getTranslations(lang);

const videos = [
  { id: 'zTQRoFT6tX4', title: 'Rozi Dance', thumbnail: 'https://img.youtube.com/vi/zTQRoFT6tX4/hqdefault.jpg' },
  { id: 'xa3-8ONanC4', title: 'Rozi Dance', thumbnail: 'https://img.youtube.com/vi/xa3-8ONanC4/hqdefault.jpg' },
  { id: 'mO7R2CxR5mQ', title: 'Rozi Dance', thumbnail: 'https://img.youtube.com/vi/mO7R2CxR5mQ/hqdefault.jpg' },
];
---

<section id="videos" class="section-videos" aria-labelledby="videos-title">
  <div class="section-container">
    <div class="section-header reveal-fade">
      <span class="eyebrow">{t.videos.eyebrow}</span>
      <h2 class="section-title" id="videos-title">
        <span class="title-passion-wrap">
          {t.videos.title}
          <svg class="passion-heart" viewBox="0 0 22 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M11 23.5C11 23.5 1.5 16.5 1.5 9.5C1.5 5.91 4.41 3 8 3C9.6 3 11 3.9 11 3.9C11 3.9 12.4 3 14 3C17.59 3 20.5 5.91 20.5 9.5C20.5 16.5 11 23.5 11 23.5Z"
              stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
          </svg>
        </span>
      </h2>
    </div>

    <div class="carousel-outer">
      <div class="videos-grid" id="videos-carousel">
        {videos.map((video, i) => (
          <div class={`card-shell cs-${i}`} data-card data-index={i}>
            <div class={`card-core cc-${i} video-card`}>
              <div class="card-light"></div>

              <button
                class="video-thumb-btn video-thumb-cursor"
                data-video-id={video.id}
                aria-label={`Lire la vidéo : ${video.title}`}
              >
                <div class="video-thumb-wrap">
                  <img
                    src={video.thumbnail}
                    alt={`Aperçu : ${video.title}`}
                    loading="lazy"
                    decoding="async"
                    class="video-thumb"
                    width="480"
                    height="270"
                    data-fallback="/images/video-placeholder.webp"
                  />
                  <div class="video-play-btn" aria-hidden="true">
                    <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                      <circle cx="24" cy="24" r="24" fill="rgba(43,31,21,0.55)"/>
                      <polygon points="19,14 37,24 19,34" fill="#fff"/>
                    </svg>
                  </div>
                </div>
              </button>

              <div class="video-player" hidden>
                <div class="video-player-inner">
                  <iframe
                    class="video-iframe"
                    src=""
                    data-src={`https://www.youtube.com/embed/${video.id}?autoplay=1&rel=0&modestbranding=1`}
                    title={video.title}
                    style="border:none"
                    allow="autoplay; encrypted-media; fullscreen"
                    allowfullscreen
                  ></iframe>
                  <button class="video-close-btn" aria-label="Fermer la vidéo">
                    <svg width="16" height="16" viewBox="0 0 20 20" fill="none">
                      <line x1="2" y1="2" x2="18" y2="18" stroke="currentColor" stroke-width="1.5"/>
                      <line x1="18" y1="2" x2="2" y2="18" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                  </button>
                </div>
              </div>

              <div class="video-card-body">
                <p class="video-title">{video.title}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="carousel-dots" aria-hidden="true">
        <span class="dot dot-0"></span>
        <span class="dot dot-1"></span>
        <span class="dot dot-2"></span>
      </div>
    </div>

    <div class="videos-footer reveal-fade">
      <a
        href="https://www.youtube.com/@luarozifreedomband/videos"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ghost videos-yt-btn"
        aria-label="Voir toute la chaîne YouTube Rozi Dance"
      >
        <svg width="20" height="14" viewBox="0 0 24 17" aria-hidden="true">
          <rect width="24" height="17" rx="4" fill="#FF0000"/>
          <polygon points="9.5,4.5 9.5,12.5 17,8.5" fill="#ffffff"/>
        </svg>
        Voir toute la chaîne <span class="yt-label-red">YouTube</span>
      </a>
    </div>
  </div>
</section>

<style>
  .section-videos { padding-block: var(--spacing-section); }

  .section-header {
    text-align: center; margin-bottom: 3rem;
    display: flex; flex-direction: column; align-items: center; gap: 0.75rem;
  }

  .section-title { font-size: clamp(1.875rem, 3.5vw, 2.75rem); color: var(--color-section-title); margin: 0; }

  .title-passion-wrap { position: relative; display: inline-block; }
  .passion-heart {
    position: absolute; right: -0.22em; top: 0.08em;
    width: 0.3em; height: 0.36em; color: #C96876; stroke: currentColor;
  }

  /* ── Carousel outer ── */
  .carousel-outer { position: relative; }

  /* ── Entrée spectaculaire (mobile) ── */
  @media (max-width: 899px) {
    .card-shell {
      opacity: 0;
      transform: perspective(1100px) translateY(52px) scale(0.93);
    }
    .section-videos.sect-visible .cs-0 { animation: card-entrance 700ms var(--ease-out-soft) 0ms   both; }
    .section-videos.sect-visible .cs-1 { animation: card-entrance 700ms var(--ease-out-soft) 150ms both; }
    .section-videos.sect-visible .cs-2 { animation: card-entrance 700ms var(--ease-out-soft) 300ms both; }
  }

  @keyframes card-entrance {
    from { opacity: 0; transform: perspective(1100px) translateY(52px) scale(0.93); }
    to   { opacity: 1; transform: perspective(1100px) translateY(0) scale(1); }
  }

  /* ── Mobile: horizontal snap carousel ── */
  .videos-grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    gap: 1rem;
    padding: 1rem 4% 1.5rem;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .videos-grid::-webkit-scrollbar { display: none; }

  /* ── Dots ── */
  .carousel-dots {
    display: flex; justify-content: center; align-items: center;
    gap: 7px; margin-top: 1.5rem;
  }

  .dot {
    display: block; height: 6px; width: 6px; border-radius: 3px;
    background: rgba(43, 31, 21, 0.18);
    transition: background 300ms ease, width 350ms var(--ease-out-soft);
    cursor: pointer;
    position: relative; overflow: hidden;
  }

  .dot.dot-active { background: var(--color-accent); width: 22px; }

  .dot.dot-active::after {
    content: '';
    position: absolute; inset: 0;
    background: rgba(255, 255, 255, 0.48);
    border-radius: inherit;
    transform: translateX(-100%);
    animation: dot-progress 4s linear forwards;
  }

  @keyframes dot-progress {
    from { transform: translateX(-100%); }
    to   { transform: translateX(0); }
  }

  /* ── Desktop: 3-col grid ── */
  @media (min-width: 900px) {
    .videos-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      overflow-x: visible;
      scroll-snap-type: none;
      gap: 1.25rem;
      padding: 0.75rem;
    }
    .carousel-dots { display: none; }
  }

  /* ── Shell ── */
  .card-shell {
    flex: 0 0 min(92%, 440px);
    scroll-snap-align: center;
    border-radius: 28px; padding: 5px;
    border: 0.5px solid rgba(229, 215, 190, 0.6);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.9), 0 2px 8px rgba(43,31,21,0.04);
    transform-style: preserve-3d;
    will-change: transform, opacity;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition: opacity 650ms ease, box-shadow 500ms var(--ease-out-soft);
  }

  @media (min-width: 900px) {
    .card-shell {
      flex: unset; scroll-snap-align: unset;
      transition: transform 500ms var(--ease-out-soft), opacity 700ms ease, box-shadow 500ms var(--ease-out-soft);
    }
    /* Fan entrance desktop */
    .cs-0 { --fan-ry: -22deg; --fan-ty: 26px; }
    .cs-1 { --fan-ry:   0deg; --fan-ty: 34px; }
    .cs-2 { --fan-ry:  22deg; --fan-ty: 26px; }

    .card-shell.prest-visible { animation: card-fan-in 0.9s var(--ease-out-soft) both; }
    .cs-0.prest-visible { animation-delay:   0ms; }
    .cs-1.prest-visible { animation-delay: 160ms; }
    .cs-2.prest-visible { animation-delay: 320ms; }
  }

  @keyframes card-fan-in {
    from { opacity: 0; transform: perspective(900px) rotateY(var(--fan-ry, 0deg)) translateY(var(--fan-ty, 26px)); }
    to   { opacity: 1; transform: perspective(900px) rotateY(0deg) translateY(0px); }
  }

  .cs-0 { background: rgba(168,135,83,0.07); }
  .cs-1 { background: rgba(193,104,71,0.07); }
  .cs-2 { background: rgba(122,92,32,0.06); }

  @media (hover: hover) {
    .card-shell:hover {
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.9), 0 16px 40px rgba(43,31,21,0.1);
    }
  }

  /* ── Core ── */
  .card-core {
    border-radius: 22px; overflow: hidden;
    display: flex; flex-direction: column;
    position: relative;
  }

  .cc-0 { background: linear-gradient(145deg, #FEFCF8 0%, #EDDEB8 100%); }
  .cc-1 { background: linear-gradient(145deg, #FEFCF8 0%, #F0CBBA 100%); }
  .cc-2 { background: linear-gradient(145deg, #FEFCF8 0%, #E6D8A8 100%); }

  .card-light {
    position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(circle at var(--lx,28%) var(--ly,22%), rgba(255,255,255,0.3) 0%, transparent 60%);
    border-radius: inherit; transition: background 80ms linear; z-index: 1;
  }

  /* ── Video internals ── */
  .video-thumb-btn {
    display: block; width: 100%; background: none; border: none; padding: 0; cursor: pointer;
  }

  .video-thumb-wrap {
    position: relative; aspect-ratio: 16 / 9; overflow: hidden;
    background-color: var(--color-bg-dark);
  }

  .video-thumb {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform 500ms var(--ease-out-soft);
  }

  .video-thumb-btn:hover .video-thumb { transform: scale(1.04); }

  .video-play-btn {
    position: absolute; inset: 0; display: flex;
    align-items: center; justify-content: center;
    transition: opacity 300ms;
  }

  .video-thumb-btn:hover .video-play-btn { opacity: 0.85; }

  .video-player { aspect-ratio: 16 / 9; position: relative; }
  .video-player-inner { position: relative; width: 100%; height: 100%; }
  .video-iframe { width: 100%; height: 100%; border: none; display: block; aspect-ratio: 16/9; }

  .video-close-btn {
    position: absolute; top: 0.5rem; right: 0.5rem;
    background: rgba(43,31,21,0.7); color: #fff; border: none;
    width: 32px; height: 32px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center; z-index: 5; cursor: pointer;
  }

  .video-card-body { padding: 0.875rem 1.1rem 1rem; position: relative; z-index: 2; }

  .video-title {
    font-family: var(--font-serif);
    font-size: 1rem; font-style: italic;
    color: var(--color-text-primary); margin: 0; line-height: 1.4;
  }

  .videos-footer { display: flex; justify-content: center; margin-top: 2.5rem; }
  .videos-yt-btn { display: inline-flex; align-items: center; gap: 0.625rem; }
  .yt-label-red { color: #ff0000; }

  @media (prefers-reduced-motion: reduce) {
    .card-shell { transition: none; animation: none; }
    .card-light  { transition: none; }
  }
</style>

<script>
  function initVideos() {
    const shells   = Array.from(document.querySelectorAll<HTMLElement>('#videos-carousel [data-card]'));
    const carousel = document.getElementById('videos-carousel');
    const dots     = Array.from(document.querySelectorAll<HTMLElement>('#videos .carousel-dots .dot'));
    const ac       = new AbortController();
    const { signal } = ac;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isDesktop     = window.matchMedia('(min-width: 900px)').matches;

    // ── Video player logic ──
    shells.forEach(shell => {
      const btn      = shell.querySelector<HTMLElement>('.video-thumb-btn');
      const player   = shell.querySelector<HTMLElement>('.video-player');
      const iframe   = shell.querySelector<HTMLIFrameElement>('.video-iframe');
      const closeBtn = shell.querySelector<HTMLElement>('.video-close-btn');

      btn?.addEventListener('click', () => {
        if (!player || !iframe) return;
        const src = iframe.getAttribute('data-src');
        if (src) iframe.src = src;
        player.hidden = false;
        if (btn) btn.hidden = true;
      }, { signal });

      closeBtn?.addEventListener('click', () => {
        if (player) { player.hidden = true; if (iframe) iframe.src = ''; }
        if (btn) btn.hidden = false;
      }, { signal });
    });

    if (!shells.length) return;

    // ── Mobile: carousel + auto-play ──
    if (!isDesktop && carousel) {
      const AUTO_MS   = 4000;
      let rafId:       number | null = null;
      let autoTimer:   ReturnType<typeof setTimeout> | null = null;
      let currentIdx   = 0;
      let isTouching   = false;

      const setActiveDot = (idx: number) => {
        dots.forEach((dot, i) => {
          if (i === idx) {
            dot.classList.remove('dot-active');
            void dot.getBoundingClientRect();
            dot.classList.add('dot-active');
          } else {
            dot.classList.remove('dot-active');
          }
        });
      };

      const scheduleNext = () => {
        if (autoTimer) clearTimeout(autoTimer);
        if (reducedMotion) return;
        autoTimer = setTimeout(() => {
          if (isTouching) return;
          currentIdx = (currentIdx + 1) % shells.length;
          goToCard(currentIdx);
        }, AUTO_MS);
      };

      const goToCard = (idx: number) => {
        currentIdx = idx;
        const target = shells[idx];
        if (!target) return;
        carousel.scrollTo({
          left: target.offsetLeft - (carousel.clientWidth - target.offsetWidth) / 2,
          behavior: 'smooth',
        });
        setActiveDot(idx);
        scheduleNext();
      };

      const updateCarousel = () => {
        const sl = carousel.scrollLeft;
        const cw = carousel.clientWidth;
        let activeIdx = 0;
        let minDist   = Infinity;

        shells.forEach((shell, i) => {
          const cardCenter = shell.offsetLeft + shell.offsetWidth / 2;
          const dist       = Math.abs(cardCenter - (sl + cw / 2));
          if (dist < minDist) { minDist = dist; activeIdx = i; }

          if (!reducedMotion) {
            const norm    = (cardCenter - (sl + cw / 2)) / shell.offsetWidth;
            const absDist = Math.abs(norm);
            const scale   = absDist < 0.15 ? 1 : Math.max(0.87, 1 - absDist * 0.14);
            const opacity = absDist < 0.15 ? 1 : Math.max(0.48, 1 - absDist * 0.5);
            shell.style.transform = `perspective(1100px) rotateY(${norm * 22}deg) scale(${scale})`;
            shell.style.opacity   = String(opacity);
          }
        });

        if (activeIdx !== currentIdx) {
          currentIdx = activeIdx;
          setActiveDot(activeIdx);
          scheduleNext();
        }
      };

      const startCarousel = () => {
        setActiveDot(0);
        updateCarousel();
        scheduleNext();

        carousel.addEventListener('scroll', () => {
          if (rafId !== null) cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(updateCarousel);
        }, { signal });

        carousel.addEventListener('touchstart', () => {
          isTouching = true;
          if (autoTimer) { clearTimeout(autoTimer); autoTimer = null; }
        }, { passive: true, signal });

        carousel.addEventListener('touchend', () => {
          isTouching = false;
          scheduleNext();
        }, { passive: true, signal });

        dots.forEach((dot, i) => {
          dot.addEventListener('click', () => goToCard(i), { signal });
        });
      };

      // Entrée spectaculaire
      const section = document.getElementById('videos');
      if (section && !reducedMotion) {
        let entranceObs: IntersectionObserver | null = new IntersectionObserver(([entry]) => {
          if (!entry.isIntersecting) return;
          entranceObs!.disconnect();
          entranceObs = null;
          section.classList.add('sect-visible');
          setTimeout(startCarousel, 1050);
        }, { threshold: 0.18 });
        entranceObs.observe(section);

        document.addEventListener('astro:before-swap', () => {
          entranceObs?.disconnect();
          entranceObs = null;
        }, { once: true });
      } else {
        section?.classList.add('sect-visible');
        startCarousel();
      }
    }

    // ── Desktop: fan-in entrance ──
    if (isDesktop && !reducedMotion) {
      const section = document.getElementById('videos');
      if (section) {
        let obs: IntersectionObserver | null = new IntersectionObserver(([entry]) => {
          if (!entry.isIntersecting) return;
          obs!.disconnect(); obs = null;
          shells.forEach(s => s.classList.add('prest-visible'));
        }, { threshold: 0.22 });
        obs.observe(section);

        document.addEventListener('astro:before-swap', () => {
          obs?.disconnect(); obs = null;
        }, { once: true });
      }
    }

    // ── Desktop: hover tilt ──
    if (isDesktop) {
      shells.forEach(shell => {
        const light = shell.querySelector<HTMLElement>('.card-light');

        shell.addEventListener('mousemove', (e: MouseEvent) => {
          if (reducedMotion) return;
          const rect = shell.getBoundingClientRect();
          const dx = (e.clientX - rect.left - rect.width  / 2) / (rect.width  / 2);
          const dy = (e.clientY - rect.top  - rect.height / 2) / (rect.height / 2);
          shell.style.transition = 'transform 100ms linear';
          shell.style.transform  = `perspective(900px) rotateX(${-dy * 6}deg) rotateY(${dx * 9}deg) translateZ(4px)`;
          if (light) {
            light.style.setProperty('--lx', `${50 + dx * 20}%`);
            light.style.setProperty('--ly', `${50 - dy * 20}%`);
          }
        }, { signal });

        shell.addEventListener('mouseleave', () => {
          shell.style.transition = 'transform 600ms var(--ease-out-soft)';
          shell.style.transform  = 'perspective(900px) rotateX(0deg) rotateY(0deg)';
          if (light) {
            light.style.setProperty('--lx', '28%');
            light.style.setProperty('--ly', '22%');
          }
        }, { signal });
      });
    }

    document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });
  }

  document.addEventListener('astro:page-load', initVideos);
</script>
