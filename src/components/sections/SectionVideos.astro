---
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = getTranslations(lang);

const videos = [
  { id: 'zTQRoFT6tX4', title: 'Rozi Dance', thumbnail: 'https://img.youtube.com/vi/zTQRoFT6tX4/hqdefault.jpg' },
  { id: 'xa3-8ONanC4', title: 'Rozi Dance', thumbnail: 'https://img.youtube.com/vi/xa3-8ONanC4/hqdefault.jpg' },
  { id: 'mO7R2CxR5mQ', title: 'Rozi Dance', thumbnail: 'https://img.youtube.com/vi/mO7R2CxR5mQ/hqdefault.jpg' },
];
---

<section id="videos" class="section-videos" aria-labelledby="videos-title">
  <div class="section-container">
    <div class="section-header reveal-fade">
      <span class="eyebrow">{t.videos.eyebrow}</span>
      <h2 class="section-title" id="videos-title">
        <span class="title-passion-wrap">
          {t.videos.title}
          <svg class="passion-heart" viewBox="0 0 22 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M11 23.5C11 23.5 1.5 16.5 1.5 9.5C1.5 5.91 4.41 3 8 3C9.6 3 11 3.9 11 3.9C11 3.9 12.4 3 14 3C17.59 3 20.5 5.91 20.5 9.5C20.5 16.5 11 23.5 11 23.5Z"
              stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
          </svg>
        </span>
      </h2>
    </div>

    <div class="videos-showcase">
      <div class="videos-grid" id="videos-carousel">
        {videos.map((video, i) => (
          <div class={`card-shell cs-${i}`} data-card data-index={i}>
            <div class={`card-core cc-${i} video-card`}>
              <div class="card-light"></div>

              <button
                class="video-thumb-btn video-thumb-cursor"
                data-video-id={video.id}
                aria-label={`Lire la vidéo : ${video.title}`}
              >
                <div class="video-thumb-wrap">
                  <img
                    src={video.thumbnail}
                    alt={`Aperçu : ${video.title}`}
                    loading="lazy"
                    decoding="async"
                    class="video-thumb"
                    width="480"
                    height="270"
                    data-fallback="/images/video-placeholder.webp"
                  />
                  <div class="video-play-btn" aria-hidden="true">
                    <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                      <circle cx="24" cy="24" r="24" fill="rgba(43,31,21,0.55)"/>
                      <polygon points="19,14 37,24 19,34" fill="#fff"/>
                    </svg>
                  </div>
                </div>
              </button>

              <div class="video-player" hidden>
                <div class="video-player-inner">
                  <iframe
                    class="video-iframe"
                    src=""
                    data-src={`https://www.youtube-nocookie.com/embed/${video.id}?autoplay=1&playsinline=1&rel=0&modestbranding=1`}
                    title={video.title}
                    style="border:none"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
                    allowfullscreen
                  ></iframe>
                  <button class="video-close-btn" aria-label={t.videos.closeVideo}>
                    <svg width="16" height="16" viewBox="0 0 20 20" fill="none">
                      <line x1="2" y1="2" x2="18" y2="18" stroke="currentColor" stroke-width="1.5"/>
                      <line x1="18" y1="2" x2="2" y2="18" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                  </button>
                </div>
              </div>

              <div class="video-card-body" aria-hidden="true"></div>
            </div>
          </div>
        ))}
      </div>

      <div class="carousel-dots" aria-hidden="true">
        <button class="dot dot-0" type="button"></button>
        <button class="dot dot-1" type="button"></button>
        <button class="dot dot-2" type="button"></button>
      </div>
    </div>

    <div class="videos-footer reveal-fade">
      <a
        href="https://www.youtube.com/@luarozifreedomband/videos"
        target="_blank"
        rel="noopener noreferrer"
        class="videos-yt-btn"
        aria-label={t.videos.youtubeAria}
      >
        <span class="yt-logo-mark" aria-hidden="true">
          <svg width="34" height="24" viewBox="0 0 34 24" fill="none">
            <rect x="1" y="1" width="32" height="22" rx="7" fill="#D53232"/>
            <path d="M14 7.4v9.2L22 12l-8-4.6Z" fill="#FFF8EE"/>
          </svg>
        </span>
        <span class="yt-copy">
          <span class="yt-kicker">{t.videos.youtubeKicker}</span>
          <span class="yt-title">{t.videos.youtubeTitle}</span>
        </span>
        <span class="yt-arrow" aria-hidden="true">
          <svg width="17" height="17" viewBox="0 0 17 17" fill="none">
            <path d="M3.5 8.5h9M9 5l3.5 3.5L9 12" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .section-videos {
    position: relative;
    overflow: clip;
    margin-top: -8px;
    --flow-top: #faf0e3;
    --flow-bottom: #f8ead8;
    padding-block: 64px 74px;
    color: var(--color-charcoal);
    background:
      radial-gradient(ellipse at 48% 0%, rgba(168, 135, 83, 0.08), transparent 40%),
      radial-gradient(ellipse at 8% 82%, rgba(135, 144, 115, 0.07), transparent 34%),
      linear-gradient(180deg, #faf0e3 0%, #fffaf0 34%, #f8ead8 100%);
    box-shadow:
      inset 0 18px 24px var(--flow-top),
      inset 0 -18px 24px var(--flow-bottom);
  }

  .section-videos::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 84px;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 0%, rgba(241, 223, 202, 0.64) 58%, #f8ead8 100%);
  }

  .section-header {
    position: relative;
    z-index: 1;
    text-align: left;
    max-width: 650px;
    margin-bottom: 1.8rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .section-videos :global(.eyebrow) {
    color: #7a653e;
    border-color: rgba(168, 135, 83, 0.24);
  }

  .section-title {
    max-width: 9ch;
    color: var(--color-charcoal);
    font-size: clamp(2.75rem, 12.5vw, 5.8rem);
    font-weight: 300;
    line-height: 0.88;
    letter-spacing: 0;
    margin: 0;
  }

  .title-passion-wrap { position: relative; display: inline-block; }
  .passion-heart {
    position: absolute; right: -0.22em; top: 0.08em;
    width: 0.3em; height: 0.36em; color: #879073; stroke: currentColor;
  }

  .videos-showcase {
    position: relative;
    z-index: 1;
  }

  .videos-grid {
    display: flex;
    gap: 14px;
    margin-inline: -16px;
    padding: 4px 16px 18px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-padding-inline: 16px;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .videos-grid::-webkit-scrollbar {
    display: none;
  }

  .card-shell {
    flex: 0 0 min(88vw, 420px);
    scroll-snap-align: center;
    border-radius: 26px;
    padding: 4px;
    background:
      linear-gradient(145deg, rgba(255, 250, 241, 0.92), rgba(168, 135, 83, 0.14)),
      rgba(255, 249, 239, 0.72);
    box-shadow:
      0 22px 54px rgba(68, 43, 25, 0.14),
      inset 0 1px 0 rgba(255, 255, 255, 0.62);
    transform-style: preserve-3d;
    will-change: transform, opacity;
    -webkit-tap-highlight-color: transparent;
    transition:
      opacity 820ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 820ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 620ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (hover: hover) {
    .card-shell:hover {
      box-shadow:
        0 28px 64px rgba(68, 43, 25, 0.18),
        inset 0 1px 0 rgba(255, 255, 255, 0.72);
      transform: translate3d(0, -4px, 0);
    }
  }

  .card-core {
    border-radius: 24px;
    overflow: hidden;
    position: relative;
    background: #20160f;
  }

  .card-light {
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      inset 0 -48px 90px rgba(0, 0, 0, 0.16);
    z-index: 1;
  }

  .video-thumb-btn {
    display: block;
    width: 100%;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: inherit;
    text-decoration: none;
  }

  .video-thumb-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-bg-dark);
  }

  .cs-1 .video-thumb-wrap,
  .cs-2 .video-thumb-wrap {
    aspect-ratio: 16 / 9;
  }

  .video-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.92) contrast(1.08);
    transition:
      filter 720ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 980ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .video-thumb-btn:hover .video-thumb {
    filter: saturate(1.04) contrast(1.08);
    transform: scale(1.035);
  }

  .video-play-btn {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff8ee;
    transition:
      opacity 420ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .video-play-btn svg {
    width: 58px;
    height: 58px;
    filter: drop-shadow(0 12px 30px rgba(0, 0, 0, 0.3));
  }

  .video-play-btn circle {
    fill: rgba(37, 23, 15, 0.54);
    stroke: rgba(255, 249, 239, 0.28);
    stroke-width: 1;
  }

  .video-play-btn polygon {
    fill: #fff8ee;
  }

  .video-thumb-btn:hover .video-play-btn {
    transform: scale(1.04);
  }

  .video-card-body {
    display: none;
  }

  .video-player {
    aspect-ratio: 16 / 9;
    position: relative;
  }

  .video-player-inner {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .video-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    aspect-ratio: 16 / 9;
  }

  .video-close-btn {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 5;
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff8ee;
    border: 1px solid rgba(255, 249, 239, 0.22);
    border-radius: 50%;
    background: rgba(43, 31, 21, 0.76);
    cursor: pointer;
  }

  .section-videos.is-motion-ready .card-shell {
    opacity: 0;
    transform: translate3d(0, 34px, 0) scale(0.985);
  }

  .section-videos.is-motion-ready .card-shell.is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }

  .section-videos.is-motion-ready .card-shell:nth-child(2) { transition-delay: 90ms; }
  .section-videos.is-motion-ready .card-shell:nth-child(3) { transition-delay: 160ms; }

  .carousel-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 7px;
    margin-top: 0.8rem;
  }

  .dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: rgba(43, 31, 21, 0.18);
    cursor: pointer;
    transition:
      width 360ms cubic-bezier(0.22, 1, 0.36, 1),
      background 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .dot.dot-active {
    width: 24px;
    background: #879073;
  }

  .videos-footer {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    margin-top: 1.85rem;
  }

  .videos-yt-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    width: min(100%, 430px);
    padding: 9px 9px 9px 12px;
    color: var(--color-charcoal);
    border: 0.5px solid rgba(135, 144, 115, 0.26);
    border-radius: 999px;
    background:
      linear-gradient(135deg, rgba(255, 250, 241, 0.96), rgba(231, 209, 187, 0.74));
    box-shadow:
      0 18px 44px rgba(68, 43, 25, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.76);
    text-decoration: none;
    transition:
      border-color 520ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 520ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .yt-logo-mark {
    width: 54px;
    height: 54px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    border-radius: var(--radius-full);
    background: rgba(255, 248, 238, 0.92);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      0 10px 24px rgba(213, 50, 50, 0.16);
  }

  .yt-logo-mark svg {
    display: block;
    filter: drop-shadow(0 5px 10px rgba(213, 50, 50, 0.16));
  }

  .yt-copy {
    display: grid;
    gap: 1px;
    min-width: 0;
    flex: 1 1 auto;
  }

  .yt-kicker {
    color: #7a653e;
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.17em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .yt-title {
    color: var(--color-charcoal);
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 4.5vw, 1.34rem);
    font-style: italic;
    line-height: 1.15;
  }

  .yt-arrow {
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    color: #fff8ee;
    border-radius: var(--radius-full);
    background: #879073;
    transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .videos-yt-btn:hover {
    border-color: rgba(135, 144, 115, 0.42);
    box-shadow:
      0 24px 54px rgba(68, 43, 25, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
    transform: translateY(-3px);
  }

  .videos-yt-btn:hover .yt-arrow {
    transform: translateX(3px);
  }

  @media (min-width: 768px) {
    .section-videos {
      padding-block: 78px 88px;
      background:
        radial-gradient(ellipse at 48% 0%, rgba(168, 135, 83, 0.08), transparent 40%),
        radial-gradient(ellipse at 8% 82%, rgba(135, 144, 115, 0.07), transparent 34%),
        linear-gradient(180deg, #faf0e3 0%, #fffaf0 30%, #f8ead8 100%);
      box-shadow:
        inset 0 18px 24px var(--flow-top),
        inset 0 -18px 24px var(--flow-bottom);
    }

    .section-header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(260px, 0.34fr);
      align-items: end;
      max-width: none;
      margin-bottom: 2.15rem;
    }

    .section-header .eyebrow {
      grid-column: 1 / -1;
    }

    .section-title {
      font-size: clamp(4rem, 8vw, 7.2rem);
    }

    .videos-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 16px;
      margin-inline: auto;
      padding: 0;
      overflow: visible;
    }

    .cs-0 { grid-column: 1 / 5; }
    .cs-1 { grid-column: 5 / 9; }
    .cs-2 { grid-column: 9 / 13; }

    .card-shell {
      flex: initial;
      scroll-snap-align: unset;
      border-radius: 34px;
      padding: 5px;
    }

    .carousel-dots {
      display: none;
    }

    .video-play-btn svg {
      width: 68px;
      height: 68px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-shell,
    .video-thumb,
    .video-play-btn {
      opacity: 1;
      transform: none;
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  function initVideos() {
    const shells   = Array.from(document.querySelectorAll<HTMLElement>('#videos-carousel [data-card]'));
    const carousel = document.getElementById('videos-carousel');
    const dots     = Array.from(document.querySelectorAll<HTMLElement>('#videos .carousel-dots .dot'));
    const ac       = new AbortController();
    const { signal } = ac;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isDesktop     = window.matchMedia('(min-width: 900px)').matches;

    if (!shells.length) return;

    const stopVideo = (shell: HTMLElement) => {
      const btn = shell.querySelector<HTMLElement>('.video-thumb-btn');
      const player = shell.querySelector<HTMLElement>('.video-player');
      const iframe = shell.querySelector<HTMLIFrameElement>('.video-iframe');
      if (player) player.hidden = true;
      if (iframe) iframe.src = '';
      if (btn) btn.hidden = false;
    };

    shells.forEach(shell => {
      const btn = shell.querySelector<HTMLElement>('.video-thumb-btn');
      const player = shell.querySelector<HTMLElement>('.video-player');
      const iframe = shell.querySelector<HTMLIFrameElement>('.video-iframe');
      const closeBtn = shell.querySelector<HTMLElement>('.video-close-btn');

      btn?.addEventListener('click', () => {
        if (!player || !iframe) return;
        shells.forEach(other => {
          if (other !== shell) stopVideo(other);
        });
        const src = iframe.getAttribute('data-src');
        if (src) iframe.src = src;
        player.hidden = false;
        btn.hidden = true;
      }, { signal });

      closeBtn?.addEventListener('click', () => stopVideo(shell), { signal });
    });

    if (!isDesktop && carousel) {
      let rafId: number | null = null;

      const setActiveDot = (idx: number) => {
        dots.forEach((dot, i) => dot.classList.toggle('dot-active', i === idx));
      };

      const updateDots = () => {
        const scrollCenter = carousel.scrollLeft + carousel.clientWidth / 2;
        let activeIdx = 0;
        let minDist = Infinity;

        shells.forEach((shell, i) => {
          const cardCenter = shell.offsetLeft + shell.offsetWidth / 2;
          const dist = Math.abs(cardCenter - scrollCenter);
          if (dist < minDist) {
            minDist = dist;
            activeIdx = i;
          }
        });

        setActiveDot(activeIdx);
      };

      carousel.addEventListener('scroll', () => {
        if (rafId !== null) cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(updateDots);
      }, { signal });

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          const target = shells[i];
          if (!target) return;
          carousel.scrollTo({
            left: target.offsetLeft - (carousel.clientWidth - target.offsetWidth) / 2,
            behavior: reducedMotion ? 'auto' : 'smooth',
          });
          setActiveDot(i);
        }, { signal });
      });

      setActiveDot(0);
      requestAnimationFrame(updateDots);
    }

    const section = document.getElementById('videos');
    if (section && !reducedMotion && 'IntersectionObserver' in window) {
      section.classList.add('is-motion-ready');
      let obs: IntersectionObserver | null = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          obs?.unobserve(entry.target);
        });
      }, {
        threshold: 0.18,
        rootMargin: '0px 0px -8% 0px',
      });

      shells.forEach(shell => obs?.observe(shell));

      document.addEventListener('astro:before-swap', () => {
        obs?.disconnect();
        obs = null;
      }, { once: true });
    } else {
      shells.forEach(shell => shell.classList.add('is-visible'));
    }

    // ── Desktop: hover tilt ──
    if (isDesktop) {
      shells.forEach(shell => {
        const light = shell.querySelector<HTMLElement>('.card-light');

        shell.addEventListener('mousemove', (e: MouseEvent) => {
          if (reducedMotion) return;
          const rect = shell.getBoundingClientRect();
          const dx = (e.clientX - rect.left - rect.width  / 2) / (rect.width  / 2);
          const dy = (e.clientY - rect.top  - rect.height / 2) / (rect.height / 2);
          shell.style.transition = 'transform 100ms linear';
          shell.style.transform  = `perspective(900px) rotateX(${-dy * 6}deg) rotateY(${dx * 9}deg) translateZ(4px)`;
          if (light) {
            light.style.setProperty('--lx', `${50 + dx * 20}%`);
            light.style.setProperty('--ly', `${50 - dy * 20}%`);
          }
        }, { signal });

        shell.addEventListener('mouseleave', () => {
          shell.style.transition = 'transform 600ms var(--ease-out-soft)';
          shell.style.transform  = 'perspective(900px) rotateX(0deg) rotateY(0deg)';
          if (light) {
            light.style.setProperty('--lx', '28%');
            light.style.setProperty('--ly', '22%');
          }
        }, { signal });
      });
    }

    document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });
  }

  document.addEventListener('astro:page-load', initVideos);
</script>
