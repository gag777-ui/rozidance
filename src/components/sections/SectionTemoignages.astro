---
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = getTranslations(lang);

const cardImages = [
  '/images/galerie/photo-01.webp',
  '/images/galerie/photo-04.webp',
  '/images/galerie/photo-07.webp',
];
---

<section id="temoignages" class="section-temoignages" aria-labelledby="temoignages-title">
  <div class="section-container">

    <div class="section-header reveal-fade">
      <span class="eyebrow">{t.temoignages.eyebrow}</span>
      <h2 class="section-title" id="temoignages-title">{t.temoignages.title}</h2>
    </div>

    <div class="temoignages-grid">
      {t.temoignages.items.map((item, i) => (
        <div class="tc-card reveal" style={`transition-delay:${i * 150}ms`}>

          <!-- Photo + gradient overlay -->
          <div class="tc-photo-wrap">
            <img
              src={cardImages[i]}
              alt=""
              class="tc-photo"
              loading="lazy"
              decoding="async"
              data-fallback="/images/placeholder.webp"
            />
            <div class="tc-overlay"></div>
          </div>

          <!-- Corps de la carte -->
          <div class="tc-body">
            <p class="tc-quote">"{item.quote}"</p>
            <div class="tc-sep"></div>
            <p class="tc-author">— {item.author}</p>
            <p class="tc-event">{item.event}</p>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .section-temoignages {
    padding-block: var(--spacing-section);
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .section-title {
    font-size: clamp(1.875rem, 3.5vw, 2.75rem);
    color: var(--color-section-title);
    margin: 0;
  }

  /* ── Grille ── */
  .temoignages-grid {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    max-width: 400px;
    margin-inline: auto;
  }

  @media (min-width: 640px) {
    .temoignages-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      max-width: 660px;
      gap: 1.25rem;
    }
  }

  @media (min-width: 960px) {
    .temoignages-grid {
      grid-template-columns: repeat(3, 1fr);
      max-width: 100%;
      gap: 1.4rem;
    }
  }

  /* ── Carte ── */
  .tc-card {
    background: #1C1410;
    border-radius: 18px;
    overflow: hidden;
    transition: transform 400ms var(--ease-out-soft), box-shadow 400ms var(--ease-out-soft);
  }

  @media (hover: hover) {
    .tc-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 48px rgba(0, 0, 0, 0.35);
    }
  }

  /* ── Photo ── */
  .tc-photo-wrap {
    position: relative;
    overflow: hidden;
  }

  .tc-photo {
    width: 100%;
    height: 220px;
    object-fit: cover;
    object-position: top;
    display: block;
    transition: transform 500ms var(--ease-out-soft);
  }

  .tc-card:hover .tc-photo {
    transform: scale(1.05);
  }

  /* Gradient du bas vers le haut, fond de carte */
  .tc-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 65%;
    background: linear-gradient(to top, #1C1410, transparent);
    pointer-events: none;
  }

  /* ── Corps ── */
  .tc-body {
    padding: 1rem 1.25rem 1.4rem;
  }

  .tc-quote {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-style: italic;
    color: rgba(247, 241, 230, 0.88);
    line-height: 1.7;
    margin: 0 0 0.85rem;
  }

  .tc-sep {
    height: 0.5px;
    background: rgba(229, 215, 190, 0.18);
    margin-bottom: 0.85rem;
  }

  .tc-author {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 500;
    color: #F7F1E6;
    margin: 0 0 0.2rem;
  }

  /* Gradient text or et rose — comme le gradient violet du 21st.dev */
  .tc-event {
    font-size: 0.78rem;
    font-style: italic;
    margin: 0;
    background: linear-gradient(90deg, #D4A843, #C96876, #A88753);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  @media (prefers-reduced-motion: reduce) {
    .tc-card, .tc-photo { transition: none; }
  }
</style>
