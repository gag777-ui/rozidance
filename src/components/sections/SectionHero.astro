---
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = getTranslations(lang);
const base = lang === 'fr' ? '' : `/${lang}`;
---

<section class="hero-section" aria-labelledby="hero-title">

  <!-- Fond vidéo MP4 auto-hébergé -->
  <div class="hero-video-bg" aria-hidden="true">
    <video
      class="hero-bg-video"
      autoplay
      muted
      loop
      playsinline
      disablepictureinpicture
      preload="none"
      poster="/images/og-default.webp"
    ></video>
    <div class="hero-filter"></div>
  </div>

  <!-- Motif géométrique watermark (desktop uniquement) -->
  <div class="hero-pattern" aria-hidden="true">
    <svg viewBox="0 0 500 500" xmlns="http://www.w3.org/2000/svg" class="hero-pattern-svg">
      <g stroke="#ffffff" stroke-width="0.8" fill="none">
        <polygon points="250,80 265,115 305,115 272,138 285,175 250,152 215,175 228,138 195,115 235,115"/>
        <polygon points="250,40 270,80 250,120 230,80"/>
        <polygon points="370,160 410,180 370,200 330,180"/>
        <polygon points="130,160 170,180 130,200 90,180"/>
        <rect x="180" y="60" width="140" height="140" transform="rotate(45 250 130)" stroke-width="0.5"/>
        <rect x="200" y="80" width="100" height="100" transform="rotate(45 250 130)" stroke-width="0.5"/>
        <line x1="200" y1="0" x2="200" y2="500" stroke-width="0.3" stroke-dasharray="4 12"/>
        <line x1="300" y1="0" x2="300" y2="500" stroke-width="0.3" stroke-dasharray="4 12"/>
        <line x1="0" y1="200" x2="500" y2="200" stroke-width="0.3" stroke-dasharray="4 12"/>
        <line x1="0" y1="300" x2="500" y2="300" stroke-width="0.3" stroke-dasharray="4 12"/>
      </g>
    </svg>
  </div>

  <!-- Contenu principal -->
  <div class="hero-inner section-container">
    <div class="hero-text">

      <h1 class="hero-title" id="hero-title">
        <span class="hero-line hero-line-1">{t.hero.line1}</span>
        <span class="hero-line hero-line-2" id="hero-line2">{t.hero.line2}</span>
        <em
          class="hero-line hero-italic"
          id="hero-italic"
          aria-label={`${t.hero.line3a} · ${t.hero.line3italic}`}
        >
          <span class="hw-rozi">{t.hero.line3a}</span>
          <span class="hw-dot">·</span>
          <span class="hw-dance">{t.hero.line3italic}</span>
        </em>
      </h1>

      <!-- Séparateur éditorial or — animé par GSAP -->
      <div class="hero-deco-line" aria-hidden="true"></div>

      <div class="hero-actions" id="hero-actions">
        <a href="#contact" class="btn-primary">{t.hero.ctaPrimary}</a>
        <a href="#prestations" class="hero-btn-ghost">{t.hero.ctaSecondary}</a>
      </div>

    </div>
  </div>

  <!-- Indicateur de scroll (desktop uniquement, CSS-only) -->
  <div class="hero-scroll" aria-hidden="true">
    <div class="hero-scroll-inner"></div>
  </div>

</section>


<style>
  /* ════════════════════════════════════════════════════
     SECTION — base mobile-first
     ════════════════════════════════════════════════════ */
  .hero-section {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Top : compense le header (72px) + respiration */
    padding-block: calc(72px + var(--space-xl)) var(--space-xl);
    overflow: hidden;
    background-color: var(--color-dark);
  }

  /* ════════════════════════════════════════════════════
     VIDÉO FOND
     ════════════════════════════════════════════════════ */
  .hero-video-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }

  .hero-bg-video {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    min-width: 100%;
    min-height: 100%;
    width: auto;
    height: auto;
    object-fit: cover;
    z-index: 0;
    pointer-events: none;
  }

  /* Double filtre : vignette + gradient top */
  .hero-filter {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(20, 10, 5, 0.42) 0%, transparent 35%),
      radial-gradient(ellipse 110% 95% at 50% 50%, rgba(20, 10, 5, 0.28) 0%, rgba(20, 10, 5, 0.72) 100%);
    z-index: 1;
    pointer-events: none;
  }

  /* ════════════════════════════════════════════════════
     WATERMARK (desktop)
     ════════════════════════════════════════════════════ */
  .hero-pattern { display: none; }

  /* ════════════════════════════════════════════════════
     LAYOUT INTERNE
     ════════════════════════════════════════════════════ */
  .hero-inner {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);    /* 24px */
  }

  /* ════════════════════════════════════════════════════
     TITRE HERO
     ════════════════════════════════════════════════════ */
  .hero-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Taille de base pour hero-line-2 */
    font-size: clamp(2rem, 8vw, 3.5rem);
    line-height: var(--leading-tight);
    color: #fff;
    text-shadow: 0 2px 24px rgba(20, 10, 5, 0.55);
    margin: 0;
  }

  .hero-line { display: block; }

  /* ── Line 1 : "Bienvenu" — uppercase, small, animation CSS blur ── */
  .hero-line-1 {
    font-size: clamp(var(--text-sm), 3.5vw, var(--text-md));  /* 14→18px */
    letter-spacing: var(--tracking-widest);                    /* 0.2em */
    text-transform: uppercase;
    font-family: var(--font-sans);
    font-weight: 400;
    color: rgba(255, 255, 255, 0.60);
    margin-bottom: 0.25em;
    animation: heroBienvenuIn var(--duration-normal) var(--ease-standard) 0ms both;
  }

  /* ── Line 2 : "dans le monde de" — géré par typewriter JS ── */
  .hero-line-2 {
    opacity: 0;
    color: rgba(247, 241, 230, 0.78);  /* ivory 78% */
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(1.25rem, 5vw, 2rem);
    letter-spacing: var(--tracking-wide);
  }

  /* ── "Rozi · Dance" — géré par GSAP (slide + blur) ── */
  .hero-italic {
    opacity: 0;
    color: var(--color-gold);           /* or vieilli — signature premium */
    font-style: italic;
    font-size: clamp(3rem, 14vw, 4rem); /* 48→64px mobile */
    line-height: 1.0;
    margin-top: 0.08em;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.22em;
    min-height: 1.1em;
    text-shadow: 0 4px 32px rgba(168, 135, 83, 0.3);
  }

  /* ════════════════════════════════════════════════════
     KEYFRAMES
     ════════════════════════════════════════════════════ */

  /* "Bienvenu" — blur + translateY + fade */
  @keyframes heroBienvenuIn {
    from {
      opacity: 0;
      transform: translateY(18px);
      filter: blur(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  /* Scroll indicator — chute perpétuelle */
  @keyframes heroScrollFall {
    0%   { transform: translateY(-100%); opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translateY(220%); opacity: 0; }
  }

  /* Apparition du scroll indicator */
  @keyframes heroScrollReveal {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* ════════════════════════════════════════════════════
     SÉPARATEUR ÉDITORIAL (animé par GSAP)
     ════════════════════════════════════════════════════ */
  .hero-deco-line {
    width: 56px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-gold), transparent);
    opacity: 0;
    transform: scaleX(0);
    transform-origin: center;
    /* Réduit le gap autour pour bien s'intégrer dans le flex */
    margin-block: calc(var(--space-xs) * -1) calc(var(--space-xs) * -1);
  }

  /* ════════════════════════════════════════════════════
     CTA
     ════════════════════════════════════════════════════ */
  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);      /* 16px */
    flex-wrap: wrap;
    justify-content: center;
    opacity: 0;
  }

  /* Bouton fantôme — version dark hero (blanc sur fond vidéo) */
  .hero-btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    background-color: transparent;
    color: #fff;
    font-family: var(--font-sans);
    font-size: var(--text-xs);          /* 12px */
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    padding: 0.875rem 1.75rem;
    border-radius: var(--radius-sm);    /* 4px — éditorial */
    border: 0.5px solid rgba(255, 255, 255, 0.55);
    position: relative;
    overflow: hidden;
    cursor: pointer;
    text-decoration: none;
    transition:
      border-color var(--duration-normal) var(--ease-standard),
      background-color var(--duration-normal) var(--ease-standard),
      transform var(--duration-short) var(--ease-standard),
      box-shadow var(--duration-short) var(--ease-standard);
  }

  .hero-btn-ghost::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 25%,
      rgba(255, 255, 255, 0.14) 50%,
      transparent 75%
    );
    transform: translateX(-100%);
    transition: transform 550ms var(--ease-standard);
  }

  .hero-btn-ghost:hover {
    border-color: rgba(255, 255, 255, 0.9);
    background-color: rgba(255, 255, 255, 0.08);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(255, 255, 255, 0.08);
  }

  .hero-btn-ghost:hover::before {
    transform: translateX(150%);
  }

  /* ════════════════════════════════════════════════════
     SCROLL INDICATOR (CSS-only, desktop)
     ════════════════════════════════════════════════════ */
  .hero-scroll {
    display: none;
  }

  /* ════════════════════════════════════════════════════
     DESKTOP ≥ 1024px
     ════════════════════════════════════════════════════ */
  @media (min-width: 1024px) {
    .hero-section {
      min-height: 100vh;
      padding-block: 0;
    }

    /* Watermark géométrique */
    .hero-pattern {
      display: block;
      position: absolute;
      top: 50%;
      right: -60px;
      transform: translateY(-50%);
      width: 520px;
      height: 520px;
      pointer-events: none;
      opacity: 0.06;
      z-index: 2;
    }
    .hero-pattern-svg { width: 100%; height: 100%; }

    .hero-inner {
      padding-block: var(--space-xxl);   /* 96px */
    }

    /* Titre + italic plus grands */
    .hero-title {
      font-size: clamp(2.75rem, 5.5vw, 4.5rem);
    }

    .hero-line-1 {
      font-size: clamp(var(--text-xs), 1vw, var(--text-sm)); /* 12→14px */
      margin-bottom: 0.4em;
    }

    .hero-line-2 {
      font-size: clamp(1.5rem, 3vw, 2.25rem);
    }

    .hero-italic {
      /* Display XL — 96px max */
      font-size: clamp(4rem, 8.5vw, 6rem); /* 64→96px */
    }

    /* Scroll indicator */
    .hero-scroll {
      display: block;
      position: absolute;
      bottom: var(--space-lg);            /* 40px */
      left: 50%;
      transform: translateX(-50%);
      width: 1px;
      height: 52px;
      overflow: hidden;
      animation: heroScrollReveal var(--duration-normal) var(--ease-standard) 3s both;
    }

    .hero-scroll-inner {
      width: 100%;
      height: 100%;
      background: linear-gradient(to bottom, var(--color-gold), transparent);
      animation: heroScrollFall 2.2s var(--ease-standard) 3.2s infinite;
    }
  }

  /* ════════════════════════════════════════════════════
     REDUCED MOTION
     ════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .hero-line-1 { animation: none; opacity: 1; }
    .hero-scroll, .hero-scroll-inner { animation: none; }
  }
</style>


<script>
  import gsap from 'gsap';

  /* ── Chargement lazy de la vidéo fond ───────────────────── */
  function initHeroVideo() {
    const video = document.querySelector<HTMLVideoElement>('.hero-bg-video');
    if (!video) return;

    video.muted = true;
    (video as HTMLVideoElement & { playsInline: boolean }).playsInline = true;

    if (!video.querySelector('source')) {
      const src = document.createElement('source');
      src.src = '/videos/hero.mp4';
      src.type = 'video/mp4';
      video.appendChild(src);
      video.load();
    }

    const tryPlay = () => {
      if (!video.paused) return;
      video.play().catch(() => {
        video.addEventListener('canplay',    tryPlay, { once: true });
        video.addEventListener('loadeddata', tryPlay, { once: true });
        document.addEventListener('touchstart', tryPlay, { once: true });
      });
    };

    tryPlay();
  }

  document.addEventListener('astro:page-load', initHeroVideo);

  /* ── Typewriter "dans le monde de" ──────────────────────── */
  function initHeroTypewriter() {
    const el = document.getElementById('hero-line2') as HTMLElement | null;
    if (!el) return;

    const text = el.textContent?.trim() ?? '';
    el.textContent = '';
    el.style.opacity = '1';

    let i = 0;
    function typeNext() {
      if (i >= text.length) return;
      el.textContent += text[i];
      i++;
      const jitter = (Math.random() - 0.5) * 12;
      setTimeout(typeNext, 38 + jitter);
    }

    setTimeout(typeNext, 120);
  }

  document.addEventListener('astro:page-load', initHeroTypewriter);

  /* ── Animation principale : "Rozi · Dance" + deco + CTA ─── */
  function initHeroTitleAnimation() {
    const el       = document.getElementById('hero-italic') as HTMLElement | null;
    if (!el) return;

    const rozi     = el.querySelector<HTMLElement>('.hw-rozi');
    const dot      = el.querySelector<HTMLElement>('.hw-dot');
    const dance    = el.querySelector<HTMLElement>('.hw-dance');
    if (!rozi || !dot || !dance) return;

    const actions  = document.getElementById('hero-actions');
    const decoLine = document.querySelector<HTMLElement>('.hero-deco-line');
    const vw       = window.innerWidth;

    /* ── État initial ── */
    gsap.set(el,       { opacity: 1 });
    /* Slide depuis les bords + blur (premium) */
    gsap.set(rozi,     { x: -vw * 1.15, filter: 'blur(12px)' });
    gsap.set(dance,    { x:  vw * 1.15, filter: 'blur(12px)' });
    gsap.set(dot,      { opacity: 0, scale: 0 });
    if (decoLine) gsap.set(decoLine, { scaleX: 0, opacity: 0, transformOrigin: 'center' });
    if (actions)  gsap.set(actions,  { opacity: 0, y: 16, filter: 'blur(8px)' });

    /* ── Timeline ── */
    const isMobile = vw <= 768;
    const tl = gsap.timeline({ delay: isMobile ? 0.25 : 0.75 });

    tl
      /* Rozi + Dance convergent, blur se dissipe */
      .to(rozi,     { x: 0, filter: 'blur(0px)', duration: 0.75, ease: 'power3.out' }, 0)
      .to(dance,    { x: 0, filter: 'blur(0px)', duration: 0.75, ease: 'power3.out' }, 0)
      /* Dot central pop */
      .to(dot,      { opacity: 1, scale: 1, duration: 0.3, ease: 'back.out(2.5)' }, 0.55)
      /* Séparateur or s'étend */
      .to(decoLine, { scaleX: 1, opacity: 1, duration: 0.55, ease: 'power2.out' }, 0.68)
      /* CTA remonte avec blur */
      .to(actions,  { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.6, ease: 'power2.out' }, 0.78);
  }

  document.addEventListener('astro:page-load', initHeroTitleAnimation);
</script>
