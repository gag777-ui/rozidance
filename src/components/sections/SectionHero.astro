---
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = getTranslations(lang);
---

<section class="hero-section" aria-labelledby="hero-title">

  <!-- Fond vidéo MP4 auto-hébergé -->
  <div class="hero-video-bg" aria-hidden="true">
    <video
      class="hero-bg-video"
      autoplay
      muted
      loop
      playsinline
      disablepictureinpicture
      preload="none"
      poster="/images/og-default.webp"
    ></video>
    <div class="hero-filter"></div>
  </div>

  <!-- Motif géométrique watermark (desktop uniquement) -->
  <div class="hero-pattern" aria-hidden="true">
    <svg viewBox="0 0 500 500" xmlns="http://www.w3.org/2000/svg" class="hero-pattern-svg">
      <g stroke="#ffffff" stroke-width="0.8" fill="none">
        <polygon points="250,80 265,115 305,115 272,138 285,175 250,152 215,175 228,138 195,115 235,115"/>
        <polygon points="250,40 270,80 250,120 230,80"/>
        <polygon points="370,160 410,180 370,200 330,180"/>
        <polygon points="130,160 170,180 130,200 90,180"/>
        <rect x="180" y="60" width="140" height="140" transform="rotate(45 250 130)" stroke-width="0.5"/>
        <rect x="200" y="80" width="100" height="100" transform="rotate(45 250 130)" stroke-width="0.5"/>
        <line x1="200" y1="0" x2="200" y2="500" stroke-width="0.3" stroke-dasharray="4 12"/>
        <line x1="300" y1="0" x2="300" y2="500" stroke-width="0.3" stroke-dasharray="4 12"/>
        <line x1="0" y1="200" x2="500" y2="200" stroke-width="0.3" stroke-dasharray="4 12"/>
        <line x1="0" y1="300" x2="500" y2="300" stroke-width="0.3" stroke-dasharray="4 12"/>
      </g>
    </svg>
  </div>

  <!-- Contenu principal -->
  <div class="hero-inner section-container">
    <div class="hero-text">

      <h1 class="hero-title" id="hero-title">
        <span class="hero-kicker" aria-label={`${t.hero.line1} ${t.hero.line2}`}>
          <span class="hero-kicker-line" aria-hidden="true"></span>
          <span class="hero-kicker-text">
            <span>{t.hero.line1}</span>
            <span>{t.hero.line2}</span>
          </span>
          <span class="hero-kicker-line" aria-hidden="true"></span>
        </span>
        <em
          class="hero-line hero-italic"
          id="hero-italic"
          aria-label={`${t.hero.line3a} ${t.hero.line3italic}`}
        >
          <span class="hw-rozi">{t.hero.line3a}</span>
          <span class="hw-dance">{t.hero.line3italic}</span>
        </em>
      </h1>

      <!-- Séparateur éditorial or — animé par GSAP -->
      <div class="hero-deco-line" aria-hidden="true"></div>

      <div class="hero-actions" id="hero-actions">
        <a href="#contact" class="btn-primary hero-action hero-action-primary">
          <span class="hero-action-label">{t.hero.ctaPrimary}</span>
          <span class="hero-action-icon" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 15 15" fill="none">
              <path d="M2 7.5h10.5M8.5 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
        <a href="#prestations" class="hero-action hero-action-secondary">
          <span class="hero-action-label">{t.hero.ctaSecondary}</span>
          <span class="hero-action-icon" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 15 15" fill="none">
              <path d="M2 7.5h10.5M8.5 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      </div>

    </div>
  </div>

  <!-- Indicateur de scroll (desktop uniquement, CSS-only) -->
  <div class="hero-scroll" aria-hidden="true">
    <div class="hero-scroll-inner"></div>
  </div>

</section>


<style>
  /* ════════════════════════════════════════════════════
     SECTION — base mobile-first
     ════════════════════════════════════════════════════ */
  .hero-section {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Top : compense le header (72px) + respiration */
    padding-block: calc(72px + var(--space-xl)) var(--space-xl);
    overflow: hidden;
    background-color: var(--color-dark);
  }

  /* ════════════════════════════════════════════════════
     VIDÉO FOND
     ════════════════════════════════════════════════════ */
  .hero-video-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    background: #201510 url('/images/og-default.webp') center / cover no-repeat;
  }

  .hero-bg-video {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    min-width: 112%;
    min-height: 112%;
    width: auto;
    height: auto;
    object-fit: cover;
    scale: 1.08;
    z-index: 0;
    pointer-events: none;
  }

  /* Double filtre : vignette + gradient top */
  .hero-filter {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(20, 10, 5, 0.42) 0%, transparent 35%),
      radial-gradient(ellipse 110% 95% at 50% 50%, rgba(20, 10, 5, 0.28) 0%, rgba(20, 10, 5, 0.72) 100%);
    z-index: 1;
    pointer-events: none;
  }

  /* ════════════════════════════════════════════════════
     WATERMARK (desktop)
     ════════════════════════════════════════════════════ */
  .hero-pattern { display: none; }

  /* ════════════════════════════════════════════════════
     LAYOUT INTERNE
     ════════════════════════════════════════════════════ */
  .hero-inner {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);    /* 24px */
  }

  /* ════════════════════════════════════════════════════
     TITRE HERO
     ════════════════════════════════════════════════════ */
  .hero-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Taille de base pour hero-line-2 */
    font-size: clamp(2rem, 8vw, 3.5rem);
    line-height: var(--leading-tight);
    color: #fff;
    text-shadow: 0 2px 24px rgba(20, 10, 5, 0.55);
    margin: 0;
  }

  .hero-line { display: block; }

  /* ── Intro éditoriale : "Bienvenue dans l'Univers de" ── */
  .hero-kicker {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: min(92vw, 620px);
    margin-bottom: 1.05rem;
    color: rgba(251, 246, 236, 0.78);
    opacity: 0;
    transform: translate3d(0, 12px, 0);
    /* Pas de filter statique — géré uniquement dans le keyframe desktop */
    animation: heroKickerIn 950ms cubic-bezier(0.22, 1, 0.36, 1) 120ms both;
  }

  .hero-kicker-text {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.42em;
    max-width: 28ch;
    font-family: var(--font-sans);
    font-size: clamp(0.72rem, 2.8vw, 0.88rem);
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .hero-kicker-line {
    width: clamp(28px, 9vw, 76px);
    height: 1px;
    flex: 0 1 auto;
    opacity: 0.78;
    background: linear-gradient(90deg, transparent, rgba(168, 135, 83, 0.9));
    transform: scaleX(0);
    transform-origin: right;
    animation: heroKickerLineIn 900ms cubic-bezier(0.22, 1, 0.36, 1) 360ms both;
  }

  .hero-kicker-line:last-child {
    background: linear-gradient(90deg, rgba(168, 135, 83, 0.9), transparent);
    transform-origin: left;
  }

  /* ── "Rozi · Dance" — révélation cinématique par masque ── */
  .hero-italic {
    opacity: 0;
    color: #b89a67;
    font-style: italic;
    font-size: clamp(3rem, 14vw, 4rem); /* 48→64px mobile */
    line-height: 1.0;
    margin-top: 0.08em;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.22em;
    min-height: 1.1em;
    overflow: hidden;
    text-shadow: 0 8px 42px rgba(168, 135, 83, 0.22);
  }

  .hero-italic > span {
    display: inline-block;
    will-change: transform, opacity;
  }

  .hw-dot {
    font-style: normal;
    color: rgba(251, 246, 236, 0.78);
    transform-origin: center;
  }

  /* ════════════════════════════════════════════════════
     KEYFRAMES
     ════════════════════════════════════════════════════ */

  @keyframes heroKickerIn {
    from { opacity: 0; transform: translate3d(0, 12px, 0); }
    to   { opacity: 1; transform: translate3d(0, 0, 0); }
  }

  /* Version desktop avec blur (uniquement si filter supporté + hover device) */
  @media (hover: hover) and (min-width: 1024px) {
    @keyframes heroKickerIn {
      from { opacity: 0; transform: translate3d(0, 12px, 0); filter: blur(8px); }
      to   { opacity: 1; transform: translate3d(0, 0, 0);   filter: blur(0); }
    }
  }

  @keyframes heroKickerLineIn {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  /* Scroll indicator — chute perpétuelle */
  @keyframes heroScrollFall {
    0%   { transform: translateY(-100%); opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translateY(220%); opacity: 0; }
  }

  /* Apparition du scroll indicator */
  @keyframes heroScrollReveal {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* ════════════════════════════════════════════════════
     SÉPARATEUR ÉDITORIAL (animé par GSAP)
     ════════════════════════════════════════════════════ */
  .hero-deco-line {
    width: 56px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-gold), transparent);
    opacity: 0;
    transform: scaleX(0);
    transform-origin: center;
    /* Réduit le gap autour pour bien s'intégrer dans le flex */
    margin-block: calc(var(--space-xs) * -1) calc(var(--space-xs) * -1);
  }

  /* ════════════════════════════════════════════════════
     CTA
     ════════════════════════════════════════════════════ */
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
    opacity: 0;
  }

  .hero-action {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 6px 6px 6px 18px;
    color: rgba(251, 246, 236, 0.95);
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.13em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-full);
    position: relative;
    overflow: hidden;
    isolation: isolate;
    backdrop-filter: saturate(118%);
    transition:
      border-color 620ms var(--ease-standard),
      background-color 620ms var(--ease-standard),
      color 620ms var(--ease-standard),
      transform 520ms var(--ease-standard),
      box-shadow 620ms var(--ease-standard);
  }

  .hero-action::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(110deg, transparent 18%, rgba(255, 255, 255, 0.24), transparent 82%);
    opacity: 0;
    transform: translateX(-70%);
    transition:
      opacity 520ms var(--ease-standard),
      transform 720ms var(--ease-standard);
  }

  .hero-actions .btn-primary.hero-action-primary {
    min-width: 184px;
    border: 0.5px solid rgba(184, 154, 103, 0.48);
    background:
      linear-gradient(135deg, rgba(64, 42, 27, 0.58), rgba(168, 135, 83, 0.34));
    color: rgba(251, 246, 236, 0.94);
    box-shadow:
      0 18px 48px rgba(12, 7, 4, 0.24),
      inset 0 1px 0 rgba(251, 246, 236, 0.16);
  }

  .hero-actions .btn-primary.hero-action-primary::before {
    background: linear-gradient(110deg, transparent 18%, rgba(251, 246, 236, 0.22), transparent 82%);
  }

  .hero-action-secondary {
    min-width: 156px;
    border: 0.5px solid rgba(251, 246, 236, 0.34);
    background: rgba(20, 10, 5, 0.24);
    box-shadow:
      0 16px 42px rgba(12, 7, 4, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  .hero-action-label,
  .hero-action-icon {
    position: relative;
    z-index: 1;
  }

  .hero-action-icon {
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    border-radius: var(--radius-full);
    transition:
      background-color 620ms var(--ease-standard),
      color 620ms var(--ease-standard),
      transform 620ms var(--ease-standard);
  }

  .hero-action-primary .hero-action-icon {
    color: rgba(251, 246, 236, 0.92);
    background: rgba(20, 10, 5, 0.58);
    box-shadow: inset 0 1px 0 rgba(251, 246, 236, 0.16);
  }

  .hero-action-secondary .hero-action-icon {
    color: rgba(251, 246, 236, 0.9);
    background: rgba(168, 135, 83, 0.28);
    box-shadow: inset 0 1px 0 rgba(251, 246, 236, 0.12);
  }

  .hero-action:hover {
    transform: translateY(-3px);
  }

  .hero-action:hover::before {
    opacity: 1;
    transform: translateX(70%);
  }

  .hero-action:hover .hero-action-icon {
    color: rgba(251, 246, 236, 0.98);
    background: rgba(168, 135, 83, 0.46);
    transform: translateX(3px) scale(1.04);
  }

  .hero-action-primary:hover {
    background:
      linear-gradient(135deg, rgba(75, 49, 31, 0.68), rgba(184, 154, 103, 0.42));
    box-shadow:
      0 22px 54px rgba(12, 7, 4, 0.3),
      inset 0 1px 0 rgba(251, 246, 236, 0.22);
  }

  .hero-action-secondary:hover {
    color: #fff8ef;
    border-color: rgba(251, 246, 236, 0.62);
    background: rgba(251, 246, 236, 0.1);
    box-shadow:
      0 20px 50px rgba(12, 7, 4, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }

  .hero-action:active {
    transform: translateY(-1px) scale(0.985);
  }

  .hero-action:focus-visible {
    outline: 2px solid rgba(251, 246, 236, 0.72);
    outline-offset: 4px;
  }

  /* ════════════════════════════════════════════════════
     SCROLL INDICATOR (CSS-only, desktop)
     ════════════════════════════════════════════════════ */
  .hero-scroll {
    display: none;
  }

  /* ════════════════════════════════════════════════════
     DESKTOP ≥ 1024px
     ════════════════════════════════════════════════════ */
  @media (min-width: 1024px) {
    .hero-section {
      min-height: 100vh;
      padding-block: 0;
    }

    /* Watermark géométrique */
    .hero-pattern {
      display: block;
      position: absolute;
      top: 50%;
      right: -60px;
      transform: translateY(-50%);
      width: 520px;
      height: 520px;
      pointer-events: none;
      opacity: 0.06;
      z-index: 2;
    }
    .hero-pattern-svg { width: 100%; height: 100%; }

    .hero-inner {
      padding-block: var(--space-xxl);   /* 96px */
    }

    /* Titre + italic plus grands */
    .hero-title {
      font-size: clamp(2.75rem, 5.5vw, 4.5rem);
    }

    .hero-kicker {
      gap: 18px;
      width: min(64vw, 760px);
      margin-bottom: 1.1rem;
    }

    .hero-kicker-text {
      max-width: none;
      font-size: clamp(0.74rem, 1vw, 0.92rem);
      letter-spacing: 0.26em;
    }

    .hero-italic {
      /* Display XL — 96px max */
      font-size: clamp(4rem, 8.5vw, 6rem); /* 64→96px */
    }

    /* Scroll indicator */
    .hero-scroll {
      display: block;
      position: absolute;
      bottom: var(--space-lg);            /* 40px */
      left: 50%;
      transform: translateX(-50%);
      width: 1px;
      height: 52px;
      overflow: hidden;
      animation: heroScrollReveal var(--duration-normal) var(--ease-standard) 3s both;
    }

    .hero-scroll-inner {
      width: 100%;
      height: 100%;
      background: linear-gradient(to bottom, var(--color-gold), transparent);
      animation: heroScrollFall 2.2s var(--ease-standard) 3.2s infinite;
    }
  }

  /* Mobile : boutons légèrement compacts */
  @media (max-width: 767px) {
    .hero-action {
      min-height: 44px;
      padding: 5px 5px 5px 16px;
      font-size: 10px;
      gap: 12px;
    }

    .hero-actions .btn-primary.hero-action-primary {
      min-width: 160px;
    }

    .hero-action-secondary {
      min-width: 138px;
    }

    .hero-action-icon {
      width: 30px;
      height: 30px;
    }
  }

  /* ════════════════════════════════════════════════════
     REDUCED MOTION
     ════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .hero-kicker,
    .hero-kicker-line,
    .hero-italic,
    .hero-italic > span {
      opacity: 1;
      transform: none;
      filter: none;
      animation: none;
    }

    .hero-scroll, .hero-scroll-inner { animation: none; }
  }
</style>


<script>
  import gsap from 'gsap';

  /* ── Chargement lazy de la vidéo fond ───────────────────── */
  function initHeroVideo() {
    const video = document.querySelector<HTMLVideoElement>('.hero-bg-video');
    if (!video) return;

    video.muted = true;
    (video as HTMLVideoElement & { playsInline: boolean }).playsInline = true;

    if (!video.querySelector('source')) {
      const src = document.createElement('source');
      src.src = '/videos/hero.mp4';
      src.type = 'video/mp4';
      video.appendChild(src);
      video.load();
    }

    const tryPlay = () => {
      if (!video.paused) return;
      video.play().catch(() => {
        video.addEventListener('canplay',    tryPlay, { once: true });
        video.addEventListener('loadeddata', tryPlay, { once: true });
        document.addEventListener('touchstart', tryPlay, { once: true });
      });
    };

    tryPlay();
  }

  document.addEventListener('astro:page-load', initHeroVideo);

  /* ── Animation principale : "Rozi · Dance" + deco + CTA ─── */
  function initHeroTitleAnimation() {
    const el       = document.getElementById('hero-italic') as HTMLElement | null;
    if (!el) return;

    const rozi     = el.querySelector<HTMLElement>('.hw-rozi');
    const dance    = el.querySelector<HTMLElement>('.hw-dance');
    if (!rozi || !dance) return;

    const actions  = document.getElementById('hero-actions');
    const decoLine = document.querySelector<HTMLElement>('.hero-deco-line');
    const vw       = window.innerWidth;
    const isMobile = vw <= 768;

    /* ── État initial ── */
    gsap.set(el, { opacity: 1 });
    /* Blur désactivé sur mobile — peut bloquer l'animation sur certains navigateurs */
    if (isMobile) {
      gsap.set([rozi, dance], { yPercent: 112, opacity: 0 });
      if (actions) gsap.set(actions, { opacity: 0, y: 12 });
    } else {
      gsap.set([rozi, dance], { yPercent: 112, opacity: 0, filter: 'blur(10px)' });
      if (actions) gsap.set(actions, { opacity: 0, y: 16, filter: 'blur(8px)' });
    }
    if (decoLine) gsap.set(decoLine, { scaleX: 0, opacity: 0, transformOrigin: 'center' });

    /* ── Timeline ── */
    const tl = gsap.timeline({ delay: isMobile ? 0.48 : 0.86 });

    if (isMobile) {
      tl
        .to(rozi,     { yPercent: 0, opacity: 1, duration: 0.75, ease: 'power3.out' }, 0)
        .to(dance,    { yPercent: 0, opacity: 1, duration: 0.75, ease: 'power3.out' }, 0.08)
        .to(decoLine, { scaleX: 1, opacity: 1, duration: 0.5,  ease: 'power3.out' }, 0.46)
        .to(actions,  { opacity: 1, y: 0,       duration: 0.55, ease: 'power3.out' }, 0.60);
    } else {
      tl
        .to(rozi,     { yPercent: 0, opacity: 1, filter: 'blur(0px)', duration: 0.92, ease: 'power4.out' }, 0)
        .to(dance,    { yPercent: 0, opacity: 1, filter: 'blur(0px)', duration: 0.92, ease: 'power4.out' }, 0.1)
        .to(decoLine, { scaleX: 1, opacity: 1, duration: 0.68, ease: 'power3.out' }, 0.54)
        .to(actions,  { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.7, ease: 'power3.out' }, 0.72);
    }
  }

  document.addEventListener('astro:page-load', initHeroTitleAnimation);

  /* ── Filet de sécurité : force tout visible si GSAP coince ── */
  function heroFallback() {
    const els = ['hero-italic', 'hero-actions'];
    els.forEach(id => {
      const el = document.getElementById(id);
      if (el) el.style.cssText = 'opacity:1;transform:none;filter:none';
    });
    const decoLine = document.querySelector<HTMLElement>('.hero-deco-line');
    if (decoLine) decoLine.style.cssText = 'opacity:1;transform:scaleX(1)';
  }

  document.addEventListener('astro:page-load', () => {
    setTimeout(heroFallback, 2500);
  });
</script>
