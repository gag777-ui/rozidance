---
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = getTranslations(lang);
const base = lang === 'fr' ? '' : `/${lang}`;

---

<section class="hero-section" aria-labelledby="hero-title">

  <!-- Fond hero : vidéo MP4 auto-hébergée -->
  <div class="hero-video-bg" aria-hidden="true">
    <video
      class="hero-bg-video"
      autoplay
      muted
      loop
      playsinline
      disablepictureinpicture
      preload="metadata"
    >
      <source src="/videos/hero.mp4" type="video/mp4" />
    </video>
    <div class="hero-filter"></div>
  </div>

  <!-- Motif géométrique watermark (desktop) -->
  <div class="hero-pattern" aria-hidden="true">
    <svg viewBox="0 0 500 500" xmlns="http://www.w3.org/2000/svg" class="hero-pattern-svg">
      <g stroke="#ffffff" stroke-width="0.8" fill="none">
        <polygon points="250,80 265,115 305,115 272,138 285,175 250,152 215,175 228,138 195,115 235,115"/>
        <polygon points="250,40 270,80 250,120 230,80"/>
        <polygon points="370,160 410,180 370,200 330,180"/>
        <polygon points="130,160 170,180 130,200 90,180"/>
        <rect x="180" y="60" width="140" height="140" transform="rotate(45 250 130)" stroke-width="0.5"/>
        <rect x="200" y="80" width="100" height="100" transform="rotate(45 250 130)" stroke-width="0.5"/>
        <line x1="200" y1="0" x2="200" y2="500" stroke-width="0.3" stroke-dasharray="4 12"/>
        <line x1="300" y1="0" x2="300" y2="500" stroke-width="0.3" stroke-dasharray="4 12"/>
        <line x1="0" y1="200" x2="500" y2="200" stroke-width="0.3" stroke-dasharray="4 12"/>
        <line x1="0" y1="300" x2="500" y2="300" stroke-width="0.3" stroke-dasharray="4 12"/>
      </g>
    </svg>
  </div>

  <!-- Layout interne -->
  <div class="hero-inner section-container">

    <!-- Texte -->
    <div class="hero-text">
      <h1 class="hero-title" id="hero-title">
        <span class="hero-line">{t.hero.line1}</span>
        <span class="hero-line" id="hero-line2">{t.hero.line2}</span>
        <em class="hero-line hero-italic" id="hero-italic" aria-label={`${t.hero.line3a} · ${t.hero.line3italic}`}>
          <span class="hw-rozi">{t.hero.line3a}</span>
          <span class="hw-dot">·</span>
          <span class="hw-dance">{t.hero.line3italic}</span>
        </em>
      </h1>

      <div class="hero-actions" id="hero-actions">
        <a href="#contact" class="btn-primary">{t.hero.ctaPrimary}</a>
        <a href="#prestations" class="hero-btn-ghost">{t.hero.ctaSecondary}</a>
      </div>

    </div>

  </div>
</section>

<style>
  /* ── BASE (toutes tailles) — vidéo fond activée partout ── */
  .hero-section {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: 5rem 3rem;
    overflow: hidden;
    background-color: var(--color-bg-dark);
  }

  /* Vidéo fond */
  .hero-video-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }

  /* Vidéo fond */
  .hero-bg-video {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    min-width: 100%;
    min-height: 100%;
    width: auto;
    height: auto;
    object-fit: cover;
    z-index: 0;
    pointer-events: none;
  }

  /* Filtre sombre par-dessus la vidéo */
  .hero-filter {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(20,10,5,0.35) 0%, transparent 38%),
      radial-gradient(ellipse 120% 100% at 50% 50%, rgba(20,10,5,0.32) 0%, rgba(20,10,5,0.68) 100%);
    z-index: 1;
    pointer-events: none;
  }

  .hero-pattern { display: none; }

  /* Contenu au-dessus de la vidéo */
  .hero-inner {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: 1fr;
    text-align: center;
    width: 100%;
    gap: 0;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
  }

  /* Widget vidéo mobile supprimé — on utilise la vidéo fond */
  .hero-video-wrap { display: none; }

  /* ── Animations d'entrée du titre ── */
  @keyframes heroWordIn {
    from { opacity: 0; transform: translateY(32px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes heroLineIn {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes heroSignatureIn {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.92);
      filter: blur(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    font-size: clamp(2.25rem, 9vw, 3.75rem);
    line-height: 1.08;
    color: #fff;
    text-shadow: 0 2px 20px rgba(20,10,5,0.5);
    margin: 0;
  }

  .hero-line { display: block; }

  /* "Bienvenu" — apparaît rapidement et reste affiché */
  .hero-line:nth-child(1) {
    animation: heroWordIn 350ms var(--ease-out-soft) 250ms both;
  }

  @media (max-width: 768px) {
    .hero-line:nth-child(1) {
      animation-duration: 200ms;
      animation-delay: 80ms;
    }
  }

  /* "dans le monde de" — géré par le typewriter JS */
  .hero-line:nth-child(2) {
    opacity: 0;
    color: rgba(220, 190, 165, 0.88);
  }

  /* "Rozi · Dance" — géré par le typewriter JS */
  .hero-italic {
    opacity: 0;
  }

  .hero-line:first-child {
    font-size: clamp(1.125rem, 4vw, 1.5rem);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-family: var(--font-sans);
    font-weight: 400;
    color: rgba(255,255,255,0.65);
    margin-bottom: 0.3em;
  }

  .hero-italic {
    color: #CE8698;
    font-style: italic;
    font-size: clamp(3rem, 12vw, 5.5rem);
    line-height: 1.0;
    margin-top: 0.05em;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25em;
    min-height: 1.1em;
  }

  @keyframes cursorBlink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }

  .hero-cursor {
    display: inline-block;
    font-style: normal;
    font-weight: 300;
    color: rgba(255,255,255,0.7);
    animation: cursorBlink 0.6s step-end infinite;
    margin-left: 2px;
  }

  .hero-subtitle {
    font-size: 1rem;
    color: rgba(255,255,255,0.78);
    max-width: 38ch;
    line-height: 1.65;
    margin: 0;
    text-shadow: 0 1px 8px rgba(20,10,5,0.4);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 1.5rem;
    opacity: 0;
  }

  .hero-btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: transparent;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 13px;
    letter-spacing: 0.06em;
    padding: 0.8rem 2rem;
    border-radius: var(--radius-btn);
    border: 0.5px solid rgba(255,255,255,0.6);
    position: relative;
    overflow: hidden;
    cursor: pointer;
    text-decoration: none;
    transition: border-color 400ms var(--ease-out-soft),
                background-color 400ms var(--ease-out-soft),
                transform 300ms var(--ease-out-soft);
  }
  .hero-btn-ghost::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 25%,
      rgba(255, 255, 255, 0.18) 50%,
      transparent 75%
    );
    transform: translateX(-100%);
    transition: transform 550ms var(--ease-out-soft);
  }
  .hero-btn-ghost:hover {
    border-color: #fff;
    background-color: rgba(255,255,255,0.1);
    transform: translateY(-2px);
  }
  .hero-btn-ghost:hover::before {
    transform: translateX(150%);
  }

  /* ── DESKTOP ── */
  @media (min-width: 901px) {
    .hero-section {
      min-height: 100vh;
      padding-block: 0;
    }

    .hero-pattern {
      display: block;
      position: absolute;
      top: 50%;
      right: -60px;
      transform: translateY(-50%);
      width: 520px;
      height: 520px;
      pointer-events: none;
      opacity: 0.07;
      z-index: 2;
    }
    .hero-pattern-svg { width: 100%; height: 100%; }

    .hero-inner {
      padding-block: 6rem;
    }

    .hero-title {
      font-size: clamp(3rem, 6vw, 5rem);
      line-height: 1.05;
      text-shadow: 0 2px 24px rgba(20,10,5,0.45);
    }

    .hero-line:first-child {
      font-size: clamp(0.875rem, 1.2vw, 1.125rem);
      margin-bottom: 0.4em;
    }

    .hero-italic {
      font-size: clamp(4rem, 9vw, 8rem);
    }

    .hero-subtitle {
      font-size: clamp(1rem, 1.5vw, 1.125rem);
      max-width: 44ch;
    }
  }
</style>

<script>
  import gsap from 'gsap';

  // Force video playback on mobile and after View Transitions.
  // iOS Safari ignores the autoplay attribute on dynamically inserted elements
  // (View Transitions swap) — must call play() explicitly.
  function initHeroVideo() {
    const video = document.querySelector<HTMLVideoElement>('.hero-bg-video');
    if (!video) return;

    // Set programmatically as well as via attributes — required on some iOS versions
    video.muted = true;
    (video as HTMLVideoElement & { playsInline: boolean }).playsInline = true;

    const tryPlay = () => {
      if (!video.paused) return; // already playing
      video.play().catch(() => {
        // play() still not ready — retry on data events and first gesture
        video.addEventListener('canplay', tryPlay, { once: true });
        video.addEventListener('loadeddata', tryPlay, { once: true });
        document.addEventListener('touchstart', tryPlay, { once: true });
      });
    };

    tryPlay();
  }

  document.addEventListener('astro:page-load', initHeroVideo);

  // ── Typewriter "dans le monde de" ──────────────────────────────
  function initHeroTypewriter() {
    const el = document.getElementById('hero-line2') as HTMLElement | null;
    if (!el) return;

    const text = el.textContent?.trim() ?? '';
    el.textContent = '';
    el.style.opacity = '1';

    let i = 0;
    function typeNext() {
      if (i >= text.length) return;
      el.textContent += text[i];
      i++;
      const jitter = (Math.random() - 0.5) * 25;
      setTimeout(typeNext, 65 + jitter);
    }

    const isMobile = window.matchMedia('(max-width: 768px)').matches;
    setTimeout(typeNext, isMobile ? 280 : 900);
  }

  document.addEventListener('astro:page-load', initHeroTypewriter);

  function initHeroTitleAnimation() {
    const el = document.getElementById('hero-italic') as HTMLElement | null;
    if (!el) return;

    const rozi  = el.querySelector<HTMLElement>('.hw-rozi');
    const dot   = el.querySelector<HTMLElement>('.hw-dot');
    const dance = el.querySelector<HTMLElement>('.hw-dance');
    if (!rozi || !dot || !dance) return;

    const vw = window.innerWidth;

    const actions = document.getElementById('hero-actions');

    // Position initiale : mots hors-écran, point et boutons invisibles
    gsap.set(el,    { opacity: 1 });
    gsap.set(rozi,  { x: -vw * 1.15 });
    gsap.set(dance, { x:  vw * 1.15 });
    gsap.set(dot,   { opacity: 0, scale: 0 });
    if (actions) gsap.set(actions, { opacity: 0, y: 18 });

    // Animation : mots → point → boutons
    const isMobile = window.innerWidth <= 768;
    const tl = gsap.timeline({ delay: isMobile ? 1.1 : 2.0 });
    tl.to(rozi,    { x: 0, duration: 0.9, ease: 'power3.out' }, 0)
      .to(dance,   { x: 0, duration: 0.9, ease: 'power3.out' }, 0)
      .to(dot,     { opacity: 1, scale: 1, duration: 0.35, ease: 'back.out(2.5)' }, 0.68)
      .to(actions, { opacity: 1, y: 0, duration: 0.65, ease: 'power2.out' }, 1.05);
  }

  document.addEventListener('astro:page-load', initHeroTitleAnimation);
</script>

